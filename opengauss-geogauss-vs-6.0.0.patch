index 0000000..e0fbf33
--- /dev/null
+++ b/src/occ/o_scan.cpp
@@ -0,0 +1,96 @@
+//
+// Created by hcj2003 on 9/16/25.
+//
+
+#include "occ/o_txn.h"
+#include "occ/occ_internal.h"
+#include "occ/o_executor.h"
+#include "occ/o_staging.h"
+
+Tuple O_index_getnext(IndexScanDesc scan, ScanDirection direction, bool* has_cur_xact_write)
+{
+    if (!OccStagingOverlayEnabled() && !O_TxnHasActiveWriteSet()) {
+        return index_getnext(scan, direction, has_cur_xact_write);
+    }
+
+    Tuple tuple;
+    ItemPointer tid;
+
+    HeapTuple currRow;
+
+    for (;;) {
+        if (likely(!scan->xs_continue_hot)) {
+            tid = index_getnext_tid(scan, direction);
+            if (tid == NULL) {
+                break;
+            }
+            if (IndexScanNeedSwitchPartRel(scan)) {
+                if (!GPIGetNextPartRelation(scan->xs_gpi_scan, CurrentMemoryContext, AccessShareLock)) {
+                    continue;
+                }
+                scan->heapRelation = scan->xs_gpi_scan->fakePartRelation;
+            }
+        } else {
+            /*
+             * We are resuming scan of a HOT chain after having returned an
+             * earlier member.	Must still hold pin on current heap page.
+             */
+            Assert(BufferIsValid(scan->xs_cbuf));
+            Assert(ItemPointerGetBlockNumber(&scan->xs_ctup.t_self) == BufferGetBlockNumber(scan->xs_cbuf));
+        }
+
+        /* 无写集时仍须 IndexFetchTuple 拉取 heap 行，不能直接返回 xs_ctup */
+        if (!O_TxnHasActiveWriteSet()) {
+            tuple = IndexFetchTuple(scan, has_cur_xact_write);
+            if (tuple != NULL) {
+                return tuple;
+            }
+            continue;
+        }
+
+        O_TxnManager* txn = GetTxnManager();
+
+        RC rc = RC_OK;
+
+        occ_sentinel sentinel(scan->heapRelation, scan->xs_ctup.t_self, scan->xs_snapshot);
+        currRow = txn->RowLookup(AccessType::RD, sentinel, rc, scan);
+
+        if (currRow != NULL)
+            return (Tuple)currRow;
+
+    }
+    return NULL;
+}
+
+HeapTuple O_seq_scan(HeapScanDesc scan)
+{
+    O_TxnManager* txn = GetTxnManager();
+    if (txn == nullptr) {
+        return &(scan->rs_ctup);
+    }
+
+    RC rc = RC_OK;
+
+    occ_sentinel sentinel(scan->rs_base.rs_rd, scan->rs_ctup.t_self, scan->rs_base.rs_snapshot);
+
+    HeapTuple currRow = txn->RowLookup(AccessType::RD, sentinel, rc, nullptr, &(scan->rs_ctup));
+
+    /* OCC 未命中时回退 heap 版本，避免 COUNT(*) 等全表扫描漏行 */
+    if (currRow != nullptr) {
+        return currRow;
+    }
+    return &(scan->rs_ctup);
+}
+
+bool O_check_unique(Relation relation, ItemPointerData tid)
+{
+    O_TxnManager* txn = GetTxnManager();
+
+    RC rc = RC_OK;
+
+    occ_sentinel sentinel(relation, tid);
+
+    bool res = txn->CheckUnique(AccessType::RD, sentinel, rc);
+
+    return res;
+}
diff --git a/src/occ/o_sentinel.cpp b/src/occ/o_sentinel.cpp
new file mode 100644
index 0000000..c633173
--- /dev/null
+++ b/src/occ/o_sentinel.cpp
@@ -0,0 +1,182 @@
+//
+// Created by hcj2003 on 10/13/25.
+//
+
+#include "occ/o_txn.h"
+#include "occ/occ_mem.h"
+#include "occ/o_delta_table.h"
+#include "occ/o_staging.h"
+#include "occ/occ_internal.h"
+
+// 应该不需要在进行hot扫描
+bool O_heap_hot_search_buffer(ItemPointer tid, Relation relation, Buffer buffer, HeapTuple heap_tuple, Snapshot snapshot)
+{
+    TransactionId prev_xmax = InvalidTransactionId;
+    Page dp = (Page)BufferGetPage(buffer);
+    BlockNumber blkno;
+    OffsetNumber offnum;
+
+    blkno = ItemPointerGetBlockNumber(tid);
+    offnum = ItemPointerGetOffsetNumber(tid);
+
+    bool at_chain_start = true;
+    bool valid;
+
+    for (;;)
+    {
+        ItemId lp;
+        lp = PageGetItemId(dp, offnum);
+
+        if (!ItemIdIsNormal(lp))
+        {
+            if (ItemIdIsRedirected(lp) && at_chain_start)
+            {
+                offnum = ItemIdGetRedirect(lp);
+                at_chain_start = false;
+                continue;
+            }
+            return false;
+        }
+
+        heap_tuple->t_len = ItemIdGetLength(lp);
+        heap_tuple->t_bucketId = RelationGetBktid(relation);
+        ItemPointerSet(&heap_tuple->t_self, blkno, offnum);
+        heap_tuple->t_tableOid = RelationGetRelid(relation);
+
+        heap_tuple->t_data = (HeapTupleHeader)PageGetItem(dp, lp);
+
+        if (TransactionIdIsValid(prev_xmax) && !TransactionIdEquals(prev_xmax, HeapTupleGetRawXmin(heap_tuple)))
+        {
+            return false;
+        }
+
+        return true;
+
+        if (snapshot == nullptr)
+        {
+            return true;
+        }
+
+        if (snapshot->satisfies == SNAPSHOT_MVCC)
+        {
+            valid = HeapTupleSatisfiesMVCC(heap_tuple, snapshot, buffer, NULL);
+        }
+        else
+        {
+            valid = HeapTupleSatisfiesVisibility(heap_tuple, snapshot, buffer, NULL);
+        }
+
+        if (valid)
+        {
+            ItemPointerSetOffsetNumber(tid, offnum);
+            return true;
+        }
+
+        if (HeapTupleIsHotUpdated(heap_tuple))
+        {
+            offnum = ItemPointerGetOffsetNumber(&heap_tuple->t_data->t_ctid);
+            at_chain_start = false;
+            prev_xmax = HeapTupleGetUpdateXid(heap_tuple);
+        }
+        else
+        {
+            return false;
+        }
+    }
+    return false;
+}
+
+HeapTuple occ_sentinel::GetData(HeapTuple heap_tuple, Buffer buffer)
+{
+    ItemPointer tid = &tuple_id;
+
+    if (OccStagingOverlayEnabled())
+    {
+        HeapTuple copy = nullptr;
+        bool deleted = false;
+        if (OccStagingTryReadTuple(relation, tid, &copy, &deleted))
+        {
+            if (deleted || copy == nullptr) {
+                if (copy != nullptr) {
+                    heap_freetuple(copy);
+                }
+                return nullptr;
+            }
+            return copy;
+        }
+    }
+
+    if (g_enable_occ_delta && !g_enable_occ_staging)
+    {
+        O_DeltaEntry deltaEntry;
+        if (O_DeltaTable::Instance().Lookup(relation, tid, deltaEntry))
+        {
+            if (deltaEntry.deleted || deltaEntry.tuple == nullptr)
+            {
+                return nullptr;
+            }
+            HeapTuple src = deltaEntry.tuple;
+            heap_tuple->t_len = src->t_len;
+            heap_tuple->t_bucketId = src->t_bucketId;
+            heap_tuple->t_self = src->t_self;
+            heap_tuple->t_tableOid = src->t_tableOid;
+            heap_tuple->t_data = src->t_data;
+            return heap_tuple;
+        }
+    }
+
+    O_heap_hot_search_buffer(tid, relation, buffer, heap_tuple, snapshot);
+
+    return heap_tuple;
+}
+
+HeapTuple occ_sentinel::GetData(HeapTuple heap_tuple)
+{
+    ItemPointer tid = &tuple_id;
+
+    if (OccStagingOverlayEnabled())
+    {
+        HeapTuple copy = nullptr;
+        bool deleted = false;
+        if (OccStagingTryReadTuple(relation, tid, &copy, &deleted))
+        {
+            if (deleted || copy == nullptr) {
+                if (copy != nullptr) {
+                    heap_freetuple(copy);
+                }
+                return nullptr;
+            }
+            return copy;
+        }
+    }
+
+    if (g_enable_occ_delta && !g_enable_occ_staging)
+    {
+        O_DeltaEntry deltaEntry;
+        if (O_DeltaTable::Instance().Lookup(relation, tid, deltaEntry))
+        {
+            if (deltaEntry.deleted || deltaEntry.tuple == nullptr)
+            {
+                return nullptr;
+            }
+            HeapTuple src = deltaEntry.tuple;
+            heap_tuple->t_len = src->t_len;
+            heap_tuple->t_bucketId = src->t_bucketId;
+            heap_tuple->t_self = src->t_self;
+            heap_tuple->t_tableOid = src->t_tableOid;
+            heap_tuple->t_data = src->t_data;
+            return heap_tuple;
+        }
+    }
+
+    Buffer buffer = ReadBuffer(relation, ItemPointerGetBlockNumber(tid));
+
+    LockBuffer(buffer, BUFFER_LOCK_SHARE);
+    O_heap_hot_search_buffer(tid, relation, buffer, heap_tuple, snapshot);
+
+    LockBuffer(buffer, BUFFER_LOCK_UNLOCK);
+
+    ReleaseBuffer(buffer);
+
+    return heap_tuple;
+}
