+#!/usr/bin/env bash
+# 三节点 epoch 集群：deploy / configure / restart
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+# shellcheck source=env.sh
+source "${SCRIPT_DIR}/env.sh"
+
+export EPOCH_BENCH_ROOT="${EPOCH_BENCH_ROOT:-/home/hcj2003/2025-9}"
+export EPOCH_PROFILE="${EPOCH_PROFILE:-async-stats}"
+
+# prep-only | deploy-only
+RUN_MODE=prep-only
+
+usage() {
+    cat <<EOF
+usage: $(basename "$0") [OPTION]
+
+  (default)     deploy node1/2 → configure → restart → 健康检查
+  --prep-only   同上
+  --deploy-only 仅 rsync 二进制到 node1/2
+
+env: EPOCH_BENCH_ROOT, EPOCH_PROFILE (default async-stats)
+  profile 内置 gap / physical，一般只需 export EPOCH_PROFILE：
+    benchmark   sync  gap=5  physical=100ms
+    stats       sync  gap=5  physical=100ms +diag
+    async       async gap=16 physical=5ms
+    async-wan   async gap=48 physical=3ms
+    async-stats async gap=20 physical=10ms +diag（默认）
+  可选覆盖: EPOCH_PHYS_LOGICAL_GAP_LIMIT, EPOCH_PHYSICAL_INTERVAL_MS
+EOF
+}
+
+epoch_remote_shell() {
+    local n="$1"
+    shift
+    local rb env_prefix
+    rb="$(epoch_bench_root_for_node "${n}")"
+    env_prefix="$(epoch_remote_gauss_env "${n}")"
+    if epoch_is_local_node "${n}"; then
+        eval "${env_prefix}"
+        bash -c "$*"
+    else
+        ssh -o BatchMode=yes -o ConnectTimeout=10 "$(epoch_ssh_target "${n}")" \
+            "${env_prefix}; $*"
+    fi
+}
+
+epoch_check_nodes_running() {
+    local n rb detail
+    echo "=== postflight: gaussdb + gsql ==="
+    for n in 0 1 2; do
+        rb="$(epoch_bench_root_for_node "${n}")"
+        if ! epoch_remote_shell "${n}" \
+            "gs_ctl status -D ${rb}/data/epoch-node${n} >/dev/null 2>&1"; then
+            detail="$(epoch_remote_shell "${n}" \
+                "gs_ctl status -D ${rb}/data/epoch-node${n} 2>&1 | tail -2" 2>/dev/null || true)"
+            echo "ERROR: epoch-node${n} failed gs_ctl status (datadir ${rb}/data/epoch-node${n})" >&2
+            [ -n "${detail}" ] && echo "  ${detail}" >&2
+            exit 1
+        fi
+        if ! epoch_remote_shell "${n}" \
+            "timeout 8 gsql -d test -p 32000 -tAc 'SELECT 1' >/dev/null 2>&1"; then
+            echo "ERROR: epoch-node${n} not accepting SQL within 8s (process may be hung)" >&2
+            exit 1
+        fi
+        echo "node${n}: running, gsql ok"
+    done
+}
+
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --prep-only)
+            RUN_MODE=prep-only
+            shift
+            ;;
+        --deploy-only)
+            RUN_MODE=deploy-only
+            shift
+            ;;
+        -h|--help)
+            usage
+            exit 0
+            ;;
+        *)
+            echo "unknown option: $1 (try --help)" >&2
+            exit 2
+            ;;
+    esac
+done
+
+epoch_invoke_deploy() {
+    env -u LD_LIBRARY_PATH \
+        EPOCH_BENCH_ROOT="${EPOCH_BENCH_ROOT}" \
+        EPOCH_PROFILE="${EPOCH_PROFILE:-}" \
+        EPOCH_PHYS_LOGICAL_GAP_LIMIT="${EPOCH_PHYS_LOGICAL_GAP_LIMIT:-}" \
+        EPOCH_PHYSICAL_INTERVAL_MS="${EPOCH_PHYSICAL_INTERVAL_MS:-}" \
+        PATH="/usr/bin:/bin:/usr/local/bin" \
+        bash "${SCRIPT_DIR}/deploy_to_remote.sh" "$@"
+}
+
+epoch_cluster_deploy() {
+    echo "=== [1/3] deploy binary to node1/node2 ==="
+    for n in 1 2; do
+        epoch_invoke_deploy "${n}"
+    done
+}
+
+epoch_cluster_configure() {
+    echo "=== [2/3] configure all nodes (profile=${EPOCH_PROFILE}) ==="
+    for n in 0 1 2; do
+        bash "${SCRIPT_DIR}/configure_node.sh" "${n}"
+    done
+}
+
+epoch_cluster_restart() {
+    echo "=== [3/3] stop all nodes ==="
+    for n in 0 1 2; do
+        bash "${SCRIPT_DIR}/stop_node.sh" "${n}" || true
+    done
+    sleep 3
+    echo "=== start all nodes ==="
+    for n in 0 1 2; do
+        bash "${SCRIPT_DIR}/start_node.sh" "${n}"
+    done
+    sleep 5
+}
+
+epoch_snapshot_epoch_guc() {
+    local result_dir="$1"
+    for n in 0 1 2; do
+        local dest="${result_dir}/postgresql.epoch.node${n}.conf"
+        if epoch_is_local_node "${n}"; then
+            grep -E '^epoch_|^enable_epoch|^occ_enable_stats' \
+                "$(data_dir_for_node "${n}")/postgresql.conf" > "${dest}" 2>/dev/null || true
+        else
+            local rb
+            rb="$(epoch_bench_root_for_node "${n}")"
+            ssh -o BatchMode=yes "$(epoch_ssh_target "${n}")" \
+                "grep -E '^epoch_|^enable_epoch|^occ_enable_stats' ${rb}/data/epoch-node${n}/postgresql.conf" \
+                > "${dest}" 2>/dev/null || true
+        fi
+    done
+}
+
+case "${RUN_MODE}" in
+    deploy-only)
+        epoch_cluster_deploy
+        echo "DONE: deploy-only (node1/node2 synced)"
+        ;;
+    prep-only|*)
+        PREP_RESULT="${EPOCH_BENCH_ROOT}/epoch_benchmark_results/prep_${EPOCH_PROFILE}_$(date +%Y%m%d_%H%M%S)"
+        mkdir -p "${PREP_RESULT}"
+        {
+            echo "run_mode=prep-only"
+            echo "profile=${EPOCH_PROFILE}"
+            echo "EPOCH_BENCH_ROOT=${EPOCH_BENCH_ROOT}"
+            echo "EPOCH_PHYS_LOGICAL_GAP_LIMIT=${EPOCH_PHYS_LOGICAL_GAP_LIMIT:-}"
+            echo "EPOCH_PHYSICAL_INTERVAL_MS=${EPOCH_PHYSICAL_INTERVAL_MS:-}"
+            echo "started_at=$(date -Iseconds)"
+        } | tee "${PREP_RESULT}/summary.txt"
+        epoch_cluster_deploy
+        epoch_cluster_configure
+        epoch_cluster_restart
+        epoch_check_nodes_running | tee -a "${PREP_RESULT}/summary.txt"
+        echo "finished_at=$(date -Iseconds)" | tee -a "${PREP_RESULT}/summary.txt"
+        epoch_snapshot_epoch_guc "${PREP_RESULT}"
+        echo "result_dir=${PREP_RESULT}" | tee -a "${PREP_RESULT}/summary.txt"
+        echo "DONE: ${PREP_RESULT}"
+        ;;
+esac
diff --git a/scripts/epoch_benchmark/run_tpcc_node.sh b/scripts/epoch_benchmark/run_tpcc_node.sh
new file mode 100644
index 0000000..bcaf640
--- /dev/null
+++ b/scripts/epoch_benchmark/run_tpcc_node.sh
@@ -0,0 +1,78 @@
+#!/usr/bin/env bash
+# 单节点 TPCC 准备：建库/用户 → 灌库 → hist_id 分片（不含压测）
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+# shellcheck source=env.sh
+source "${SCRIPT_DIR}/env.sh"
+
+NODE_ID="${1:-}"
+ACTION="${2:-all}"
+if [ -z "${NODE_ID}" ]; then
+    echo "usage: $(basename "$0") NODE_ID [all|setup|load|shard]" >&2
+    exit 2
+fi
+validate_node_id "${NODE_ID}"
+
+BENCH_RUN="${EPOCH_BENCHMARKSQL}"
+PROPS_LOAD="${BENCH_RUN}/props.epoch.load"
+PROPS_RUN="${BENCH_RUN}/props.epoch.node${NODE_ID}"
+JDK="${EPOCH_BENCH_ROOT}/epoch_deploy/jdk8"
+
+if [ ! -x "${JDK}/bin/java" ]; then
+    echo "ERROR: missing ${JDK}/bin/java" >&2
+    echo "hint: rsync JRE from node0 to epoch_deploy/jdk8, or install openjdk-8" >&2
+    exit 1
+fi
+export JAVA_HOME="${JDK}"
+export PATH="${JAVA_HOME}/bin:${PATH}"
+
+if [ ! -f "${PROPS_RUN}" ]; then
+    echo "ERROR: missing ${PROPS_RUN}" >&2
+    exit 1
+fi
+
+setup_tpcc_db() {
+    echo "=== setup test database and bot user on node${NODE_ID} ==="
+    if ! epoch_super_gsql -tAc "SELECT 1 FROM pg_roles WHERE rolname='bot'" | grep -q 1; then
+        epoch_super_gsql -c "CREATE USER bot WITH PASSWORD '${EPOCH_TPCC_PASSWORD}';"
+    fi
+    if ! epoch_super_gsql -tAc "SELECT 1 FROM pg_database WHERE datname='${EPOCH_TPCC_DB}'" | grep -q 1; then
+        epoch_super_gsql -c "CREATE DATABASE ${EPOCH_TPCC_DB} OWNER bot;"
+    fi
+    epoch_super_gsql -d "${EPOCH_TPCC_DB}" -c "GRANT ALL PRIVILEGES TO bot;"
+    echo "database ${EPOCH_TPCC_DB} ready"
+}
+
+load_tpcc() {
+    echo "=== TPCC load (100 warehouses) on node${NODE_ID} ==="
+    cd "${BENCH_RUN}"
+    if [ ! -f "${PROPS_LOAD}" ]; then
+        cp props.epoch.node0 "${PROPS_LOAD}"
+        sed -i 's/runWarehouses=33/runWarehouses=100/' "${PROPS_LOAD}"
+        sed -i 's/loadWorkers=100/loadWorkers=50/' "${PROPS_LOAD}" 2>/dev/null || true
+    fi
+    ./runDatabaseBuild.sh props.epoch.load
+}
+
+shard_tpcc() {
+    echo "=== shard bmsql_hist_id_seq on node${NODE_ID} ==="
+    bash "${SCRIPT_DIR}/shard_hist_id_seq.sh" "${NODE_ID}"
+}
+
+case "${ACTION}" in
+    all)
+        setup_tpcc_db
+        load_tpcc
+        shard_tpcc
+        ;;
+    setup) setup_tpcc_db ;;
+    load) load_tpcc ;;
+    shard) shard_tpcc ;;
+    *)
+        echo "unknown action: ${ACTION}" >&2
+        exit 2
+        ;;
+esac
+
+echo "done: node${NODE_ID} action=${ACTION}"
diff --git a/scripts/epoch_benchmark/shard_hist_id_seq.sh b/scripts/epoch_benchmark/shard_hist_id_seq.sh
new file mode 100644
index 0000000..38ee77e
--- /dev/null
+++ b/scripts/epoch_benchmark/shard_hist_id_seq.sh
@@ -0,0 +1,38 @@
+#!/usr/bin/env bash
+# runDatabaseBuild 之后执行：按 node_id 分片 bmsql_hist_id_seq，避免多主 apply 后 hist_id 撞号。
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+# shellcheck source=env.sh
+source "${SCRIPT_DIR}/env.sh"
+
+NODE_ID="${1:-}"
+if [ -z "${NODE_ID}" ]; then
+    echo "usage: $(basename "$0") NODE_ID" >&2
+    exit 2
+fi
+validate_node_id "${NODE_ID}"
+
+STRIDE="${EPOCH_HIST_ID_NODE_STRIDE}"
+HIST_BASE=$((NODE_ID * STRIDE))
+TOTAL_NODES="${EPOCH_TOTAL_NODES}"
+# 最后一号节点本地发号上界约 TOTAL_NODES * STRIDE，须 < int4 max
+if [ $((TOTAL_NODES * STRIDE)) -gt 2147483647 ]; then
+    echo "ERROR: hist_id shard out of int4 range (nodes=${TOTAL_NODES} stride=${STRIDE})" >&2
+    echo "hint: EPOCH_HIST_ID_NODE_STRIDE <= $((2147483647 / TOTAL_NODES))" >&2
+    exit 1
+fi
+
+echo "node ${NODE_ID}: shard bmsql_hist_id_seq base=${HIST_BASE} stride=${STRIDE} ..."
+epoch_tpcc_gsql -c "
+SELECT setval(
+    'bmsql_hist_id_seq',
+    GREATEST(
+        ${HIST_BASE}::integer,
+        COALESCE((SELECT max(hist_id) FROM bmsql_history), 0)::integer
+    ),
+    true
+);
+"
+
+echo "node ${NODE_ID}: next Payment hist_id will be > GREATEST(${HIST_BASE}, max(hist_id))"
diff --git a/scripts/epoch_benchmark/start_node.sh b/scripts/epoch_benchmark/start_node.sh
new file mode 100644
index 0000000..63b8aad
--- /dev/null
+++ b/scripts/epoch_benchmark/start_node.sh
@@ -0,0 +1,90 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+# shellcheck source=env.sh
+source "${SCRIPT_DIR}/env.sh"
+
+NODE_ID="${1:-}"
+if [ -z "${NODE_ID}" ]; then
+    echo "usage: $(basename "$0") NODE_ID" >&2
+    exit 2
+fi
+
+validate_node_id "${NODE_ID}"
+
+# 在非目标节点机器上启动远程节点时，SSH 转发到对应主机执行
+if ! epoch_is_local_node "${NODE_ID}"; then
+    REMOTE="$(epoch_ssh_target "${NODE_ID}")"
+    RB="$(epoch_bench_root_for_node "${NODE_ID}")"
+    ssh -o BatchMode=yes -o ConnectTimeout=10 "${REMOTE}" \
+        "export EPOCH_LOCAL_NODE_ID=${NODE_ID}; export EPOCH_BENCH_ROOT=${RB}; bash ${RB}/openGauss-server/scripts/epoch_benchmark/start_node.sh ${NODE_ID}"
+    exit $?
+fi
+
+DATA_DIR="$(data_dir_for_node "${NODE_ID}")"
+LOG_FILE="${DATA_DIR}/pg_log/epoch-node${NODE_ID}.log"
+PID_FILE="${DATA_DIR}/postmaster.pid"
+GAUSS_PATTERN="gaussdb.*${DATA_DIR}"
+
+mkdir -p "${DATA_DIR}/pg_log"
+export GAUSSLOG="${DATA_DIR}/pg_log"
+
+cleanup_stale_shmem() {
+    local port="${EPOCH_DB_PORT}"
+    local key=$((port * 1000 + 1))
+    local shmid
+    shmid="$(ipcs -m 2>/dev/null | awk -v key="$(printf '0x%x' "${key}")" '$1 == key {print $2; exit}')"
+    if [ -n "${shmid}" ]; then
+        local nattch
+        nattch="$(ipcs -m -i "${shmid}" 2>/dev/null | awk '/nattch/{print $4}')"
+        if [ "${nattch:-1}" = "0" ]; then
+            echo "removing orphan shared memory segment shmid=${shmid} (port ${port})"
+            ipcrm -m "${shmid}" 2>/dev/null || true
+        fi
+    fi
+}
+cleanup_stale_shmem
+
+is_running() {
+    pgrep -f "${GAUSS_PATTERN}" >/dev/null 2>&1
+}
+
+if [ -f "${PID_FILE}" ]; then
+    pid="$(head -1 "${PID_FILE}" 2>/dev/null || true)"
+    if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
+        echo "node ${NODE_ID} already running (pid ${pid})"
+        exit 0
+    fi
+fi
+
+# pid 文件缺失但进程仍在（常见于 gs_ctl stop 失败），先强制清理
+if is_running; then
+    echo "stale gaussdb detected for node ${NODE_ID}, stopping before start ..."
+    bash "${SCRIPT_DIR}/stop_node.sh" "${NODE_ID}" || {
+        pkill -9 -f "${GAUSS_PATTERN}" 2>/dev/null || true
+        rm -f "${PID_FILE}"
+        sleep 2
+    }
+fi
+
+if is_running; then
+    echo "ERROR: cannot start node ${NODE_ID}, gaussdb still running" >&2
+    exit 1
+fi
+
+epoch_check_gaussdb
+
+echo "starting node ${NODE_ID} at ${DATA_DIR} ..."
+if ! gs_ctl start -D "${DATA_DIR}" -l "${LOG_FILE}" -Z single_node; then
+    echo "gs_ctl start failed, check ${LOG_FILE}" >&2
+    tail -20 "${LOG_FILE}" 2>/dev/null || true
+    exit 1
+fi
+sleep 2
+if ! gs_ctl status -D "${DATA_DIR}"; then
+    echo "ERROR: node ${NODE_ID} failed to become ready" >&2
+    tail -30 "${LOG_FILE}" 2>/dev/null || true
+    exit 1
+fi
+echo "node ${NODE_ID} started"
