+//
+// Prepare outgoing AppendEntries for fast vs slow targets (proxy path).
+//
+
+#ifndef DYNAMIC_NET_DN_APPEND_BUILDER_H
+#define DYNAMIC_NET_DN_APPEND_BUILDER_H
+
+#include "dn_config.h"
+#include "dn_proxy_merge.h"
+#include "dn_types.h"
+
+#include <vector>
+
+struct DnAppendPlan {
+    int32_t target_node_id;
+    DnAppendEntriesRequest request;
+    bool is_metadata_only;
+
+    DnAppendPlan() : target_node_id(-1), is_metadata_only(false) {}
+};
+
+class DnAppendBuilder {
+public:
+    /*
+     * Given a local RaftEntry and channel context, build per-target AppendEntries.
+     * Slow nodes receive metadata-only when proxy is enabled; fast nodes receive full payload.
+     */
+    static std::vector<DnAppendPlan> BuildBroadcastPlans(const DnNetworkConfig &cfg, int32_t channel_id,
+                                                         int32_t channel_leader_id, int32_t term,
+                                                         int32_t leader_commit, const DnRaftEntry &entry);
+
+    static DnAppendPlan BuildSinglePlan(const DnNetworkConfig &cfg, int32_t target_node_id, int32_t channel_id,
+                                        int32_t channel_leader_id, int32_t term, int32_t leader_commit,
+                                        const DnRaftEntry &entry);
+};
+
+#endif /* DYNAMIC_NET_DN_APPEND_BUILDER_H */
diff --git a/src/dynamic-net/dn_config.h b/src/dynamic-net/dn_config.h
new file mode 100644
index 0000000..83108b8
--- /dev/null
+++ b/src/dynamic-net/dn_config.h
@@ -0,0 +1,82 @@
+//
+// Configuration for heterogeneous network replication (dynamic-net).
+//
+
+#ifndef DYNAMIC_NET_DN_CONFIG_H
+#define DYNAMIC_NET_DN_CONFIG_H
+
+#include <cstdint>
+#include <vector>
+
+enum class DnEpochAdvancement {
+    FIXED,    /* Timer 周期严格 +1，不感知网络 */
+    CATCHUP   /* 观测网络 Epoch + Jump + predictive rewrite */
+};
+
+enum class DnBandwidthLimitMode {
+    UNLIMIT,
+    UP_LIMIT,    /* 慢节点上行受限 */
+    DOWN_LIMIT,  /* 慢节点下行受限 */
+    BI_LIMIT     /* 慢节点上下行同时受限 */
+};
+
+struct DnNetworkConfig {
+    int node_count;
+    int local_node_id;
+    DnEpochAdvancement advancement;
+    bool enable_proxy;
+
+    int epoch_duration_ms;
+    int lag_tolerance;          /* CATCHUP: projected_max - local > threshold → Jump */
+    int queue_size_tolerance; /* CATCHUP: tx queue > threshold → Jump */
+    int catchup_factor_k;       /* Jump target = projected_max + k */
+
+    int rtt_estimate_ms;
+    int peer_timeout_ms;
+
+    long long max_tx_queue_ahead_ms;
+    long long max_ctrl_queue_ahead_ms;
+    long long max_rx_queue_ahead_ms;
+
+    DnBandwidthLimitMode bandwidth_mode;
+    std::vector<int> slow_node_ids;
+    double upload_bandwidth_bps;   /* 0 = unlimited */
+    double download_bandwidth_bps; /* 0 = unlimited */
+
+    DnNetworkConfig()
+        : node_count(3),
+          local_node_id(0),
+          advancement(DnEpochAdvancement::FIXED),
+          enable_proxy(false),
+          epoch_duration_ms(10),
+          lag_tolerance(5),
+          queue_size_tolerance(20),
+          catchup_factor_k(3),
+          rtt_estimate_ms(200),
+          peer_timeout_ms(600),
+          max_tx_queue_ahead_ms(800),
+          max_ctrl_queue_ahead_ms(3000),
+          max_rx_queue_ahead_ms(800),
+          bandwidth_mode(DnBandwidthLimitMode::UNLIMIT),
+          upload_bandwidth_bps(0),
+          download_bandwidth_bps(0)
+    {
+    }
+};
+
+inline bool DnIsConfiguredSlow(const DnNetworkConfig &cfg, int node_id)
+{
+    for (int id : cfg.slow_node_ids) {
+        if (id == node_id) {
+            return true;
+        }
+    }
+    return false;
+}
+
+inline bool DnIsFastNode(const DnNetworkConfig &cfg, int node_id)
+{
+    return !DnIsConfiguredSlow(cfg, node_id);
+}
+
+#endif /* DYNAMIC_NET_DN_CONFIG_H */
diff --git a/src/dynamic-net/dn_crdt_merge.cpp b/src/dynamic-net/dn_crdt_merge.cpp
new file mode 100644
index 0000000..ee60f62
--- /dev/null
+++ b/src/dynamic-net/dn_crdt_merge.cpp
@@ -0,0 +1,92 @@
+#include "dn_crdt_merge.h"
+#include "dn_hash.h"
+
+#include <algorithm>
+
+uint64_t DnCrdtMerger::MakeTieBreak(int32_t epoch, uint32_t origin_node, uint64_t client_txn_id)
+{
+    return (static_cast<uint64_t>(epoch) << 32) ^ (static_cast<uint64_t>(origin_node) << 16) ^ client_txn_id;
+}
+
+bool DnCrdtMerger::TxnWins(uint64_t tie_a, uint64_t tie_b)
+{
+    return tie_a > tie_b;
+}
+
+std::vector<bool> DnCrdtMerger::ResolveEpoch(int32_t epoch,
+                                             const std::vector<DnTransaction> &all_candidate_txns) const
+{
+    std::vector<bool> mask(all_candidate_txns.size(), true);
+    std::unordered_map<std::string, RowWinner> row_winners;
+
+    for (size_t i = 0; i < all_candidate_txns.size(); ++i) {
+        const DnTransaction &txn = all_candidate_txns[i];
+        uint64_t tie = MakeTieBreak(epoch, txn.origin_node_id, txn.client_txn_id);
+        bool txn_survives = false;
+
+        for (const auto &row : txn.rows) {
+            auto it = row_winners.find(row.key);
+            if (it == row_winners.end()) {
+                row_winners[row.key] = RowWinner{tie, i};
+                txn_survives = true;
+            } else if (TxnWins(tie, it->second.tie_break)) {
+                mask[it->second.txn_index] = false;
+                it->second = RowWinner{tie, i};
+                txn_survives = true;
+            } else {
+                txn_survives = false;
+                break;
+            }
+        }
+
+        if (!txn.rows.empty()) {
+            mask[i] = txn_survives;
+        }
+    }
+    return mask;
+}
+
+DnCrdtMergeResult DnCrdtMerger::MergeFastNodeEntries(
+    int32_t epoch, const std::vector<int32_t> &fast_node_ids,
+    const std::unordered_map<int32_t, DnRaftEntry> &fast_node_entries)
+{
+    DnCrdtMergeResult result;
+    std::vector<DnTransaction> all_candidates;
+    struct Locator {
+        int32_t node_id;
+        size_t txn_index_in_all;
+    };
+    std::vector<Locator> locators;
+
+    for (int32_t nid : fast_node_ids) {
+        auto it = fast_node_entries.find(nid);
+        if (it == fast_node_entries.end()) {
+            continue;
+        }
+        for (const auto &txn : it->second.txns) {
+            all_candidates.push_back(txn);
+            locators.push_back({nid, all_candidates.size() - 1});
+        }
+    }
+
+    result.survival_mask = ResolveEpoch(epoch, all_candidates);
+
+    std::unordered_map<int32_t, DnRaftEntry> filtered = fast_node_entries;
+    for (auto &kv : filtered) {
+        kv.second.txns.clear();
+    }
+
+    for (size_t i = 0; i < all_candidates.size(); ++i) {
+        int32_t origin = locators[i].node_id;
+        const DnTransaction &txn = all_candidates[i];
+        if (result.survival_mask[i]) {
+            result.merged_txns.push_back(txn);
+            filtered[origin].txns.push_back(txn);
+        } else {
+            result.dropped_hashes_by_node[origin].push_back(DnHashTxn(txn));
+        }
+    }
+
+    result.filtered_entries = std::move(filtered);
+    return result;
+}
diff --git a/src/dynamic-net/dn_crdt_merge.h b/src/dynamic-net/dn_crdt_merge.h
new file mode 100644
index 0000000..0a2d6a2
--- /dev/null
+++ b/src/dynamic-net/dn_crdt_merge.h
@@ -0,0 +1,47 @@
+//
+// Deterministic CRDT-style conflict resolution (LWW per row key).
+//
+
+#ifndef DYNAMIC_NET_DN_CRDT_MERGE_H
+#define DYNAMIC_NET_DN_CRDT_MERGE_H
+
+#include "dn_types.h"
+
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+struct DnCrdtMergeResult {
+    std::vector<DnTransaction> merged_txns;
+    std::unordered_map<int32_t, std::vector<uint64_t>> dropped_hashes_by_node;
+    std::unordered_map<int32_t, DnRaftEntry> filtered_entries;
+    std::vector<bool> survival_mask;
+
+    DnCrdtMergeResult() {}
+};
+
+class DnCrdtMerger {
+public:
+    /*
+     * Resolve conflicts among candidate txns from fast nodes for one epoch.
+     * Returns survival_mask aligned with all_candidate_txns input order.
+     */
+    std::vector<bool> ResolveEpoch(int32_t epoch, const std::vector<DnTransaction> &all_candidate_txns) const;
+
+    /*
+     * Full deterministic merge: filter entries per origin node, collect merged txns + dropped hashes.
+     */
+    DnCrdtMergeResult MergeFastNodeEntries(int32_t epoch, const std::vector<int32_t> &fast_node_ids,
+                                           const std::unordered_map<int32_t, DnRaftEntry> &fast_node_entries);
+
+private:
+    struct RowWinner {
+        uint64_t tie_break;
+        size_t txn_index;
+    };
+
+    static uint64_t MakeTieBreak(int32_t epoch, uint32_t origin_node, uint64_t client_txn_id);
+    static bool TxnWins(uint64_t tie_a, uint64_t tie_b);
+};
+
+#endif /* DYNAMIC_NET_DN_CRDT_MERGE_H */
diff --git a/src/dynamic-net/dn_epoch_manager.cpp b/src/dynamic-net/dn_epoch_manager.cpp
new file mode 100644
index 0000000..9c88d6b
--- /dev/null
+++ b/src/dynamic-net/dn_epoch_manager.cpp
@@ -0,0 +1,204 @@
+//
+// Global epoch barrier + FIXED/CATCHUP implementation.
+//
+
+#include "dn_epoch_manager.h"
+
+#include <algorithm>
+#include <climits>
+#include <memory>
+
+DnEpochManager::DnEpochManager(int node_id, const DnNetworkConfig *config, DnEpochObserver *observer)
+    : m_nodeId(node_id), m_config(config), m_observer(observer), m_globalEpoch(1)
+{
+    int count = config != nullptr ? config->node_count : 3;
+    m_executeIndexes.assign(count, 1);
+}
+
+void DnEpochManager::Configure(const DnNetworkConfig *config)
+{
+    m_config = config;
+    if (config != nullptr && static_cast<int>(m_executeIndexes.size()) != config->node_count) {
+        m_executeIndexes.assign(config->node_count, 1);
+    }
+}
+
+void DnEpochManager::RecordObservedEpochFromAppend(int32_t sender_epoch, int from_node, int to_node)
+{
+    if (m_observer != nullptr) {
+        m_observer->RecordObservedEpoch(sender_epoch, from_node, to_node);
+    }
+}
+
+DnProposalStrategy DnEpochManager::ConsultProposalStrategy(int32_t current_local_proposal_epoch,
+                                                             int32_t current_net_queue_size,
+                                                             bool is_slow_node)
+{
+    DnProposalStrategy result;
+    result.should_propose = true;
+    result.action = DnStrategyAction::NORMAL;
+    result.target_epoch = current_local_proposal_epoch;
+    result.jump_delta = 0;
+
+    int projected_max = m_observer != nullptr ? m_observer->GetMaxObservedEpoch() : current_local_proposal_epoch;
+    int lag = projected_max - current_local_proposal_epoch;
+    result.lag = lag;
+
+    if (m_config == nullptr ||
+        m_config->advancement != DnEpochAdvancement::CATCHUP || !is_slow_node) {
+        return result;
+    }
+
+    bool lag_trigger = lag > m_config->lag_tolerance;
+    bool queue_trigger = current_net_queue_size > m_config->queue_size_tolerance;
+    if (!lag_trigger && !queue_trigger) {
+        return result;
+    }
+
+    int target_jump = projected_max + m_config->catchup_factor_k;
+    int delta = target_jump - current_local_proposal_epoch;
+    if (delta > 0) {
+        result.action = DnStrategyAction::JUMP;
+        result.target_epoch = target_jump;
+        result.jump_delta = delta;
+    }
+    return result;
+}
+
+bool DnEpochManager::IsBarrierReady(uint64_t target_epoch,
+                                    const std::unordered_map<int32_t, DnPeerLogState> &logs)
+{
+    if (m_config == nullptr) {
+        return false;
+    }
+
+    for (int i = 0; i < m_config->node_count; ++i) {
+        auto it = logs.find(i);
+        if (it == logs.end()) {
+            return false;
+        }
+        const DnPeerLogState &log = it->second;
+        int current_idx = m_executeIndexes[i];
+        int commit_idx = log.commit_index.load(std::memory_order_acquire);
+        bool channel_ready = false;
+
+        for (int idx = current_idx; idx < static_cast<int>(log.entries.size()) && idx <= commit_idx; ++idx) {
+            int e = log.entries[idx].epoch;
+            if (e >= static_cast<int>(target_epoch)) {
+                channel_ready = true;
+                break;
+            }
+        }
+        if (!channel_ready) {
+            return false;
+        }
+    }
+    return true;
+}
+
+std::unique_ptr<DnEpochBatch> DnEpochManager::TryCollectBatch(
+    const std::unordered_map<int32_t, DnPeerLogState> &logs)
+{
+    std::lock_guard<std::mutex> lock(m_executionMutex);
+    uint64_t target_epoch = m_globalEpoch.load(std::memory_order_relaxed);
+
+    if (!IsBarrierReady(target_epoch, logs)) {
+        return nullptr;
+    }
+
+    uint64_t min_actual_epoch = UINT64_MAX;
+    for (int i = 0; i < m_config->node_count; ++i) {
+        auto it = logs.find(i);
+        if (it == logs.end()) {
+            continue;
+        }
+        const DnPeerLogState &log = it->second;
+        int exec_idx = m_executeIndexes[i];
+        int commit_idx = log.commit_index.load(std::memory_order_acquire);
+        for (int idx = exec_idx; idx < static_cast<int>(log.entries.size()) && idx <= commit_idx; ++idx) {
+            int e = log.entries[idx].epoch;
+            if (e >= static_cast<int>(target_epoch)) {
+                min_actual_epoch = std::min(min_actual_epoch, static_cast<uint64_t>(e));
+                break;
+            }
+        }
+    }
+
+    if (min_actual_epoch != UINT64_MAX && min_actual_epoch > target_epoch) {
+        bool has_data_in_gap = false;
+        for (int i = 0; i < m_config->node_count; ++i) {
+            auto it = logs.find(i);
+            if (it == logs.end()) {
+                continue;
+            }
+            const DnPeerLogState &log = it->second;
+            int exec_idx = m_executeIndexes[i];
+            int commit_idx = log.commit_index.load(std::memory_order_acquire);
+            for (int idx = exec_idx; idx < static_cast<int>(log.entries.size()) && idx <= commit_idx; ++idx) {
+                int e = log.entries[idx].epoch;
+                if (e >= static_cast<int>(target_epoch) && e < static_cast<int>(min_actual_epoch)) {
+                    has_data_in_gap = true;
+                    break;
+                }
+            }
+            if (has_data_in_gap) {
+                break;
+            }
+        }
+        if (!has_data_in_gap) {
+            m_globalEpoch.store(min_actual_epoch, std::memory_order_relaxed);
+            target_epoch = min_actual_epoch;
+        }
+    }
+
+    auto batch = std::make_unique<DnEpochBatch>();
+    batch->epoch_id = target_epoch;
+
+    for (int i = 0; i < m_config->node_count; ++i) {
+        auto it = logs.find(i);
+        if (it == logs.end()) {
+            continue;
+        }
+        const DnPeerLogState &log = it->second;
+        int &exec_idx = m_executeIndexes[i];
+        int commit_idx = log.commit_index.load(std::memory_order_acquire);
+
+        while (exec_idx < static_cast<int>(log.entries.size()) && exec_idx <= commit_idx) {
+            const DnRaftEntry &entry = log.entries[exec_idx];
+            if (entry.epoch < static_cast<int>(target_epoch)) {
+                exec_idx++;
+                continue;
+            }
+            if (entry.epoch > static_cast<int>(target_epoch)) {
+                break;
+            }
+            if (entry.type == DnEntryType::WRITE) {
+                for (const auto &txn : entry.txns) {
+                    batch->transactions.push_back(txn);
+                }
+            }
+            exec_idx++;
+            break;
+        }
+    }
+
+    m_globalEpoch.fetch_add(1, std::memory_order_relaxed);
+    return batch;
+}
+
+uint64_t DnEpochManager::GetGlobalEpoch() const
+{
+    return m_globalEpoch.load(std::memory_order_acquire);
+}
+
+const std::vector<int32_t> &DnEpochManager::GetExecuteIndexes() const
+{
+    return m_executeIndexes;
+}
+
+void DnEpochManager::Reset()
+{
+    std::lock_guard<std::mutex> lock(m_executionMutex);
+    m_globalEpoch.store(1, std::memory_order_relaxed);
+    std::fill(m_executeIndexes.begin(), m_executeIndexes.end(), 1);
+}
