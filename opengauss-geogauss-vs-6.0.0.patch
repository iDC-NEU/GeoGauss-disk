+#define EPOCH_COUNTER_OP(name, field, op, extra)                                           \
+    uint64_t E_NodeManager::name(uint64_t epochId, uint64_t nodeId) extra                  \
+    {                                                                                      \
+        EpochSharedState* state = EpochState();                                            \
+        if (state == nullptr) {                                                            \
+            return 0;                                                                      \
