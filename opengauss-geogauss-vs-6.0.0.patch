diff --git a/src/dynamic-net/dn_transport.cpp b/src/dynamic-net/dn_transport.cpp
new file mode 100644
index 0000000..849eac7
--- /dev/null
+++ b/src/dynamic-net/dn_transport.cpp
@@ -0,0 +1,96 @@
+#include "dn_transport.h"
+
+#include "dn_api.h"
+#include "dn_message_dispatch.h"
+#include "dn_wire_codec.h"
+
+DnTransport &DnTransport::Instance()
+{
+    static DnTransport instance;
+    return instance;
+}
+
+DnTransport::DnTransport() {}
+
+void DnTransport::SetSendFn(DnSendWireFn fn)
+{
+    m_sendFn = std::move(fn);
+}
+
+void DnTransport::SetReceiveHook(std::function<void(DnNetworkModule *net)> hook)
+{
+    m_receiveHook = std::move(hook);
+}
+
+void DnTransport::FlushOutgoing(DnNetworkModule *net)
+{
+    if (net == nullptr || !m_sendFn) {
+        return;
+    }
+    std::vector<DnOutgoingPacket> ready = net->PopReadyOutgoingPackets();
+    for (const auto &out : ready) {
+        m_sendFn(out.target_node_id, out.packet, out.is_reply);
+    }
+}
+
+void DnTransport::PushPendingWirePayload(std::string payload)
+{
+    std::lock_guard<std::mutex> lock(m_pendingWireMutex);
+    m_pendingWire.push_back(std::move(payload));
+}
+
+bool DnTransport::PopPendingWirePayload(std::string *out)
+{
+    if (out == nullptr) {
+        return false;
+    }
+    std::lock_guard<std::mutex> lock(m_pendingWireMutex);
+    if (m_pendingWire.empty()) {
+        return false;
+    }
+    *out = std::move(m_pendingWire.front());
+    m_pendingWire.pop_front();
+    return true;
+}
+
+void DnTransport::PollIncoming(DnNetworkModule *net)
+{
+    if (net == nullptr) {
+        return;
+    }
+
+    if (m_receiveHook) {
+        m_receiveHook(net);
+    }
+
+    DnRuntime &rt = DnRuntime::Instance();
+    std::vector<DnIncomingPacket> ready = net->PopReadyIncomingPackets();
+    for (const auto &in : ready) {
+        DnIncomingPacket work = in;
+        DnNetworkPacket &pkt = work.packet;
+
+        if (pkt.kind == DnMsgKind::WIRE_PAYLOAD && !pkt.wire_payload.empty()) {
+            DnNetworkPacket decoded;
+            if (DnWireTryDecodePayload(pkt.wire_payload.data(), pkt.wire_payload.size(),
+                                       in.from_node_id, &decoded)) {
+                work.packet = decoded;
+                work.packet.from_node_id = in.from_node_id;
+                pkt = work.packet;
+            }
+        }
+
+        if (pkt.kind == DnMsgKind::WIRE_PAYLOAD) {
+            PushPendingWirePayload(pkt.wire_payload);
+            continue;
+        }
+
+        DnDispatchResult dr = DnMessageDispatch::Dispatch(work);
+        rt.ProcessDispatchFollowUp(net, dr);
+
+        if (rt.GetDispatchSideEffectFn()) {
+            rt.GetDispatchSideEffectFn()(work, dr);
+        }
+    }
+
+    FlushOutgoing(net);
+}
diff --git a/src/dynamic-net/dn_transport.h b/src/dynamic-net/dn_transport.h
new file mode 100644
index 0000000..fb51927
--- /dev/null
+++ b/src/dynamic-net/dn_transport.h
@@ -0,0 +1,50 @@
+//
+// Pluggable transport callbacks — wire DnNetworkModule to real ZMQ/libcomm later.
+//
+
+#ifndef DYNAMIC_NET_DN_TRANSPORT_H
+#define DYNAMIC_NET_DN_TRANSPORT_H
+
+#include "dn_network_module.h"
+#include "dn_types.h"
+
+#include <deque>
+#include <functional>
+#include <mutex>
+#include <string>
+
+using DnSendWireFn = std::function<void(int target_node_id, const DnNetworkPacket &pkt, bool is_reply)>;
+
+class DnTransport {
+public:
+    static DnTransport &Instance();
+
+    void SetSendFn(DnSendWireFn fn);
+
+    /*
+     * Drain ready outgoing packets from virtual network module and invoke send callback.
+     */
+    void FlushOutgoing(DnNetworkModule *net);
+
+    /*
+     * Pull from wire (receive hook) then dispatch all ready incoming packets.
+     */
+    void PollIncoming(DnNetworkModule *net);
+
+    void SetReceiveHook(std::function<void(DnNetworkModule *net)> hook);
+
+    /* Opaque epoch wire blobs not consumed by dispatch (E_WireTxn path). */
+    void PushPendingWirePayload(std::string payload);
+    bool PopPendingWirePayload(std::string *out);
+
+private:
+    DnTransport();
+
+    DnSendWireFn m_sendFn;
+    std::function<void(DnNetworkModule *net)> m_receiveHook;
+
+    std::mutex m_pendingWireMutex;
+    std::deque<std::string> m_pendingWire;
+};
+
+#endif /* DYNAMIC_NET_DN_TRANSPORT_H */
diff --git a/src/dynamic-net/dn_types.h b/src/dynamic-net/dn_types.h
new file mode 100644
index 0000000..c33dbd3
--- /dev/null
+++ b/src/dynamic-net/dn_types.h
@@ -0,0 +1,234 @@
+//
+// Wire-level types for heterogeneous network replication (dynamic-net).
+// Plain C++ structs — no protobuf dependency; mirrors dynamic-main demo messages.
+//
+
+#ifndef DYNAMIC_NET_DN_TYPES_H
+#define DYNAMIC_NET_DN_TYPES_H
+
+#include <cstdint>
+#include <map>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+enum class DnEntryType : uint8_t {
+    WRITE = 0,
+    EPOCH_STATUS = 1,
+    NOOP = 2
+};
+
+enum class DnMsgKind : uint8_t {
+    APPEND_ENTRIES,
+    APPEND_RESPONSE,
+    COMMIT_NOTIFY,
+    FAST_HASH,
+    PARTIAL_SNAPSHOT,
+    SNAPSHOT_ACK,
+    WIRE_PAYLOAD /* epoch E_WireTxn blob */
+};
+
+enum class DnStrategyAction : uint8_t {
+    NORMAL,
+    JUMP
+};
+
+struct DnRow {
+    std::string key;
+    std::string value;
+    bool is_delete;
+
+    DnRow() : is_delete(false) {}
+};
+
+struct DnTransaction {
+    uint64_t client_txn_id;
+    uint32_t origin_node_id;
+    std::string client_key;
+    std::vector<DnRow> rows;
+
+    DnTransaction() : client_txn_id(0), origin_node_id(0) {}
+};
+
+struct DnRaftEntry {
+    int32_t term;
+    int32_t index;
+    int32_t epoch;
+    DnEntryType type;
+    std::vector<DnTransaction> txns;
+
+    DnRaftEntry() : term(0), index(0), epoch(0), type(DnEntryType::NOOP) {}
+};
+
+struct DnAppendEntriesRequest {
+    int32_t term;
+    int32_t channel_id;
+    int32_t channel_leader_id;
+    int32_t prev_log_index;
+    int32_t prev_log_term;
+    int32_t leader_commit;
+    int32_t epoch;
+    std::vector<DnRaftEntry> entries;
+
+    /* Metadata-only path (FN → SN): entries empty, hash/size carry payload digest */
+    uint64_t payload_hash;
+    int32_t payload_size;
+
+    DnAppendEntriesRequest()
+        : term(0),
+          channel_id(0),
+          channel_leader_id(0),
+          prev_log_index(0),
+          prev_log_term(0),
+          leader_commit(0),
+          epoch(0),
+          payload_hash(0),
+          payload_size(0)
+    {
+    }
+
+    bool IsMetadataOnly() const
+    {
+        return entries.empty();
+    }
+};
+
+struct DnAppendEntriesResponse {
+    int32_t term;
+    int32_t node_id;
+    bool success;
+    int32_t last_log_index;
+    int32_t match_index;
+
+    DnAppendEntriesResponse()
+        : term(0), node_id(0), success(false), last_log_index(0), match_index(0)
+    {
+    }
+};
+
+struct DnCommitNotify {
+    int32_t channel_id;
+    int32_t term;
+    int32_t commit_index;
+
+    DnCommitNotify() : channel_id(0), term(0), commit_index(0) {}
+};
+
+struct DnFastHashMessage {
+    int32_t epoch;
+    uint64_t hash;
+
+    DnFastHashMessage() : epoch(0), hash(0) {}
+};
+
+struct DnNodeContribution {
+    int32_t origin_node_id;
+    std::vector<DnTransaction> committed_txns;
+    std::vector<uint64_t> dropped_hashes;
+    std::string reconstruction_bitmap;
+
+    DnNodeContribution() : origin_node_id(0) {}
+};
+
+struct DnPartialSnapshotMessage {
+    int32_t epoch;
+    int32_t proxy_node_id;
+    std::vector<DnNodeContribution> contributions;
+    uint64_t checksum;
+
+    DnPartialSnapshotMessage() : epoch(0), proxy_node_id(0), checksum(0) {}
+};
+
+struct DnSnapshotAckMessage {
+    int32_t epoch;
+    int32_t node_id;
+    bool success;
+    uint64_t state_hash;
+
+    DnSnapshotAckMessage() : epoch(0), node_id(0), success(false), state_hash(0) {}
+};
+
+struct DnNetworkPacket {
+    DnMsgKind kind;
+    int32_t channel_id;
+    int32_t from_node_id;
+    DnAppendEntriesRequest append_req;
+    DnAppendEntriesResponse append_resp;
+    DnCommitNotify commit_notify;
+    DnFastHashMessage fast_hash;
+    DnPartialSnapshotMessage partial_snapshot;
+    DnSnapshotAckMessage snapshot_ack;
+    std::string wire_payload;
+
+    DnNetworkPacket() : kind(DnMsgKind::APPEND_ENTRIES), channel_id(0), from_node_id(0) {}
+};
+
+/* Slow-node metadata table entry */
+struct DnEpochMetadata {
+    int32_t epoch;
+    bool received;
+    int32_t term;
+    uint64_t payload_hash;
+    int32_t payload_size;
+
+    DnEpochMetadata() : epoch(0), received(false), term(0), payload_hash(0), payload_size(0) {}
+};
+
+struct DnProposalStrategy {
+    DnStrategyAction action;
+    bool should_propose;
+    int32_t target_epoch;
+    int32_t jump_delta;
+    int32_t lag;
+
+    DnProposalStrategy()
+        : action(DnStrategyAction::NORMAL),
+          should_propose(true),
+          target_epoch(0),
+          jump_delta(0),
+          lag(0)
+    {
+    }
+};
+
+struct DnEpochBatch {
+    uint64_t epoch_id;
+    std::vector<DnTransaction> transactions;
+
+    DnEpochBatch() : epoch_id(0) {}
+};
+
+struct DnNetworkStats {
+    uint64_t tx_bytes;
+    uint64_t rx_bytes;
+    uint64_t tx_count;
+    uint64_t rx_count;
+    uint64_t rx_append_full;
+    uint64_t rx_append_meta;
+    uint64_t rx_snapshot;
+    uint64_t dropped_tx;
+    uint64_t dropped_rx;
+    int32_t max_observed_epoch;
+    int32_t last_lag;
+    size_t tx_queue_size;
+    size_t rx_queue_size;
+
+    DnNetworkStats()
+        : tx_bytes(0),
+          rx_bytes(0),
+          tx_count(0),
+          rx_count(0),
+          rx_append_full(0),
+          rx_append_meta(0),
+          rx_snapshot(0),
+          dropped_tx(0),
+          dropped_rx(0),
+          max_observed_epoch(0),
+          last_lag(0),
+          tx_queue_size(0),
+          rx_queue_size(0)
+    {
+    }
+};
+
+#endif /* DYNAMIC_NET_DN_TYPES_H */
diff --git a/src/dynamic-net/dn_wire_codec.cpp b/src/dynamic-net/dn_wire_codec.cpp
new file mode 100644
index 0000000..d13064c
--- /dev/null
+++ b/src/dynamic-net/dn_wire_codec.cpp
@@ -0,0 +1,331 @@
+#include "dn_wire_codec.h"
+
+#include <cstring>
+
+namespace {
+
+static void AppendU32(std::string *out, uint32_t v)
+{
+    out->append(reinterpret_cast<const char *>(&v), sizeof(v));
+}
+
+static void AppendU64(std::string *out, uint64_t v)
+{
+    out->append(reinterpret_cast<const char *>(&v), sizeof(v));
+}
+
+static void AppendI32(std::string *out, int32_t v)
+{
+    out->append(reinterpret_cast<const char *>(&v), sizeof(v));
+}
+
+static void AppendStr(std::string *out, const std::string &s)
+{
+    AppendU32(out, static_cast<uint32_t>(s.size()));
+    if (!s.empty()) {
+        out->append(s.data(), s.size());
+    }
+}
+
+static bool ReadU32(const char *&p, const char *end, uint32_t *v)
+{
+    if (p + static_cast<ptrdiff_t>(sizeof(uint32_t)) > end) {
+        return false;
+    }
+    memcpy(v, p, sizeof(uint32_t));
+    p += sizeof(uint32_t);
+    return true;
+}
+
+static bool ReadU64(const char *&p, const char *end, uint64_t *v)
+{
+    if (p + static_cast<ptrdiff_t>(sizeof(uint64_t)) > end) {
+        return false;
+    }
+    memcpy(v, p, sizeof(uint64_t));
+    p += sizeof(uint64_t);
+    return true;
+}
+
+static bool ReadI32(const char *&p, const char *end, int32_t *v)
+{
+    if (p + static_cast<ptrdiff_t>(sizeof(int32_t)) > end) {
+        return false;
+    }
+    memcpy(v, p, sizeof(int32_t));
+    p += sizeof(int32_t);
+    return true;
+}
+
+static bool ReadStr(const char *&p, const char *end, std::string *out)
+{
+    uint32_t len = 0;
+    if (!ReadU32(p, end, &len)) {
+        return false;
+    }
+    if (p + len > end) {
+        return false;
+    }
+    out->assign(p, len);
+    p += len;
+    return true;
+}
+
+static bool ReadEnvelopeHeader(const char *data, size_t len, DnWireEnvelopeKind *kind)
+{
+    if (data == nullptr || len < sizeof(uint64_t) + sizeof(uint32_t) * 2 || kind == nullptr) {
+        return false;
+    }
+    const char *p = data;
+    const char *end = data + len;
+    uint64_t magic = 0;
+    uint32_t version = 0;
+    uint32_t k = 0;
+    if (!ReadU64(p, end, &magic) || magic != DN_WIRE_ENVELOPE_MAGIC) {
+        return false;
+    }
+    if (!ReadU32(p, end, &version) || version != DN_WIRE_ENVELOPE_VERSION) {
+        return false;
+    }
+    if (!ReadU32(p, end, &k)) {
+        return false;
+    }
+    *kind = static_cast<DnWireEnvelopeKind>(k);
+    return true;
+}
+
+static bool SerializeDnRow(const DnRow &row, std::string *out)
+{
+    AppendStr(out, row.key);
+    AppendStr(out, row.value);
+    uint8_t del = row.is_delete ? 1 : 0;
+    out->append(reinterpret_cast<const char *>(&del), sizeof(del));
+    return true;
+}
+
+static bool ParseDnRow(const char *&p, const char *end, DnRow *row)
+{
+    if (row == nullptr) {
+        return false;
+    }
+    if (!ReadStr(p, end, &row->key) || !ReadStr(p, end, &row->value)) {
+        return false;
+    }
+    if (p + static_cast<ptrdiff_t>(sizeof(uint8_t)) > end) {
+        return false;
+    }
+    row->is_delete = (*p != 0);
+    p += sizeof(uint8_t);
+    return true;
+}
+
+static bool SerializeDnTxn(const DnTransaction &txn, std::string *out)
+{
+    AppendU64(out, txn.client_txn_id);
+    AppendU32(out, txn.origin_node_id);
+    AppendStr(out, txn.client_key);
+    AppendU32(out, static_cast<uint32_t>(txn.rows.size()));
+    for (const auto &row : txn.rows) {
+        if (!SerializeDnRow(row, out)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool ParseDnTxn(const char *&p, const char *end, DnTransaction *txn)
+{
+    if (txn == nullptr) {
+        return false;
+    }
+    if (!ReadU64(p, end, &txn->client_txn_id) || !ReadU32(p, end, &txn->origin_node_id) ||
+        !ReadStr(p, end, &txn->client_key)) {
+        return false;
+    }
+    uint32_t row_count = 0;
+    if (!ReadU32(p, end, &row_count)) {
+        return false;
+    }
+    txn->rows.clear();
+    txn->rows.reserve(row_count);
+    for (uint32_t i = 0; i < row_count; ++i) {
+        DnRow row;
+        if (!ParseDnRow(p, end, &row)) {
+            return false;
+        }
+        txn->rows.push_back(std::move(row));
+    }
+    return true;
+}
+
+}  // namespace
+
+bool DnWireSerializePartialSnapshot(const DnPartialSnapshotMessage &snap, std::string *out)
+{
+    if (out == nullptr) {
+        return false;
+    }
+    out->clear();
+    AppendU64(out, DN_WIRE_ENVELOPE_MAGIC);
+    AppendU32(out, DN_WIRE_ENVELOPE_VERSION);
+    AppendU32(out, static_cast<uint32_t>(DN_WIRE_ENV_PARTIAL_SNAPSHOT));
+    AppendI32(out, snap.epoch);
+    AppendI32(out, snap.proxy_node_id);
+    AppendU64(out, snap.checksum);
+    AppendU32(out, static_cast<uint32_t>(snap.contributions.size()));
+    for (const auto &contrib : snap.contributions) {
+        AppendI32(out, contrib.origin_node_id);
+        AppendU32(out, static_cast<uint32_t>(contrib.committed_txns.size()));
+        for (const auto &txn : contrib.committed_txns) {
+            if (!SerializeDnTxn(txn, out)) {
+                return false;
+            }
+        }
+        AppendU32(out, static_cast<uint32_t>(contrib.dropped_hashes.size()));
+        for (uint64_t h : contrib.dropped_hashes) {
+            AppendU64(out, h);
+        }
+        AppendStr(out, contrib.reconstruction_bitmap);
+    }
+    return true;
+}
+
+bool DnWireParsePartialSnapshot(const char *data, size_t len, DnPartialSnapshotMessage *out)
+{
+    if (out == nullptr) {
+        return false;
+    }
+    DnWireEnvelopeKind kind = DN_WIRE_ENV_PARTIAL_SNAPSHOT;
+    if (!ReadEnvelopeHeader(data, len, &kind) || kind != DN_WIRE_ENV_PARTIAL_SNAPSHOT) {
+        return false;
+    }
+    const char *p = data + sizeof(uint64_t) + sizeof(uint32_t) * 2;
+    const char *end = data + len;
+    if (!ReadI32(p, end, &out->epoch) || !ReadI32(p, end, &out->proxy_node_id) ||
+        !ReadU64(p, end, &out->checksum)) {
+        return false;
+    }
+    uint32_t contrib_count = 0;
+    if (!ReadU32(p, end, &contrib_count)) {
+        return false;
+    }
+    out->contributions.clear();
+    out->contributions.reserve(contrib_count);
+    for (uint32_t ci = 0; ci < contrib_count; ++ci) {
+        DnNodeContribution contrib;
+        if (!ReadI32(p, end, &contrib.origin_node_id)) {
+            return false;
+        }
+        uint32_t txn_count = 0;
+        if (!ReadU32(p, end, &txn_count)) {
+            return false;
+        }
+        for (uint32_t ti = 0; ti < txn_count; ++ti) {
+            DnTransaction txn;
+            if (!ParseDnTxn(p, end, &txn)) {
+                return false;
+            }
+            contrib.committed_txns.push_back(std::move(txn));
+        }
+        uint32_t drop_count = 0;
+        if (!ReadU32(p, end, &drop_count)) {
+            return false;
+        }
+        for (uint32_t di = 0; di < drop_count; ++di) {
+            uint64_t h = 0;
+            if (!ReadU64(p, end, &h)) {
+                return false;
+            }
+            contrib.dropped_hashes.push_back(h);
+        }
+        if (!ReadStr(p, end, &contrib.reconstruction_bitmap)) {
+            return false;
+        }
+        out->contributions.push_back(std::move(contrib));
+    }
+    return true;
+}
+
+bool DnWireSerializeMetadataEnvelope(int32_t from_node, int32_t epoch, uint64_t payload_hash,
+                                     int32_t payload_size, std::string *out)
+{
+    if (out == nullptr) {
+        return false;
+    }
+    out->clear();
+    AppendU64(out, DN_WIRE_ENVELOPE_MAGIC);
+    AppendU32(out, DN_WIRE_ENVELOPE_VERSION);
+    AppendU32(out, static_cast<uint32_t>(DN_WIRE_ENV_TXN_METADATA));
+    AppendU64(out, 0);
+    AppendU64(out, static_cast<uint64_t>(epoch));
+    AppendU64(out, static_cast<uint64_t>(epoch));
+    AppendU32(out, static_cast<uint32_t>(from_node));
+    AppendU64(out, payload_hash);
+    AppendI32(out, payload_size);
+    return true;
+}
+
+bool DnWireTryDecodePayload(const char *data, size_t len, int from_node_id, DnNetworkPacket *out)
+{
+    if (data == nullptr || out == nullptr || len < sizeof(uint64_t)) {
+        return false;
+    }
+
+    DnWireEnvelopeKind kind = DN_WIRE_ENV_TXN_METADATA;
+    if (!ReadEnvelopeHeader(data, len, &kind)) {
+        return false;
+    }
+
+    out->from_node_id = from_node_id;
+
+    if (kind == DN_WIRE_ENV_PARTIAL_SNAPSHOT) {
+        out->kind = DnMsgKind::PARTIAL_SNAPSHOT;
+        return DnWireParsePartialSnapshot(data, len, &out->partial_snapshot);
+    }
+
+    if (kind == DN_WIRE_ENV_TXN_METADATA) {
+        const char *p = data + sizeof(uint64_t) + sizeof(uint32_t) * 2;
+        const char *end = data + len;
+        uint64_t csn = 0;
+        uint64_t start_epoch = 0;
+        uint64_t commit_epoch = 0;
+        uint32_t server_id = 0;
+        uint64_t payload_hash = 0;
+        int32_t payload_size = 0;
+        if (!ReadU64(p, end, &csn) || !ReadU64(p, end, &start_epoch) ||
+            !ReadU64(p, end, &commit_epoch) || !ReadU32(p, end, &server_id) ||
+            !ReadU64(p, end, &payload_hash) || !ReadI32(p, end, &payload_size)) {
+            return false;
+        }
+        (void)csn;
+        out->kind = DnMsgKind::APPEND_ENTRIES;
+        out->append_req.epoch = static_cast<int32_t>(commit_epoch);
+        out->append_req.channel_id = static_cast<int32_t>(server_id);
+        out->append_req.payload_hash = payload_hash;
+        out->append_req.payload_size = payload_size;
+        out->append_req.entries.clear();
+        return true;
+    }
+
+    return false;
+}
+
+bool DnWireSerializePacket(const DnNetworkPacket &pkt, std::string *out)
+{
+    if (out == nullptr) {
+        return false;
+    }
+    if (pkt.kind == DnMsgKind::WIRE_PAYLOAD) {
+        *out = pkt.wire_payload;
+        return true;
+    }
+    if (pkt.kind == DnMsgKind::PARTIAL_SNAPSHOT) {
+        return DnWireSerializePartialSnapshot(pkt.partial_snapshot, out);
+    }
+    if (pkt.kind == DnMsgKind::APPEND_ENTRIES && pkt.append_req.IsMetadataOnly()) {
+        return DnWireSerializeMetadataEnvelope(pkt.from_node_id, pkt.append_req.epoch,
+                                               pkt.append_req.payload_hash,
+                                               pkt.append_req.payload_size, out);
+    }
+    return false;
+}
diff --git a/src/dynamic-net/dn_wire_codec.h b/src/dynamic-net/dn_wire_codec.h
new file mode 100644
index 0000000..761b384
--- /dev/null
+++ b/src/dynamic-net/dn_wire_codec.h
@@ -0,0 +1,40 @@
+//
+// Binary wire codec for dynamic-net packets (interoperable with epoch envelope magic).
+//
+
+#ifndef DYNAMIC_NET_DN_WIRE_CODEC_H
+#define DYNAMIC_NET_DN_WIRE_CODEC_H
+
+#include "dn_types.h"
+
+#include <cstddef>
+#include <string>
+
+static constexpr uint64_t DN_WIRE_ENVELOPE_MAGIC = UINT64_C(0xE0C0D00D);
+static constexpr uint32_t DN_WIRE_ENVELOPE_VERSION = 1;
+
+enum DnWireEnvelopeKind : uint32_t {
+    DN_WIRE_ENV_TXN_METADATA = 1,
+    DN_WIRE_ENV_PARTIAL_SNAPSHOT = 2
+};
+
+/*
+ * Decode an on-wire blob into a typed DnNetworkPacket.
+ * Returns true when the blob is a recognized dynamic-net / epoch envelope.
+ * Otherwise returns false and the caller should treat the blob as opaque WIRE_PAYLOAD.
+ */
+bool DnWireTryDecodePayload(const char *data, size_t len, int from_node_id, DnNetworkPacket *out);
+
+bool DnWireSerializePartialSnapshot(const DnPartialSnapshotMessage &snap, std::string *out);
+bool DnWireParsePartialSnapshot(const char *data, size_t len, DnPartialSnapshotMessage *out);
+
+bool DnWireSerializeMetadataEnvelope(int32_t from_node, int32_t epoch, uint64_t payload_hash,
+                                     int32_t payload_size, std::string *out);
+
+/*
+ * Serialize a network packet for ZMQ / libcomm transport.
+ * WIRE_PAYLOAD returns wire_payload as-is; other kinds use native framing.
+ */
+bool DnWireSerializePacket(const DnNetworkPacket &pkt, std::string *out);
+
+#endif /* DYNAMIC_NET_DN_WIRE_CODEC_H */
