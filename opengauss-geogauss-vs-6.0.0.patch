+        tag,
+        epoch,
+        row_count,
+        ok ? g_recvdiag_applied_txns[epoch] : 0UL,
+        ok ? g_recvdiag_applied_rows[epoch] : 0UL);
+    securec_check_ss(rc, "\0", "\0");
+    EpochRecvDiagAppendLine(buf);
+}
