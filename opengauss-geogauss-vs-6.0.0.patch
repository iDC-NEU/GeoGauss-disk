+//
+// Incoming message dispatch (framework — no ZMQ dependency).
+//
+
+#ifndef DYNAMIC_NET_DN_MESSAGE_DISPATCH_H
+#define DYNAMIC_NET_DN_MESSAGE_DISPATCH_H
+
+#include "dn_network_module.h"
+#include "dn_snapshot_validator.h"
+#include "dn_types.h"
+
+#include <vector>
+
+struct DnDispatchResult {
+    bool handled;
+    bool need_advance_global_epoch;
+    bool need_try_fast_merge;
+    int32_t fast_merge_epoch;
+    bool need_build_proxy;
+    int32_t proxy_epoch;
+    DnSnapshotValidationResult snapshot_validation;
+    bool snapshot_applied;
+    int32_t snapshot_epoch;
+    std::vector<DnTransaction> applied_txns;
+
+    DnDispatchResult()
+        : handled(false),
+          need_advance_global_epoch(false),
+          need_try_fast_merge(false),
+          fast_merge_epoch(0),
+          need_build_proxy(false),
+          proxy_epoch(0),
+          snapshot_validation(DnSnapshotValidationResult::OK),
+          snapshot_applied(false),
+          snapshot_epoch(0)
+    {
+    }
+};
+
+class DnMessageDispatch {
+public:
+    static DnDispatchResult Dispatch(const DnIncomingPacket &pkt);
+
+    static DnDispatchResult HandleAppend(int from_node, const DnAppendEntriesRequest &req);
+    static DnDispatchResult HandleCommitNotify(int from_node, const DnCommitNotify &notify,
+                                               const DnRaftEntry *committed_entry);
+    static DnDispatchResult HandleFastHash(int from_node, const DnFastHashMessage &msg);
+    static DnDispatchResult HandlePartialSnapshot(int from_node, const DnPartialSnapshotMessage &msg);
+    static DnDispatchResult HandleSnapshotAck(int from_node, const DnSnapshotAckMessage &msg);
+};
+
+#endif /* DYNAMIC_NET_DN_MESSAGE_DISPATCH_H */
diff --git a/src/dynamic-net/dn_network_module.cpp b/src/dynamic-net/dn_network_module.cpp
new file mode 100644
index 0000000..c83be0a
--- /dev/null
+++ b/src/dynamic-net/dn_network_module.cpp
@@ -0,0 +1,292 @@
+//
+// Virtual network module implementation.
+//
+
+#include "dn_network_module.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+
+namespace {
+
+long long DefaultNowMs()
+{
+    using clock = std::chrono::steady_clock;
+    return static_cast<long long>(
+        std::chrono::duration_cast<std::chrono::milliseconds>(clock::now().time_since_epoch()).count());
+}
+
+size_t DefaultPacketSize(const DnNetworkPacket &pkt)
+{
+    size_t size = 64;
+    if (pkt.kind == DnMsgKind::WIRE_PAYLOAD) {
+        return pkt.wire_payload.size() + 64;
+    } else if (pkt.kind == DnMsgKind::APPEND_ENTRIES) {
+        for (const auto &entry : pkt.append_req.entries) {
+            size += 32;
+            for (const auto &txn : entry.txns) {
+                size += 16 + txn.client_key.size();
+                for (const auto &row : txn.rows) {
+                    size += row.key.size() + row.value.size() + 8;
+                }
+            }
+        }
+        size += static_cast<size_t>(pkt.append_req.payload_size);
+    } else if (pkt.kind == DnMsgKind::PARTIAL_SNAPSHOT) {
+        for (const auto &c : pkt.partial_snapshot.contributions) {
+            for (const auto &txn : c.committed_txns) {
+                size += 16 + txn.client_key.size();
+            }
+            size += c.dropped_hashes.size() * 8;
+        }
+    }
+    return size;
+}
+
+}  // namespace
+
+DnNetworkModule::DnNetworkModule(int node_id, DnTrafficShaper *shaper, const DnNetworkConfig *config)
+    : m_nodeId(node_id),
+      m_shaper(shaper),
+      m_config(config),
+      m_nowFn(DefaultNowMs),
+      m_sizeFn(DefaultPacketSize),
+      m_droppedTx(0),
+      m_droppedRx(0)
+{
+}
+
+void DnNetworkModule::SetClock(DnNowMsFn now_fn)
+{
+    if (now_fn) {
+        m_nowFn = std::move(now_fn);
+    }
+}
+
+void DnNetworkModule::SetPacketSizeFn(DnPacketSizeFn size_fn)
+{
+    if (size_fn) {
+        m_sizeFn = std::move(size_fn);
+    }
+}
+
+long long DnNetworkModule::NowMs() const
+{
+    return m_nowFn ? m_nowFn() : DefaultNowMs();
+}
+
+size_t DnNetworkModule::PacketSize(const DnNetworkPacket &pkt) const
+{
+    return m_sizeFn ? m_sizeFn(pkt) : DefaultPacketSize(pkt);
+}
+
+bool DnNetworkModule::IsHighPriority(const DnNetworkPacket &pkt) const
+{
+    switch (pkt.kind) {
+        case DnMsgKind::APPEND_ENTRIES:
+            return pkt.append_req.entries.empty();
+        case DnMsgKind::APPEND_RESPONSE:
+        case DnMsgKind::COMMIT_NOTIFY:
+        case DnMsgKind::FAST_HASH:
+        case DnMsgKind::SNAPSHOT_ACK:
+            return true;
+        case DnMsgKind::PARTIAL_SNAPSHOT:
+        case DnMsgKind::WIRE_PAYLOAD:
+            return false;
+        default:
+            return true;
+    }
+}
+
+bool DnNetworkModule::IsDroppable(const DnNetworkPacket &pkt) const
+{
+    (void)pkt;
+    return false;
+}
+
+void DnNetworkModule::SendMessage(const DnNetworkPacket &pkt, int target_node_id, bool is_reply)
+{
+    if (target_node_id < 0 && !is_reply) {
+        return;
+    }
+
+    std::lock_guard<std::mutex> lock(m_mutex);
+    long long now = NowMs();
+    bool high = IsHighPriority(pkt);
+    size_t size_bytes = PacketSize(pkt);
+
+    bool limit_tx = m_shaper != nullptr && m_shaper->ShouldLimitTx();
+    long long tx_cost = 0;
+    if (limit_tx && m_shaper != nullptr) {
+        tx_cost = m_shaper->CalculateTxCost(size_bytes, high);
+    }
+
+    long long start_time = now;
+    if (m_shaper != nullptr) {
+        start_time = std::max(now, m_shaper->GetLastFinishTime(high));
+    }
+    long long finish_time = start_time + tx_cost;
+
+    if (limit_tx && m_config != nullptr && IsDroppable(pkt)) {
+        long long queue_ahead = start_time - now;
+        long long max_ahead =
+            high ? m_config->max_ctrl_queue_ahead_ms : m_config->max_tx_queue_ahead_ms;
+        if (queue_ahead > max_ahead) {
+            m_droppedTx++;
+            return;
+        }
+    }
+
+    if (m_shaper != nullptr) {
+        m_shaper->UpdateBusyState(finish_time, high);
+    }
+
+    DnOutgoingPacket out;
+    out.release_time_ms = finish_time;
+    out.packet = pkt;
+    out.target_node_id = target_node_id;
+    out.is_reply = is_reply;
+
+    if (high) {
+        m_controlQueue.push_back(std::move(out));
+    } else {
+        m_dataQueue.push_back(std::move(out));
+    }
+}
+
+std::vector<DnOutgoingPacket> DnNetworkModule::PopReadyOutgoingPackets()
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    std::vector<DnOutgoingPacket> ready;
+    long long now = NowMs();
+
+    auto pop_from = [&](std::deque<DnOutgoingPacket> &q) {
+        while (!q.empty() && q.front().release_time_ms <= now) {
+            ready.push_back(std::move(q.front()));
+            q.pop_front();
+        }
+    };
+
+    pop_from(m_controlQueue);
+    pop_from(m_dataQueue);
+    return ready;
+}
+
+std::map<int32_t, int32_t> DnNetworkModule::PredictiveEpochRewrite(int32_t base_epoch)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    std::map<int32_t, int32_t> updates;
+    if (m_config == nullptr || m_config->epoch_duration_ms <= 0) {
+        return updates;
+    }
+
+    long long now = NowMs();
+    for (auto &pkt : m_dataQueue) {
+        if (pkt.packet.kind != DnMsgKind::APPEND_ENTRIES) {
+            continue;
+        }
+        DnAppendEntriesRequest &req = pkt.packet.append_req;
+        if (req.entries.empty()) {
+            continue;
+        }
+
+        long long queue_delay = pkt.release_time_ms - now;
+        if (queue_delay < 0) {
+            queue_delay = 0;
+        }
+        int epoch_offset =
+            static_cast<int>(std::ceil(static_cast<double>(queue_delay) / m_config->epoch_duration_ms));
+        int new_epoch = base_epoch + epoch_offset;
+        req.epoch = new_epoch;
+
+        for (auto &entry : req.entries) {
+            entry.epoch = new_epoch;
+            if (entry.index > 0) {
+                updates[entry.index] = new_epoch;
+            }
+        }
+    }
+    return updates;
+}
+
+size_t DnNetworkModule::GetTxQueueSize() const
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    return m_dataQueue.size();
+}
+
+size_t DnNetworkModule::GetRxQueueSize() const
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    return m_incomingData.size();
+}
+
+long long DnNetworkModule::GetDroppedTx() const
+{
+    return m_droppedTx;
+}
+
+long long DnNetworkModule::GetDroppedRx() const
+{
+    return m_droppedRx;
+}
+
+void DnNetworkModule::EnqueueIncoming(const DnNetworkPacket &pkt, int from_node_id, size_t raw_size_bytes,
+                                      long long arrival_at_nic_ms)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    bool high = IsHighPriority(pkt);
+    long long deliver_time = arrival_at_nic_ms;
+
+    if (m_shaper != nullptr && m_shaper->ShouldLimitRx()) {
+        long long rx_ahead = m_shaper->GetRxQueueAheadMs(arrival_at_nic_ms, high);
+        long long max_rx = m_config != nullptr ? m_config->max_rx_queue_ahead_ms : 800;
+        if (rx_ahead > max_rx && IsDroppable(pkt)) {
+            m_droppedRx++;
+            return;
+        }
+        deliver_time = m_shaper->CalculateRxFinishTime(arrival_at_nic_ms, raw_size_bytes, high);
+    }
+
+    DnIncomingPacket in;
+    in.deliver_at_ms = deliver_time;
+    in.packet = pkt;
+    in.from_node_id = from_node_id;
+    in.is_high_priority = high;
+
+    if (high) {
+        m_incomingCtrl.push(in);
+    } else {
+        m_incomingData.push(in);
+    }
+}
+
+std::vector<DnIncomingPacket> DnNetworkModule::PopReadyIncomingPackets()
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    std::vector<DnIncomingPacket> ready;
+    long long now = NowMs();
+
+    while (true) {
+        bool ctrl_ready = !m_incomingCtrl.empty() && m_incomingCtrl.top().deliver_at_ms <= now;
+        bool data_ready = !m_incomingData.empty() && m_incomingData.top().deliver_at_ms <= now;
+        if (!ctrl_ready && !data_ready) {
+            break;
+        }
+
+        bool take_ctrl = ctrl_ready;
+        if (ctrl_ready && data_ready) {
+            take_ctrl = true;
+        }
+
+        if (take_ctrl) {
+            ready.push_back(m_incomingCtrl.top());
+            m_incomingCtrl.pop();
+        } else {
+            ready.push_back(m_incomingData.top());
+            m_incomingData.pop();
+        }
+    }
+    return ready;
+}
diff --git a/src/dynamic-net/dn_network_module.h b/src/dynamic-net/dn_network_module.h
new file mode 100644
index 0000000..b805147
--- /dev/null
+++ b/src/dynamic-net/dn_network_module.h
@@ -0,0 +1,90 @@
+//
+// Virtual network module: queued send/receive + predictive epoch rewrite.
+//
+
+#ifndef DYNAMIC_NET_DN_NETWORK_MODULE_H
+#define DYNAMIC_NET_DN_NETWORK_MODULE_H
+
+#include "dn_config.h"
+#include "dn_traffic_shaper.h"
+#include "dn_types.h"
+
+#include <deque>
+#include <functional>
+#include <map>
+#include <mutex>
+#include <queue>
+#include <vector>
+
+struct DnOutgoingPacket {
+    long long release_time_ms;
+    DnNetworkPacket packet;
+    int target_node_id;
+    bool is_reply;
+};
+
+struct DnIncomingPacket {
+    long long deliver_at_ms;
+    DnNetworkPacket packet;
+    int from_node_id;
+    bool is_high_priority;
+};
+
+using DnNowMsFn = std::function<long long()>;
+using DnPacketSizeFn = std::function<size_t(const DnNetworkPacket &)>;
+
+class DnNetworkModule {
+public:
+    DnNetworkModule(int node_id, DnTrafficShaper *shaper, const DnNetworkConfig *config);
+
+    void SetClock(DnNowMsFn now_fn);
+    void SetPacketSizeFn(DnPacketSizeFn size_fn);
+
+    void SendMessage(const DnNetworkPacket &pkt, int target_node_id, bool is_reply = false);
+    std::vector<DnOutgoingPacket> PopReadyOutgoingPackets();
+
+    /*
+     * CATCHUP: rewrite pending data packets' epoch fields in-place.
+     * Returns map<log_index, new_epoch> for local log synchronization.
+     */
+    std::map<int32_t, int32_t> PredictiveEpochRewrite(int32_t base_epoch);
+
+    size_t GetTxQueueSize() const;
+    size_t GetRxQueueSize() const;
+    long long GetDroppedTx() const;
+    long long GetDroppedRx() const;
+
+    void EnqueueIncoming(const DnNetworkPacket &pkt, int from_node_id, size_t raw_size_bytes,
+                         long long arrival_at_nic_ms);
+    std::vector<DnIncomingPacket> PopReadyIncomingPackets();
+
+private:
+    bool IsHighPriority(const DnNetworkPacket &pkt) const;
+    bool IsDroppable(const DnNetworkPacket &pkt) const;
+    long long NowMs() const;
+    size_t PacketSize(const DnNetworkPacket &pkt) const;
+
+    int m_nodeId;
+    DnTrafficShaper *m_shaper;
+    const DnNetworkConfig *m_config;
+    DnNowMsFn m_nowFn;
+    DnPacketSizeFn m_sizeFn;
+
+    mutable std::mutex m_mutex;
+    std::deque<DnOutgoingPacket> m_dataQueue;
+    std::deque<DnOutgoingPacket> m_controlQueue;
+
+    struct IncomingCmp {
+        bool operator()(const DnIncomingPacket &a, const DnIncomingPacket &b) const
+        {
+            return a.deliver_at_ms > b.deliver_at_ms;
+        }
+    };
+    std::priority_queue<DnIncomingPacket, std::vector<DnIncomingPacket>, IncomingCmp> m_incomingCtrl;
+    std::priority_queue<DnIncomingPacket, std::vector<DnIncomingPacket>, IncomingCmp> m_incomingData;
+
+    long long m_droppedTx;
+    long long m_droppedRx;
+};
+
+#endif /* DYNAMIC_NET_DN_NETWORK_MODULE_H */
diff --git a/src/dynamic-net/dn_partial_epoch_state.cpp b/src/dynamic-net/dn_partial_epoch_state.cpp
new file mode 100644
index 0000000..57b4536
--- /dev/null
+++ b/src/dynamic-net/dn_partial_epoch_state.cpp
@@ -0,0 +1,190 @@
+#include "dn_partial_epoch_state.h"
+#include "dn_config.h"
+#include "dn_hash.h"
+
+DnPartialEpochRegistry::DnPartialEpochRegistry(const DnNetworkConfig *config) : m_config(config)
+{
+    if (m_config != nullptr) {
+        for (int i = 0; i < m_config->node_count; ++i) {
+            if (DnIsFastNode(*m_config, i)) {
+                m_fastNodeIds.push_back(i);
+            }
+        }
+    }
+}
+
+void DnPartialEpochRegistry::Configure(const DnNetworkConfig *config)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_config = config;
+    m_fastNodeIds.clear();
+    if (m_config != nullptr) {
+        for (int i = 0; i < m_config->node_count; ++i) {
+            if (DnIsFastNode(*m_config, i)) {
+                m_fastNodeIds.push_back(i);
+            }
+        }
+    }
+}
+
+void DnPartialEpochRegistry::RecordFastNodeEntry(int32_t epoch, int32_t channel_id, const DnRaftEntry &entry)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    DnPartialEpochState &pes = m_epochs[epoch];
+    pes.epoch = epoch;
+    pes.fast_node_entries[channel_id] = entry;
+}
+
+void DnPartialEpochRegistry::AppendFastNodeEntry(int32_t epoch, int32_t channel_id,
+                                                 const DnRaftEntry &entry)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    DnPartialEpochState &pes = m_epochs[epoch];
+    pes.epoch = epoch;
+    DnRaftEntry &slot = pes.fast_node_entries[channel_id];
+    if (slot.txns.empty()) {
+        slot = entry;
+        slot.epoch = epoch;
+        return;
+    }
+    slot.epoch = epoch;
+    slot.type = DnEntryType::WRITE;
+    for (const auto &txn : entry.txns) {
+        slot.txns.push_back(txn);
+    }
+}
+
+bool DnPartialEpochRegistry::TryFastPathMerge(int32_t epoch, DnPartialEpochState *out_state)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto it = m_epochs.find(epoch);
+    if (it == m_epochs.end()) {
+        return false;
+    }
+    DnPartialEpochState &pes = it->second;
+    if (pes.fast_consensus_done) {
+        if (out_state != nullptr) {
+            *out_state = pes;
+        }
+        return true;
+    }
+
+    if (pes.fast_node_entries.size() < m_fastNodeIds.size()) {
+        return false;
+    }
+
+    DnCrdtMergeResult merged = m_merger.MergeFastNodeEntries(epoch, m_fastNodeIds, pes.fast_node_entries);
+    pes.merged_txns = std::move(merged.merged_txns);
+    pes.dropped_hashes = std::move(merged.dropped_hashes_by_node);
+    pes.fast_node_entries = std::move(merged.filtered_entries);
+    pes.merged_hash = DnHashMergedTxns(pes.merged_txns);
+    pes.fast_consensus_done = true;
+
+    DnFastHashTracker &tracker = m_hashTrackers[epoch];
+    tracker.epoch = epoch;
+    if (m_config != nullptr) {
+        tracker.node_hashes[m_config->local_node_id] = pes.merged_hash;
+    }
+
+    if (out_state != nullptr) {
+        *out_state = pes;
+    }
+    return true;
+}
+
+bool DnPartialEpochRegistry::ShouldSendProxy(int32_t epoch, int32_t local_node_id) const
+{
+    if (m_config == nullptr || !m_config->enable_proxy) {
+        return false;
+    }
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto it = m_epochs.find(epoch);
+    if (it == m_epochs.end() || !it->second.fast_consensus_done || it->second.proxy_sent) {
+        return false;
+    }
+    return DnGetAggregatorId(epoch, m_config->node_count) == local_node_id;
+}
+
+void DnPartialEpochRegistry::MarkProxySent(int32_t epoch)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_epochs[epoch].proxy_sent = true;
+}
+
+DnPartialEpochState *DnPartialEpochRegistry::GetState(int32_t epoch)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto it = m_epochs.find(epoch);
+    if (it == m_epochs.end()) {
+        return nullptr;
+    }
+    return &it->second;
+}
+
+const DnPartialEpochState *DnPartialEpochRegistry::GetState(int32_t epoch) const
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto it = m_epochs.find(epoch);
+    if (it == m_epochs.end()) {
+        return nullptr;
+    }
+    return &it->second;
+}
+
+void DnPartialEpochRegistry::RecordFastHash(int32_t epoch, int32_t node_id, uint64_t hash, int majority)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    DnFastHashTracker &tracker = m_hashTrackers[epoch];
+    tracker.epoch = epoch;
+    tracker.node_hashes[node_id] = hash;
+
+    std::unordered_map<uint64_t, int> counts;
+    for (const auto &kv : tracker.node_hashes) {
+        counts[kv.second]++;
+    }
+    for (const auto &kv : counts) {
+        if (kv.second >= majority) {
+            tracker.quorum_reached = true;
+            break;
+        }
+    }
+}
+
+bool DnPartialEpochRegistry::IsHashQuorumReached(int32_t epoch) const
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto it = m_hashTrackers.find(epoch);
+    if (it == m_hashTrackers.end()) {
+        return false;
+    }
+    return it->second.quorum_reached;
+}
+
+void DnPartialEpochRegistry::GcBeforeEpoch(int32_t epoch)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto it = m_epochs.begin();
+    while (it != m_epochs.end()) {
+        if (it->first < epoch) {
+            it = m_epochs.erase(it);
+        } else {
+            ++it;
+        }
+    }
+    auto hit = m_hashTrackers.begin();
+    while (hit != m_hashTrackers.end()) {
+        if (hit->first < epoch) {
+            hit = m_hashTrackers.erase(hit);
+        } else {
+            ++hit;
+        }
+    }
+}
+
+int DnGetAggregatorId(int32_t epoch, int node_count)
+{
+    if (node_count <= 0) {
+        return 0;
+    }
+    return epoch % node_count;
+}
