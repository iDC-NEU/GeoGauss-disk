+#include "epoch/e_statistician.h"
+
+#include "miscadmin.h"
+#include "knl/knl_variable.h"
+
+#include <cstdio>
+#include <ctime>
+#include <unordered_map>
+#include <unordered_set>
+
+static std::unordered_set<uint64_t> g_trace_peer_recv_logged;
+static std::unordered_set<uint64_t> g_trace_merge_logged;
+static std::unordered_set<uint64_t> g_trace_apply_logged;
+static std::unordered_map<uint64_t, int> g_trace_seal_block_tick;
+
+static bool EpochTraceEnabled(void)
+{
+    return EPOCH_SYNC_TRACE_ENABLED && g_enable_epoch_multimaster && EpochGetTotalNodes() > 1;
+}
+
+static void EpochTraceAppendLine(const char* line)
+{
+    if (line == nullptr) {
+        return;
+    }
+    char path[MAXPGPATH];
+    if (!EpochFormatLogPath(path, sizeof(path), "epoch_sync_trace")) {
+        return;
+    }
+
+    FILE* fp = fopen(path, "a");
+    if (fp == nullptr) {
+        return;
+    }
+
+    time_t now = time(nullptr);
+    struct tm tm_buf;
+    (void)localtime_r(&now, &tm_buf);
+    char ts[32];
+    (void)strftime(ts, sizeof(ts), "%Y-%m-%d %H:%M:%S", &tm_buf);
+
+    fprintf(fp, "[%s] node=%u %s\n", ts, EpochGetNodeId(), line);
+    (void)fclose(fp);
+}
+
+static uint64_t EpochTracePeerReceivedTotal(uint64_t epoch)
+{
+    uint32_t self = EpochGetNodeId();
+    uint64_t total = 0;
+    for (uint32_t n = 0; n < EpochGetTotalNodes(); ++n) {
+        if (n == self) {
+            continue;
+        }
+        total += E_NodeManager::GetStoreReceivedPackCounters(epoch, n);
+    }
+    return total;
+}
+
+static uint64_t EpochTraceLocalPackTotal(uint64_t epoch)
+{
+    return E_NodeManager::GetLocalPackTxnCounters(epoch, EpochGetNodeId());
+}
+
+static bool EpochTraceEpochIsIdle(uint64_t epoch)
+{
+    return EpochTraceLocalPackTotal(epoch) == 0 && EpochTracePeerReceivedTotal(epoch) == 0 &&
+           E_NodeManager::GetChangeSetTxnCounters(epoch, EpochGetNodeId()) == 0;
+}
+
+void EpochTraceMaybeLogSealBlocked(uint64_t epoch, const char* reason, uint64_t executing,
+    uint64_t change_set, uint64_t packed)
+{
+    if (!EpochTraceEnabled() || reason == nullptr) {
+        return;
+    }
+    int& tick = g_trace_seal_block_tick[epoch];
+    if (++tick % 200 != 1) {
+        return;
+    }
+    char buf[256];
+    int rc = snprintf_s(buf, sizeof(buf), sizeof(buf) - 1,
+                        "SEAL_BLOCK epoch=%lu reason=%s executing=%lu change_set=%lu pack=%lu",
+                        epoch, reason, executing, change_set, packed);
+    securec_check_ss(rc, "\0", "\0");
+    EpochTraceAppendLine(buf);
+}
+
+void EpochTraceLogSealPrepare(uint64_t epoch, uint64_t txn_total)
+{
+    if (!EpochTraceEnabled()) {
+        return;
+    }
+    if (txn_total == 0 && EpochTraceEpochIsIdle(epoch)) {
+        return;
+    }
+    uint64_t change_set = E_NodeManager::GetChangeSetTxnCounters(epoch, EpochGetNodeId());
+    uint64_t executing = E_NodeManager::GetExecutingTxnCounters(epoch, EpochGetNodeId());
+    char buf[224];
+    int rc = snprintf_s(buf, sizeof(buf), sizeof(buf) - 1,
+                        "SEAL epoch=%lu 执行的事务总数 pack=%lu change_set=%lu executing=%lu，准备打包发送给 peer 节点",
+                        epoch, txn_total, change_set, executing);
+    securec_check_ss(rc, "\0", "\0");
+    EpochTraceAppendLine(buf);
+}
+
+void EpochTraceMaybeLogPeerReceived(uint64_t epoch)
+{
+    if (!EpochTraceEnabled()) {
+        return;
+    }
+    if (!EpochIsAllPeersReceiveCompleted(epoch)) {
+        return;
+    }
+    if (g_trace_peer_recv_logged.find(epoch) != g_trace_peer_recv_logged.end()) {
+        return;
+    }
+    g_trace_peer_recv_logged.insert(epoch);
+
+    uint64_t total = EpochTracePeerReceivedTotal(epoch);
+    if (total == 0 || EpochTraceEpochIsIdle(epoch)) {
+        return;
+    }
+    char buf[128];
+    int rc = snprintf_s(buf, sizeof(buf), sizeof(buf) - 1,
+                        "RECV epoch=%lu 收到了来自其他 node 的事务总数为 %lu",
+                        epoch, total);
+    securec_check_ss(rc, "\0", "\0");
+    EpochTraceAppendLine(buf);
+}
+
+void EpochTraceMaybeLogMergeSummary(uint64_t epoch, uint64_t need_merge, uint64_t merged_success)
+{
+    if (!EpochTraceEnabled()) {
+        return;
+    }
+    if (g_trace_merge_logged.find(epoch) != g_trace_merge_logged.end()) {
+        return;
+    }
+    g_trace_merge_logged.insert(epoch);
+
+    if ((need_merge == 0 && merged_success == 0) || EpochTraceEpochIsIdle(epoch)) {
+        return;
+    }
+    char buf[192];
+    int rc = snprintf_s(buf, sizeof(buf), sizeof(buf) - 1,
+                        "MERGE epoch=%lu 一共有 %lu 事务的写集需要 merge，最后成功 merge 的总数为 %lu",
+                        epoch, need_merge, merged_success);
+    securec_check_ss(rc, "\0", "\0");
+    EpochTraceAppendLine(buf);
+}
+
+void EpochTraceLogApplyDone(uint64_t epoch, uint64_t applied_count)
+{
+    if (!EpochTraceEnabled()) {
+        return;
+    }
+    if (g_trace_apply_logged.find(epoch) != g_trace_apply_logged.end()) {
+        return;
+    }
+    g_trace_apply_logged.insert(epoch);
+
+    if (applied_count == 0 || EpochTraceEpochIsIdle(epoch)) {
+        return;
+    }
+    char buf[128];
+    int rc = snprintf_s(buf, sizeof(buf), sizeof(buf) - 1,
+                        "APPLY epoch=%lu 最后 apply 了 %lu 个事务写集",
+                        epoch, applied_count);
+    securec_check_ss(rc, "\0", "\0");
+    EpochTraceAppendLine(buf);
+}
diff --git a/src/epoch/e_txn_queue.cpp b/src/epoch/e_txn_queue.cpp
new file mode 100644
index 0000000..3d18cd9
--- /dev/null
+++ b/src/epoch/e_txn_queue.cpp
@@ -0,0 +1,119 @@
+#include "postgres.h"
+
+#include "epoch/e_txn_queue.h"
+#include "epoch/e_config.h"
+#include "epoch/e_txn_wire.h"
+
+#include "storage/ipc.h"
+#include "storage/shmem.h"
+
+struct EpochTxnQueueSlot {
+    uint32_t len;
+    char data[EPOCH_MAX_WIRE_TXN_BYTES];
+};
+
+struct EpochTxnQueue {
+    EpochTxnQueueHeader header;
+    EpochTxnQueueSlot slots[1]; /* flexible array via shmem sizing */
+};
+
+static EpochTxnQueue* g_epochTxnQueue = nullptr;
+static uint32_t g_epochTxnQueueCapacity = 4096;
+
+Size EpochTxnQueueShmemSize(uint32_t capacity)
+{
+    if (capacity == 0) {
+        capacity = 4096;
+    }
+    return offsetof(EpochTxnQueue, slots) + sizeof(EpochTxnQueueSlot) * capacity;
+}
+
+static void EpochTxnQueueInitHeader(uint32_t capacity)
+{
+    g_epochTxnQueue->header.capacity = capacity;
+    g_epochTxnQueue->header.head = 0;
+    g_epochTxnQueue->header.tail = 0;
+    g_epochTxnQueue->header.count = 0;
+    g_epochTxnQueue->header.lock = LWLockAssign(LWTRANCHE_WAL_INSERT);
+}
+
+void EpochTxnQueueShmemInit(uint32_t capacity)
+{
+    if (capacity == 0) {
+        capacity = 4096;
+    }
+    g_epochTxnQueueCapacity = capacity;
+    bool found = false;
+    g_epochTxnQueue = static_cast<EpochTxnQueue*>(
+        ShmemInitStruct("Epoch Txn Queue", EpochTxnQueueShmemSize(capacity), &found));
+    if (g_epochTxnQueue == nullptr) {
+        return;
+    }
+    if (!found) {
+        EpochTxnQueueInitHeader(capacity);
+    } else if (g_epochTxnQueue->header.lock == nullptr) {
+        /* epoch worker 线程 reattach 时 found=true 但 lock 未初始化 */
+        if (g_epochTxnQueue->header.capacity == 0) {
+            EpochTxnQueueInitHeader(capacity);
+        } else {
+            g_epochTxnQueue->header.lock = LWLockAssign(LWTRANCHE_WAL_INSERT);
+        }
+    }
+}
+
+bool EpochTxnQueuePush(const char* data, uint32_t len)
+{
+    if (g_epochTxnQueue == nullptr || g_epochTxnQueue->header.lock == nullptr || data == nullptr || len == 0 ||
+        len > EPOCH_MAX_WIRE_TXN_BYTES) {
+        return false;
+    }
+    LWLockAcquire(g_epochTxnQueue->header.lock, LW_EXCLUSIVE);
+    if (g_epochTxnQueue->header.count >= g_epochTxnQueue->header.capacity) {
+        LWLockRelease(g_epochTxnQueue->header.lock);
+        return false;
+    }
+    EpochTxnQueueSlot& slot = g_epochTxnQueue->slots[g_epochTxnQueue->header.tail];
+    slot.len = len;
+    errno_t rc = memcpy_s(slot.data, sizeof(slot.data), data, len);
+    securec_check(rc, "\0", "\0");
+    g_epochTxnQueue->header.tail = (g_epochTxnQueue->header.tail + 1) % g_epochTxnQueue->header.capacity;
+    g_epochTxnQueue->header.count++;
+    LWLockRelease(g_epochTxnQueue->header.lock);
+    return true;
+}
+
+bool EpochTxnQueuePop(char* data, uint32_t max_len, uint32_t* out_len)
+{
+    if (g_epochTxnQueue == nullptr || g_epochTxnQueue->header.lock == nullptr || data == nullptr ||
+        out_len == nullptr) {
+        return false;
+    }
+    LWLockAcquire(g_epochTxnQueue->header.lock, LW_EXCLUSIVE);
+    if (g_epochTxnQueue->header.count == 0) {
+        LWLockRelease(g_epochTxnQueue->header.lock);
+        return false;
+    }
+    EpochTxnQueueSlot& slot = g_epochTxnQueue->slots[g_epochTxnQueue->header.head];
+    if (slot.len > max_len) {
+        LWLockRelease(g_epochTxnQueue->header.lock);
+        return false;
+    }
+    errno_t rc = memcpy_s(data, max_len, slot.data, slot.len);
+    securec_check(rc, "\0", "\0");
+    *out_len = slot.len;
+    g_epochTxnQueue->header.head = (g_epochTxnQueue->header.head + 1) % g_epochTxnQueue->header.capacity;
+    g_epochTxnQueue->header.count--;
+    LWLockRelease(g_epochTxnQueue->header.lock);
+    return true;
+}
+
+uint32_t EpochTxnQueueCount(void)
+{
+    if (g_epochTxnQueue == nullptr) {
+        return 0;
+    }
+    LWLockAcquire(g_epochTxnQueue->header.lock, LW_SHARED);
+    uint32_t count = g_epochTxnQueue->header.count;
+    LWLockRelease(g_epochTxnQueue->header.lock);
+    return count;
+}
diff --git a/src/epoch/e_txn_wire.cpp b/src/epoch/e_txn_wire.cpp
new file mode 100644
index 0000000..8e481de
--- /dev/null
+++ b/src/epoch/e_txn_wire.cpp
@@ -0,0 +1,146 @@
+#include "postgres.h"
+
+#include "epoch/e_txn_wire.h"
+
+#include <cstring>
+
+static void AppendU16(std::string* out, uint16_t v)
+{
+    out->append(reinterpret_cast<const char*>(&v), sizeof(v));
+}
+
+static void AppendU32(std::string* out, uint32_t v)
+{
+    out->append(reinterpret_cast<const char*>(&v), sizeof(v));
+}
+
+static void AppendU64(std::string* out, uint64_t v)
+{
+    out->append(reinterpret_cast<const char*>(&v), sizeof(v));
+}
+
+static bool ReadU32(const char*& p, const char* end, uint32_t* v)
+{
+    if (p + sizeof(uint32_t) > end) {
+        return false;
+    }
+    memcpy(v, p, sizeof(uint32_t));
+    p += sizeof(uint32_t);
+    return true;
+}
+
+static bool ReadU64(const char*& p, const char* end, uint64_t* v)
+{
+    if (p + sizeof(uint64_t) > end) {
+        return false;
+    }
+    memcpy(v, p, sizeof(uint64_t));
+    p += sizeof(uint64_t);
+    return true;
+}
+
+bool E_WireSerializeTxn(const E_WireTxn& txn, std::string* out)
+{
+    if (out == nullptr) {
+        return false;
+    }
+    out->clear();
+    AppendU64(out, EPOCH_WIRE_MAGIC);
+    AppendU32(out, EPOCH_WIRE_VERSION);
+    AppendU64(out, txn.csn);
+    AppendU64(out, txn.start_epoch);
+    AppendU64(out, txn.commit_epoch);
+    AppendU32(out, txn.server_id);
+    AppendU32(out, static_cast<uint32_t>(txn.txn_state));
+    AppendU32(out, static_cast<uint32_t>(txn.rows.size()));
+
+    for (const auto& row : txn.rows) {
+        AppendU32(out, static_cast<uint32_t>(row.op_type));
+        AppendU32(out, row.relid);
+        AppendU16(out, row.bi_hi);
+        AppendU16(out, row.bi_lo);
+        AppendU16(out, row.ip_posid);
+        AppendU32(out, static_cast<uint32_t>(row.tuple_data.size()));
+        if (!row.tuple_data.empty()) {
+            out->append(row.tuple_data.data(), row.tuple_data.size());
+        }
+        AppendU32(out, static_cast<uint32_t>(row.relname.size()));
+        if (!row.relname.empty()) {
+            out->append(row.relname.data(), row.relname.size());
+        }
+    }
+    return out->size() <= EPOCH_MAX_WIRE_TXN_BYTES;
+}
+
+static bool ReadU16(const char*& p, const char* end, uint16_t* v)
+{
+    if (p + sizeof(uint16_t) > end) {
+        return false;
+    }
+    memcpy(v, p, sizeof(uint16_t));
+    p += sizeof(uint16_t);
+    return true;
+}
+
+bool E_WireDeserializeTxn(const char* data, size_t len, E_WireTxn* out)
+{
+    if (data == nullptr || out == nullptr || len < sizeof(uint64_t)) {
+        return false;
+    }
+    const char* p = data;
+    const char* end = data + len;
+    uint64_t magic = 0;
+    uint32_t version = 0;
+    uint32_t row_count = 0;
+
+    if (!ReadU64(p, end, &magic) || magic != EPOCH_WIRE_MAGIC) {
+        return false;
+    }
+    if (!ReadU32(p, end, &version) || (version != EPOCH_WIRE_VERSION && version != 1)) {
+        return false;
+    }
+    if (!ReadU64(p, end, &out->csn) || !ReadU64(p, end, &out->start_epoch) ||
+        !ReadU64(p, end, &out->commit_epoch)) {
+        return false;
+    }
+    if (!ReadU32(p, end, &out->server_id)) {
+        return false;
+    }
+    uint32_t state = 0;
+    if (!ReadU32(p, end, &state) || !ReadU32(p, end, &row_count)) {
+        return false;
+    }
+    out->txn_state = static_cast<EpochTxnState>(state);
+    out->rows.clear();
+    out->rows.reserve(row_count);
+
+    for (uint32_t i = 0; i < row_count; ++i) {
+        E_WireRow row;
+        uint32_t op = 0;
+        uint32_t tuple_len = 0;
+        if (!ReadU32(p, end, &op) || !ReadU32(p, end, &row.relid) || !ReadU16(p, end, &row.bi_hi) ||
+            !ReadU16(p, end, &row.bi_lo) || !ReadU16(p, end, &row.ip_posid) || !ReadU32(p, end, &tuple_len)) {
+            return false;
+        }
+        row.op_type = static_cast<EpochOpType>(op);
+        if (p + tuple_len > end) {
+            return false;
+        }
+        if (tuple_len > 0) {
+            row.tuple_data.assign(p, p + tuple_len);
+            p += tuple_len;
+        }
+        if (version >= 2) {
+            uint32_t name_len = 0;
+            if (!ReadU32(p, end, &name_len) || p + name_len > end) {
+                return false;
+            }
+            if (name_len > 0) {
+                row.relname.assign(p, p + name_len);
+                p += name_len;
+            }
+        }
+        out->rows.push_back(std::move(row));
+    }
+    return true;
+}
diff --git a/src/epoch/e_wire_envelope.cpp b/src/epoch/e_wire_envelope.cpp
new file mode 100644
index 0000000..06b5967
--- /dev/null
+++ b/src/epoch/e_wire_envelope.cpp
@@ -0,0 +1,293 @@
+#include "postgres.h"
+
+#include "epoch/e_wire_envelope.h"
+
+#include <cstring>
+
+static void AppendU32(std::string* out, uint32_t v)
+{
+    out->append(reinterpret_cast<const char*>(&v), sizeof(v));
+}
+
+static void AppendU64(std::string* out, uint64_t v)
+{
+    out->append(reinterpret_cast<const char*>(&v), sizeof(v));
+}
+
+static void AppendI32(std::string* out, int32_t v)
+{
+    out->append(reinterpret_cast<const char*>(&v), sizeof(v));
+}
+
+static void AppendStr(std::string* out, const std::string& s)
+{
+    AppendU32(out, static_cast<uint32_t>(s.size()));
+    if (!s.empty()) {
+        out->append(s.data(), s.size());
+    }
+}
+
+static bool ReadU32(const char*& p, const char* end, uint32_t* v)
+{
+    if (p + sizeof(uint32_t) > end) {
+        return false;
+    }
+    memcpy(v, p, sizeof(uint32_t));
+    p += sizeof(uint32_t);
+    return true;
+}
+
+static bool ReadU64(const char*& p, const char* end, uint64_t* v)
+{
+    if (p + sizeof(uint64_t) > end) {
+        return false;
+    }
+    memcpy(v, p, sizeof(uint64_t));
+    p += sizeof(uint64_t);
+    return true;
+}
+
+static bool ReadI32(const char*& p, const char* end, int32_t* v)
+{
+    if (p + sizeof(int32_t) > end) {
+        return false;
+    }
+    memcpy(v, p, sizeof(int32_t));
+    p += sizeof(int32_t);
+    return true;
+}
+
+static bool ReadStr(const char*& p, const char* end, std::string* out)
+{
+    uint32_t len = 0;
+    if (!ReadU32(p, end, &len)) {
+        return false;
+    }
+    if (p + len > end) {
+        return false;
+    }
+    out->assign(p, len);
+    p += len;
+    return true;
+}
+
+static bool ReadEnvelopeHeader(const char* data, size_t len, EpochWireEnvelopeKind* kind)
+{
+    if (data == nullptr || len < sizeof(uint64_t) + sizeof(uint32_t) * 2 || kind == nullptr) {
+        return false;
+    }
+    const char* p = data;
+    const char* end = data + len;
+    uint64_t magic = 0;
+    uint32_t version = 0;
+    uint32_t k = 0;
+    if (!ReadU64(p, end, &magic) || magic != EPOCH_WIRE_ENVELOPE_MAGIC) {
+        return false;
+    }
+    if (!ReadU32(p, end, &version) || version != EPOCH_WIRE_ENVELOPE_VERSION) {
+        return false;
+    }
+    if (!ReadU32(p, end, &k)) {
+        return false;
+    }
+    *kind = static_cast<EpochWireEnvelopeKind>(k);
+    return true;
+}
+
+bool EpochWireIsEnvelope(const char* data, size_t len)
+{
+    if (data == nullptr || len < sizeof(uint64_t)) {
+        return false;
+    }
+    uint64_t magic = 0;
+    memcpy(&magic, data, sizeof(magic));
+    return magic == EPOCH_WIRE_ENVELOPE_MAGIC;
+}
+
+bool EpochWireSerializeMetadata(const E_WireTxn& txn, uint64_t payload_hash, int32_t payload_size,
+                                std::string* out)
+{
+    if (out == nullptr) {
+        return false;
+    }
+    out->clear();
+    AppendU64(out, EPOCH_WIRE_ENVELOPE_MAGIC);
+    AppendU32(out, EPOCH_WIRE_ENVELOPE_VERSION);
+    AppendU32(out, static_cast<uint32_t>(EPOCH_WIRE_ENV_TXN_METADATA));
+    AppendU64(out, txn.csn);
+    AppendU64(out, txn.start_epoch);
+    AppendU64(out, txn.commit_epoch);
+    AppendU32(out, txn.server_id);
+    AppendU64(out, payload_hash);
+    AppendI32(out, payload_size);
+    return true;
+}
+
+bool EpochWireParseMetadata(const char* data, size_t len, EpochWireMetadata* out)
+{
+    if (out == nullptr) {
+        return false;
+    }
+    EpochWireEnvelopeKind kind = EPOCH_WIRE_ENV_TXN_METADATA;
+    if (!ReadEnvelopeHeader(data, len, &kind) || kind != EPOCH_WIRE_ENV_TXN_METADATA) {
+        return false;
+    }
+    const char* p = data + sizeof(uint64_t) + sizeof(uint32_t) * 2;
+    const char* end = data + len;
+    if (!ReadU64(p, end, &out->csn) || !ReadU64(p, end, &out->start_epoch) ||
+        !ReadU64(p, end, &out->commit_epoch) || !ReadU32(p, end, &out->server_id) ||
+        !ReadU64(p, end, &out->payload_hash) || !ReadI32(p, end, &out->payload_size)) {
+        return false;
+    }
+    return true;
+}
+
+static bool SerializeDnRow(const DnRow& row, std::string* out)
+{
+    AppendStr(out, row.key);
+    AppendStr(out, row.value);
+    uint8_t del = row.is_delete ? 1 : 0;
+    out->append(reinterpret_cast<const char*>(&del), sizeof(del));
+    return true;
+}
+
+static bool ParseDnRow(const char*& p, const char* end, DnRow* row)
+{
+    if (row == nullptr) {
+        return false;
+    }
+    if (!ReadStr(p, end, &row->key) || !ReadStr(p, end, &row->value)) {
+        return false;
+    }
+    if (p + sizeof(uint8_t) > end) {
+        return false;
+    }
+    row->is_delete = (*p != 0);
+    p += sizeof(uint8_t);
+    return true;
+}
+
+static bool SerializeDnTxn(const DnTransaction& txn, std::string* out)
+{
+    AppendU64(out, txn.client_txn_id);
+    AppendU32(out, txn.origin_node_id);
+    AppendStr(out, txn.client_key);
+    AppendU32(out, static_cast<uint32_t>(txn.rows.size()));
+    for (const auto& row : txn.rows) {
+        if (!SerializeDnRow(row, out)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool ParseDnTxn(const char*& p, const char* end, DnTransaction* txn)
+{
+    if (txn == nullptr) {
+        return false;
+    }
+    if (!ReadU64(p, end, &txn->client_txn_id) || !ReadU32(p, end, &txn->origin_node_id) ||
+        !ReadStr(p, end, &txn->client_key)) {
+        return false;
+    }
+    uint32_t row_count = 0;
+    if (!ReadU32(p, end, &row_count)) {
+        return false;
+    }
+    txn->rows.clear();
+    txn->rows.reserve(row_count);
+    for (uint32_t i = 0; i < row_count; ++i) {
+        DnRow row;
+        if (!ParseDnRow(p, end, &row)) {
+            return false;
+        }
+        txn->rows.push_back(std::move(row));
+    }
+    return true;
+}
+
+bool EpochWireSerializePartialSnapshot(const DnPartialSnapshotMessage& snap, std::string* out)
+{
+    if (out == nullptr) {
+        return false;
+    }
+    out->clear();
+    AppendU64(out, EPOCH_WIRE_ENVELOPE_MAGIC);
+    AppendU32(out, EPOCH_WIRE_ENVELOPE_VERSION);
+    AppendU32(out, static_cast<uint32_t>(EPOCH_WIRE_ENV_PARTIAL_SNAPSHOT));
+    AppendI32(out, snap.epoch);
+    AppendI32(out, snap.proxy_node_id);
+    AppendU64(out, snap.checksum);
+    AppendU32(out, static_cast<uint32_t>(snap.contributions.size()));
+    for (const auto& contrib : snap.contributions) {
+        AppendI32(out, contrib.origin_node_id);
+        AppendU32(out, static_cast<uint32_t>(contrib.committed_txns.size()));
+        for (const auto& txn : contrib.committed_txns) {
+            if (!SerializeDnTxn(txn, out)) {
+                return false;
+            }
+        }
+        AppendU32(out, static_cast<uint32_t>(contrib.dropped_hashes.size()));
+        for (uint64_t h : contrib.dropped_hashes) {
+            AppendU64(out, h);
+        }
+        AppendStr(out, contrib.reconstruction_bitmap);
+    }
+    return out->size() <= EPOCH_MAX_WIRE_TXN_BYTES;
+}
+
+bool EpochWireParsePartialSnapshot(const char* data, size_t len, DnPartialSnapshotMessage* out)
+{
+    if (out == nullptr) {
+        return false;
+    }
+    EpochWireEnvelopeKind kind = EPOCH_WIRE_ENV_PARTIAL_SNAPSHOT;
+    if (!ReadEnvelopeHeader(data, len, &kind) || kind != EPOCH_WIRE_ENV_PARTIAL_SNAPSHOT) {
+        return false;
+    }
+    const char* p = data + sizeof(uint64_t) + sizeof(uint32_t) * 2;
+    const char* end = data + len;
+    if (!ReadI32(p, end, &out->epoch) || !ReadI32(p, end, &out->proxy_node_id) ||
+        !ReadU64(p, end, &out->checksum)) {
+        return false;
+    }
+    uint32_t contrib_count = 0;
+    if (!ReadU32(p, end, &contrib_count)) {
+        return false;
+    }
+    out->contributions.clear();
+    out->contributions.reserve(contrib_count);
+    for (uint32_t ci = 0; ci < contrib_count; ++ci) {
+        DnNodeContribution contrib;
+        if (!ReadI32(p, end, &contrib.origin_node_id)) {
+            return false;
+        }
+        uint32_t txn_count = 0;
+        if (!ReadU32(p, end, &txn_count)) {
+            return false;
+        }
+        for (uint32_t ti = 0; ti < txn_count; ++ti) {
+            DnTransaction txn;
+            if (!ParseDnTxn(p, end, &txn)) {
+                return false;
+            }
+            contrib.committed_txns.push_back(std::move(txn));
+        }
+        uint32_t drop_count = 0;
+        if (!ReadU32(p, end, &drop_count)) {
+            return false;
+        }
+        for (uint32_t di = 0; di < drop_count; ++di) {
+            uint64_t h = 0;
+            if (!ReadU64(p, end, &h)) {
+                return false;
+            }
+            contrib.dropped_hashes.push_back(h);
+        }
+        if (!ReadStr(p, end, &contrib.reconstruction_bitmap)) {
+            return false;
+        }
+        out->contributions.push_back(std::move(contrib));
+    }
+    return true;
+}
diff --git a/src/epoch/e_worker_main.cpp b/src/epoch/e_worker_main.cpp
new file mode 100644
index 0000000..da690d0
--- /dev/null
+++ b/src/epoch/e_worker_main.cpp
@@ -0,0 +1,213 @@
+#include "postgres.h"
+#include "knl/knl_variable.h"
+
+#include <signal.h>
+#include <unistd.h>
+
+#include "postmaster/epoch_worker.h"
+#include "epoch/e_apply.h"
+#include "epoch/e_config.h"
+#include "epoch/e_epoch.h"
+#include "epoch/e_dyn_net.h"
+#include "epoch/e_node_manager.h"
+#include "epoch/e_pipeline.h"
+#include "epoch/e_statistician.h"
+#include "epoch/e_perf.h"
+
+#include "libpq/pqsignal.h"
+#include "miscadmin.h"
+#include "pgstat.h"
+#include "storage/ipc.h"
+#include "storage/lock/lwlock.h"
+#include "storage/proc.h"
+#include "utils/guc.h"
+#include "utils/memutils.h"
+#include "utils/postinit.h"
+#include "utils/ps_status.h"
+#include "utils/resowner.h"
+#include "occ/o_staging.h"
+#include "gssignal/gs_signal.h"
+
+static void EpochWorkerQuickDie(SIGNAL_ARGS);
+static void EpochWorkerSigHup(SIGNAL_ARGS);
+static void EpochWorkerShutdown(SIGNAL_ARGS);
+
+/*
+ * GeoGauss: MOT epoch 线程入口 MOT::CreateSessionContext() 绑定 store。
+ * 磁盘表等价路径：logical apply worker（主备逻辑复制）的 InitApplyWorker + replica 角色。
+ * 参见 replication/logical/worker.cpp ApplyWorkerMain()。
+ */
+static void EpochWorkerInitSession(void)
+{
+    const char* dbname = (g_epoch_apply_database != nullptr && g_epoch_apply_database[0] != '\0')
+        ? g_epoch_apply_database
+        : "test";
+    const char* username = (g_epoch_apply_user != nullptr && g_epoch_apply_user[0] != '\0')
+        ? g_epoch_apply_user
+        : "hcj2003";
+    char resolvedDbname[NAMEDATALEN] = {0};
+
+    /* 与 ApplyWorkerMain 相同：以 replica 角色 apply，避免触发本地 trigger */
+    SetConfigOption("session_replication_role", "replica", PGC_SUSET, PGC_S_OVERRIDE);
+    SetConfigOption("search_path", "", PGC_SUSET, PGC_S_OVERRIDE);
+
+    /*
+     * 传库名/用户名而非 OID：InitApplyWorker 内 InitSysCache 完成后才访问 pg_catalog。
+     * 若在 InitApplyWorker 之前调用 get_database_oid，会因 phase2 未初始化触发断言。
+     */
+    t_thrd.proc_cxt.PostInit->SetDatabaseAndUser(dbname, InvalidOid, username, InvalidOid);
+    t_thrd.proc_cxt.PostInit->InitApplyWorker();
+    t_thrd.proc_cxt.PostInit->GetDatabaseName(resolvedDbname);
+
+    MemoryContext oldctx = MemoryContextSwitchTo(SESS_GET_MEM_CXT_GROUP(MEMORY_CONTEXT_STORAGE));
+    if (u_sess->proc_cxt.MyProcPort->database_name != nullptr) {
+        pfree_ext(u_sess->proc_cxt.MyProcPort->database_name);
+    }
+    if (u_sess->proc_cxt.MyProcPort->user_name != nullptr) {
+        pfree_ext(u_sess->proc_cxt.MyProcPort->user_name);
+    }
+    u_sess->proc_cxt.MyProcPort->database_name = pstrdup(resolvedDbname);
+    u_sess->proc_cxt.MyProcPort->user_name = pstrdup(username);
+    (void)MemoryContextSwitchTo(oldctx);
+}
+
+static void EpochWorkerProcessQueue(void)
+{
+    EpochPipelinePoll();
+}
+
+void EpochWorkerMain(void)
+{
+    sigjmp_buf local_sigjmp_buf;
+    MemoryContext worker_context;
+    sigset_t old_sig_mask;
+
+    IsUnderPostmaster = true;
+    t_thrd.role = EPOCHWORKER;
+    t_thrd.proc_cxt.MyProcPid = gs_thread_self();
+    t_thrd.proc_cxt.MyStartTime = time(NULL);
+    t_thrd.proc_cxt.MyProgName = "EpochWorker";
+
+    init_ps_display("epoch worker process", "", "", "");
+    SetProcessingMode(InitProcessing);
+
+    (void)gspqsignal(SIGHUP, EpochWorkerSigHup);
+    (void)gspqsignal(SIGINT, EpochWorkerShutdown);
+    (void)gspqsignal(SIGTERM, EpochWorkerShutdown);
+    (void)gspqsignal(SIGQUIT, EpochWorkerQuickDie);
+    (void)gspqsignal(SIGPIPE, SIG_IGN);
+    (void)gspqsignal(SIGUSR1, SIG_IGN);
+    (void)gspqsignal(SIGUSR2, SIG_IGN);
+    (void)gspqsignal(SIGCHLD, SIG_DFL);
+
+    sigdelset(&t_thrd.libpq_cxt.BlockSig, SIGQUIT);
+
+    BaseInit();
+#ifndef EXEC_BACKEND
+    InitProcess();
+#endif
+
+    gs_signal_setmask(&t_thrd.libpq_cxt.UnBlockSig, NULL);
+    (void)gs_signal_unblock_sigusr2();
+
+    if (!t_thrd.mem_cxt.mask_password_mem_cxt) {
+        t_thrd.mem_cxt.mask_password_mem_cxt = AllocSetContextCreate(t_thrd.top_mem_cxt,
+            "MaskPasswordCtx",
+            ALLOCSET_DEFAULT_MINSIZE,
+            ALLOCSET_DEFAULT_INITSIZE,
+            ALLOCSET_DEFAULT_MAXSIZE);
+    }
+
+    worker_context = AllocSetContextCreate(t_thrd.top_mem_cxt,
+                                           "epoch worker",
+                                           ALLOCSET_DEFAULT_MINSIZE,
+                                           ALLOCSET_DEFAULT_INITSIZE,
+                                           ALLOCSET_DEFAULT_MAXSIZE);
+    (void)MemoryContextSwitchTo(worker_context);
+
+    if (sigsetjmp(local_sigjmp_buf, 1) != 0) {
+        pthread_sigmask(SIG_SETMASK, &old_sig_mask, NULL);
+        t_thrd.log_cxt.error_context_stack = NULL;
+        HOLD_INTERRUPTS();
+        EmitErrorReport();
+        FlushErrorState();
+        AbortOutOfAnyTransaction();
+        LWLockReleaseAll();
+        pgstat_report_waitevent(WAIT_EVENT_END);
+        AbortBufferIO();
+        UnlockBuffers();
+        if (t_thrd.utils_cxt.CurrentResourceOwner != nullptr) {
+            ResourceOwnerRelease(t_thrd.utils_cxt.CurrentResourceOwner, RESOURCE_RELEASE_BEFORE_LOCKS, false, true);
+        }
+        AtEOXact_Buffers(false);
+        AtEOXact_SMgr();
+        AtEOXact_Files();
+        AtEOXact_HashTables(false);
+        (void)MemoryContextSwitchTo(worker_context);
+        MemoryContextResetAndDeleteChildren(worker_context);
+        RESUME_INTERRUPTS();
+        pg_usleep(1000000L);
+    }
+
+    t_thrd.log_cxt.PG_exception_stack = &local_sigjmp_buf;
+    SetProcessingMode(NormalProcessing);
+
+    Assert(t_thrd.utils_cxt.CurrentResourceOwner == NULL);
+    t_thrd.utils_cxt.CurrentResourceOwner =
+        ResourceOwnerCreate(NULL, "epoch worker", THREAD_GET_MEM_CXT_GROUP(MEMORY_CONTEXT_STORAGE));
+
+    EpochWorkerInitSession();
+
+    pgstat_report_appname("epoch worker");
+    pgstat_report_activity(STATE_IDLE, NULL);
+
+    EpochPipelineInit();
+    OccStagingEnsureInit();
+    EpochDiagReset();
+    EpochRecvDiagReset();
+    EpochPerfReset();
+
+    int interval_ms = g_epoch_physical_interval_ms > 0 ? g_epoch_physical_interval_ms : 10;
+
+    for (;;) {
+        if (t_thrd.epoch_worker_cxt.got_SIGHUP) {
+            t_thrd.epoch_worker_cxt.got_SIGHUP = false;
+            ProcessConfigFile(PGC_SIGHUP);
+            interval_ms = g_epoch_physical_interval_ms > 0 ? g_epoch_physical_interval_ms : 10;
+        }
+        if (t_thrd.epoch_worker_cxt.shutdown_requested) {
+            EpochPipelineShutdown();
+            proc_exit(0);
+        }
+
+        pgstat_report_activity(STATE_RUNNING, NULL);
+        EpochPerfNoteWorkerPoll();
+        EpochWorkerProcessQueue();
+        /* 每 tick 只推进一个 logical epoch，避免双节点 ZMQ 往返下一边狂飙、另一边 peer_send 永远追不上 */
+        (void)EpochTryAdvanceLogical();
+        EpochDiagMaybeReport();
+        EpochPerfMaybeReport();
+        EpochDynNetMaybeCatchup();
+        OccStagingFlusherTick();
+        EpochAdvancePhysicalOnce();
+        pgstat_report_activity(STATE_IDLE, NULL);
+        pg_usleep(static_cast<long>(interval_ms) * 1000L);
+    }
+}
+
+static void EpochWorkerQuickDie(SIGNAL_ARGS)
+{
+    gs_signal_setmask(&t_thrd.libpq_cxt.BlockSig, NULL);
+    on_exit_reset();
+    _exit(2);
+}
+
+static void EpochWorkerSigHup(SIGNAL_ARGS)
+{
+    t_thrd.epoch_worker_cxt.got_SIGHUP = true;
+}
+
+static void EpochWorkerShutdown(SIGNAL_ARGS)
+{
+    t_thrd.epoch_worker_cxt.shutdown_requested = true;
+}
diff --git a/src/epoch/e_xact.cpp b/src/epoch/e_xact.cpp
new file mode 100644
index 0000000..0702701
--- /dev/null
+++ b/src/epoch/e_xact.cpp
@@ -0,0 +1,869 @@
+#include "postgres.h"
+
+#include "epoch/e_xact.h"
+#include "epoch/e_abort_csn.h"
+#include "epoch/e_config.h"
+#include "epoch/e_epoch.h"
+#include "epoch/e_exec_track.h"
+#include "epoch/e_net.h"
+#include "epoch/e_node_manager.h"
+#include "epoch/e_perf.h"
+#include "epoch/e_shmem.h"
+#include "epoch/e_txn_queue.h"
+#include "epoch/e_txn_wire.h"
+#include "epoch/e_types.h"
+
+#include "occ/o_commit.h"
+#include "occ/o_txn.h"
+#include "occ/occ_internal.h"
+#include "occ/o_csn_manager.h"
+#include "occ/occ_stats.h"
+
+#include "access/xact.h"
+#include "gs_thread.h"
+#include "knl/knl_variable.h"
+#include "knl/knl_thread.h"
+#include "miscadmin.h"
+#include "portability/instr_time.h"
+#include "postmaster/autovacuum.h"
+#include "utils/lsyscache.h"
+#include "utils/rel.h"
+#include "utils/snapmgr.h"
+
+#include <climits>
+#include <cstdint>
+
+static O_CSNManager g_epochCsnManager;
+
+static bool E_TxnHasWriteSet(O_TxnManager* txn)
+{
+    if (txn == nullptr || txn->m_accessMgr == nullptr) {
+        return false;
+    }
+    return txn->m_accessMgr->m_Size() > 0;
+}
+
+static EpochOpType E_MapAccessTypeToWireOp(AccessType type)
+{
+    switch (type) {
+        case INS:
+            return EPOCH_OP_INSERT;
+        case WR:
+            return EPOCH_OP_UPDATE;
+        case DEL:
+            return EPOCH_OP_DELETE;
+        default:
+            return EPOCH_OP_READ;
+    }
+}
+
+static bool E_BuildWireTxn(O_TxnManager* txn, uint64_t csn, E_WireTxn* wire)
+{
+    if (txn == nullptr || wire == nullptr) {
+        return false;
+    }
+    wire->csn = csn;
+    wire->start_epoch = u_sess->epoch_cxt.start_epoch;
+    wire->commit_epoch = u_sess->epoch_cxt.commit_epoch;
+    wire->server_id = EpochGetNodeId();
+    wire->txn_state = EPOCH_TXN_COMMIT;
+    wire->rows.clear();
+
+    txn->m_accessMgr->ForEachWriteEntry([&](const occ_sentinel& sent, O_Access* access) {
+        if (access == nullptr) {
+            return;
+        }
+        AccessType mapped = access->m_type;
+        if (mapped != INS && mapped != WR && mapped != DEL) {
+            return;
+        }
+        HeapTuple row = access->GetTxnRow();
+        if (row == nullptr || row->t_data == nullptr) {
+            return;
+        }
+        E_WireRow wire_row;
+        wire_row.op_type = E_MapAccessTypeToWireOp(mapped);
+        wire_row.relid = OccResolveRelid(sent);
+        char* relname = get_rel_name(wire_row.relid);
+        if (relname != nullptr) {
+            wire_row.relname = relname;
+        }
+        wire_row.bi_hi = sent.tuple_id.ip_blkid.bi_hi;
+        wire_row.bi_lo = sent.tuple_id.ip_blkid.bi_lo;
+        wire_row.ip_posid = sent.tuple_id.ip_posid;
+        wire_row.tuple_data.resize(row->t_len);
+        errno_t rc = memcpy_s(wire_row.tuple_data.data(), wire_row.tuple_data.size(),
+                              row->t_data, row->t_len);
+        securec_check(rc, "\0", "\0");
+        wire->rows.push_back(std::move(wire_row));
+    });
+    return !wire->rows.empty();
+}
+
+static bool E_ShouldTrackTxnEpoch(void)
+{
+    if (IsAutoVacuumWorkerProcess() || AmEpochWorkerProcess()) {
+        return false;
+    }
+    if (t_thrd.role == EPOCHWORKER) {
+        return false;
+    }
+    /*
+     * 仅普通客户端 backend 连到 epoch 跟踪库时参与 epoch gate / 计数。
+     * openGauss 中 XACT START 触发面很广，此处过滤后再 assign epoch。
+     */
+    if (t_thrd.role != WORKER && t_thrd.role != THREADPOOL_WORKER) {
+        return false;
+    }
+    if (!IsNormalProcessingMode()) {
+        return false;
+    }
+    if (u_sess->proc_cxt.MyProcPort == nullptr || u_sess->proc_cxt.MyProcPort->database_name == nullptr) {
+        return false;
+    }
+    const char* track_db = (g_epoch_apply_database != nullptr && g_epoch_apply_database[0] != '\0')
+        ? g_epoch_apply_database
+        : "test";
+    if (strcmp(u_sess->proc_cxt.MyProcPort->database_name, track_db) != 0) {
+        return false;
+    }
+    return true;
+}
+
+static bool E_AllRequiredPeersConnected(void)
+{
+    uint32_t total = EpochGetTotalNodes();
+    uint32_t self = EpochGetNodeId();
+    for (uint32_t node = 0; node < total; ++node) {
+        if (node == self) {
+            continue;
+        }
+        if (!EpochPeerIsConnected(node)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+/*
+ * 仅当 epoch_commit_sync=on 且所有对端均已连通时才进入 sync 路径。
+ * total_nodes=2 但 node1 未启动时，应按单节点退化，避免无限等待 remote_* 占满连接。
+ */
+static bool E_IsSyncEpochMode(void)
+{
+    return g_epoch_commit_sync && g_enable_epoch_multimaster && EpochGetTotalNodes() > 1 &&
+           E_AllRequiredPeersConnected();
+}
+
+/*
+ * 异步多主：epoch_commit_sync=off，COMMIT 不等待 logical/remote，pack 后立即返回。
+ * replication/merge 由 worker 后台完成；tpmC 更高但提交时无跨节点持久化保证。
+ */
+static bool E_IsAsyncEpochMode(void)
+{
+    return !g_epoch_commit_sync && g_enable_epoch_multimaster && EpochGetTotalNodes() > 1 &&
+           E_AllRequiredPeersConnected();
+}
+
+static bool EpochAsyncGapPressure(void)
+{
+    uint64_t logical = E_NodeManager::GetLogicalEpoch();
+    uint64_t physical = E_NodeManager::GetPhysicalEpoch();
+    uint64_t gap = (physical > logical) ? (physical - logical) : 0;
+    return gap >= EpochGetPhysLogicalGapLimit();
+}
+
+static uint32_t EpochAsyncQueuePressureThreshold(void)
+{
+    return (EPOCH_TXN_QUEUE_CAPACITY * 3) / 4;
+}
+
+static bool EpochAsyncQueuePressure(void)
+{
+    return EpochTxnQueueCount() >= EpochAsyncQueuePressureThreshold();
+}
+
+static void EpochRecordGateWait(EpochPerfGateKind kind, instr_time* start, uint64_t spin_count)
+{
+    if (!EpochPerfIsEnabled() || start == nullptr) {
+        return;
+    }
+    instr_time end;
+    INSTR_TIME_SET_CURRENT(end);
+    INSTR_TIME_SUBTRACT(end, *start);
+    EpochPerfAddGateWait(kind, INSTR_TIME_GET_MICROSEC(end), spin_count);
+}
+
+/* gap 顶满时 cap epoch 硬 pack 配额（COMMIT pack 路径，跨 backend in-flight + 已 pack 计数） */
+static constexpr long EPOCH_ASYNC_PAUSE_US = 200;
+
+static uint64_t EpochAsyncNowMs(void)
+{
+    instr_time now;
+    INSTR_TIME_SET_CURRENT(now);
+    return static_cast<uint64_t>(INSTR_TIME_GET_MICROSEC(now) / 1000);
+}
+
+static uint64_t EpochAsyncCapEpoch(void)
+{
+    uint64_t logical = E_NodeManager::GetLogicalEpoch();
+    return logical + EpochGetPhysLogicalGapLimit();
+}
+
+/* cap 上尚未 seal 的 pack 数；seal 后不计入 gate 压力 */
+static uint64_t EpochAsyncCapUnsealedBacklog(uint64_t cap)
+{
+    uint32_t node_id = EpochGetNodeId();
+    uint64_t packed = E_NodeManager::GetLocalPackTxnCounters(cap, node_id);
+    uint64_t sealed = E_NodeManager::GetSealedPackTxnCounters(cap, node_id);
+    return (packed > sealed) ? (packed - sealed) : 0;
+}
+
+static uint64_t EpochAsyncPackGateStagnationDrip(uint64_t limit)
+{
+    uint64_t drip = limit / 16;
+    if (drip < 32) {
+        drip = 32;
+    }
+    if (drip > 64) {
+        drip = 64;
+    }
+    return drip;
+}
+
+static void EpochAsyncResetCapPackDripState(EpochSharedState* state)
+{
+    state->async_cap_pack_drip_tokens.store(0, std::memory_order_release);
+    state->async_cap_pack_drip_refill_ms.store(0, std::memory_order_release);
+}
+
+/*
+ * backlog 超 limit 且 stagnation 已过后，按周期补充 drip token；全节点共享同一 cap 槽预算。
+ */
+static void EpochAsyncRefillCapPackDripTokens(EpochSharedState* state, uint64_t limit, uint32_t stagnation_ms)
+{
+    if (stagnation_ms == 0) {
+        return;
+    }
+    uint64_t drip = EpochAsyncPackGateStagnationDrip(limit);
+    uint64_t max_tokens = drip * 2;
+    uint64_t now_ms = EpochAsyncNowMs();
+    uint64_t last_ms = state->async_cap_pack_drip_refill_ms.load(std::memory_order_acquire);
+    if (last_ms == 0) {
+        return;
+    }
+    while (now_ms - last_ms >= stagnation_ms) {
+        uint64_t next_ms = last_ms + stagnation_ms;
+        if (!state->async_cap_pack_drip_refill_ms.compare_exchange_weak(
+                last_ms, next_ms, std::memory_order_acq_rel, std::memory_order_acquire)) {
+            continue;
+        }
+        uint64_t prev = state->async_cap_pack_drip_tokens.fetch_add(drip, std::memory_order_acq_rel);
+        if (prev + drip > max_tokens) {
+            state->async_cap_pack_drip_tokens.store(max_tokens, std::memory_order_release);
+        }
+        last_ms = next_ms;
+    }
+}
+
+static bool EpochAsyncTryConsumeCapPackDripToken(EpochSharedState* state)
+{
+    for (;;) {
+        uint64_t cur = state->async_cap_pack_drip_tokens.load(std::memory_order_acquire);
+        if (cur == 0) {
+            return false;
+        }
+        if (state->async_cap_pack_drip_tokens.compare_exchange_weak(
+                cur, cur - 1, std::memory_order_acq_rel, std::memory_order_acquire)) {
+            return true;
+        }
+    }
+}
+
+static long EpochAsyncPackGateBackoffUs(uint64_t spins)
+{
+    if (spins < 32) {
+        return EPOCH_ASYNC_PAUSE_US;
+    }
+    if (spins < 256) {
+        return 1000L;
+    }
+    long cap_us = static_cast<long>(EpochGetAsyncAssignMaxSleepMs()) * 1000L;
+    if (cap_us <= 0 || cap_us > 5000L) {
+        cap_us = 5000L;
+    }
+    return cap_us;
+}
+
+static constexpr uint64_t EPOCH_ASYNC_COMMIT_RATE_COST = 1000000ULL;
+
+/*
+ * 各 backend 共享 token bucket：按 epoch_async_max_tpmc 估算 NewOrder/min，
+ * 用 write_ratio_percent 折算为写事务 COMMIT 速率（TPCC 50/50 时约 1.8x）。
+ */
+static void EpochAsyncRefillCommitRateTokens(EpochSharedState* state, uint64_t refill_per_ms, uint64_t burst_cap)
+{
+    uint64_t now_ms = EpochAsyncNowMs();
+    uint64_t last_ms = state->async_commit_rate_last_ms.load(std::memory_order_acquire);
+    if (last_ms == 0) {
+        uint64_t expect = 0;
+        if (state->async_commit_rate_last_ms.compare_exchange_strong(
+                expect, now_ms, std::memory_order_acq_rel, std::memory_order_acquire)) {
+            state->async_commit_rate_tokens.store(burst_cap / 2, std::memory_order_release);
+        }
+        return;
+    }
+    if (now_ms <= last_ms) {
+        return;
+    }
+    uint64_t elapsed = now_ms - last_ms;
+    if (elapsed > 5000) {
+        elapsed = 5000;
+    }
+    uint64_t next_ms = last_ms + elapsed;
+    if (!state->async_commit_rate_last_ms.compare_exchange_weak(
+            last_ms, next_ms, std::memory_order_acq_rel, std::memory_order_acquire)) {
+        return;
+    }
+    uint64_t added = elapsed * refill_per_ms;
+    uint64_t tokens = state->async_commit_rate_tokens.fetch_add(added, std::memory_order_acq_rel) + added;
+    if (tokens > burst_cap) {
+        state->async_commit_rate_tokens.store(burst_cap, std::memory_order_release);
+    }
+}
+
+static void EpochAsyncWaitForCommitRateLimit(void)
+{
+    uint32_t max_tpmc = EpochGetAsyncMaxTpmc();
+    if (max_tpmc == 0 || !E_IsAsyncEpochMode()) {
+        return;
+    }
+    EpochSharedState* state = EpochGetSharedState();
+    if (state == nullptr) {
+        return;
+    }
+
+    uint32_t ratio_pct = EpochGetAsyncTpmcWriteRatioPercent();
+    uint64_t refill_per_ms = (static_cast<uint64_t>(max_tpmc) * ratio_pct * EPOCH_ASYNC_COMMIT_RATE_COST)
+        / (100ULL * 60000ULL);
+    if (refill_per_ms == 0) {
+        refill_per_ms = 1;
+    }
+    uint64_t burst_cap = refill_per_ms * 2000ULL;
+    if (burst_cap < EPOCH_ASYNC_COMMIT_RATE_COST) {
+        burst_cap = EPOCH_ASYNC_COMMIT_RATE_COST;
+    }
+
+    for (;;) {
+        CHECK_FOR_INTERRUPTS();
+        EpochAsyncRefillCommitRateTokens(state, refill_per_ms, burst_cap);
+        uint64_t tokens = state->async_commit_rate_tokens.load(std::memory_order_acquire);
+        if (tokens >= EPOCH_ASYNC_COMMIT_RATE_COST) {
+            if (state->async_commit_rate_tokens.compare_exchange_weak(tokens,
+                    tokens - EPOCH_ASYNC_COMMIT_RATE_COST,
+                    std::memory_order_acq_rel,
+                    std::memory_order_acquire)) {
+                break;
+            }
+            continue;
+        }
+        pg_usleep(EPOCH_ASYNC_PAUSE_US);
+    }
+}
+
+static void EpochAsyncResetCapPackGateIfNeeded(EpochSharedState* state, uint64_t cap)
+{
+    uint64_t gate_epoch = state->async_cap_pack_epoch.load(std::memory_order_acquire);
+    if (gate_epoch == cap) {
+        return;
+    }
+    state->async_cap_pack_reserved.store(0, std::memory_order_release);
+    state->async_cap_pack_blocked_ms.store(0, std::memory_order_release);
+    EpochAsyncResetCapPackDripState(state);
+    while (!state->async_cap_pack_epoch.compare_exchange_weak(gate_epoch,
+               cap,
+               std::memory_order_acq_rel,
+               std::memory_order_acquire)) {
+        if (gate_epoch == cap) {
+            return;
+        }
+        state->async_cap_pack_reserved.store(0, std::memory_order_release);
+        state->async_cap_pack_blocked_ms.store(0, std::memory_order_release);
+        EpochAsyncResetCapPackDripState(state);
+    }
+}
+
+/*
+ * cap 槽 pack 配额：unsealed_backlog(cap) + in-flight >= limit 时等待。
+ * limit 为 UINT64_MAX 时关闭。stagnation_ms 触顶后按周期发放 drip token（非抬升 effective_limit），
+ * 在避免永久关断的同时保持各节点 pack 背压对称。
+ * 返回 true 表示已占用 in-flight 槽，调用方 pack 结束必须 Release。
+ */
+static bool EpochAsyncWaitForCapPackSlot(uint64_t commit_epoch)
+{
+    if (!E_IsAsyncEpochMode() || !EpochAsyncGapPressure()) {
+        return false;
+    }
+    uint64_t limit = EpochGetAsyncStalePackLimit();
+    if (limit == UINT64_MAX) {
+        return false;
+    }
+
+    EpochSharedState* state = EpochGetSharedState();
+    if (state == nullptr) {
+        return false;
+    }
+
+    instr_time wait_start;
+    INSTR_TIME_SET_CURRENT(wait_start);
+    uint64_t spins = 0;
+    uint32_t stagnation_ms = EpochGetAsyncStagnationMs();
+
+    for (;;) {
+        CHECK_FOR_INTERRUPTS();
+        if (!EpochAsyncGapPressure()) {
+            return false;
+        }
+
+        uint64_t cap = EpochAsyncCapEpoch();
+        if (commit_epoch != cap) {
+            return false;
+        }
+
+        EpochAsyncResetCapPackGateIfNeeded(state, cap);
+
+        uint64_t backlog = EpochAsyncCapUnsealedBacklog(cap);
+        uint64_t inflight = state->async_cap_pack_reserved.load(std::memory_order_acquire);
+        uint64_t pressure = backlog + inflight;
+        if (pressure < limit) {
+            state->async_cap_pack_blocked_ms.store(0, std::memory_order_release);
+            EpochAsyncResetCapPackDripState(state);
+            (void)state->async_cap_pack_reserved.fetch_add(1, std::memory_order_acq_rel);
+            break;
+        }
+
+        if (stagnation_ms == 0) {
+            pg_usleep(EpochAsyncPackGateBackoffUs(spins));
+            spins++;
+            continue;
+        }
+
+        uint64_t now_ms = EpochAsyncNowMs();
+        uint64_t blocked_since = state->async_cap_pack_blocked_ms.load(std::memory_order_acquire);
+        if (blocked_since == 0) {
+            (void)state->async_cap_pack_blocked_ms.compare_exchange_strong(
+                blocked_since, now_ms, std::memory_order_acq_rel, std::memory_order_acquire);
+            blocked_since = state->async_cap_pack_blocked_ms.load(std::memory_order_acquire);
+        }
+        if (blocked_since == 0 || now_ms - blocked_since < stagnation_ms) {
+            pg_usleep(EpochAsyncPackGateBackoffUs(spins));
+            spins++;
+            continue;
+        }
+
+        if (state->async_cap_pack_drip_refill_ms.load(std::memory_order_acquire) == 0) {
+            state->async_cap_pack_drip_refill_ms.store(now_ms, std::memory_order_release);
+        }
+        EpochAsyncRefillCapPackDripTokens(state, limit, stagnation_ms);
+        if (EpochAsyncTryConsumeCapPackDripToken(state)) {
+            (void)state->async_cap_pack_reserved.fetch_add(1, std::memory_order_acq_rel);
+            break;
+        }
+
+        pg_usleep(EpochAsyncPackGateBackoffUs(spins));
+        spins++;
+    }
+
+    if (spins > 0) {
+        EpochRecordGateWait(EPOCH_PERF_GATE_ASYNC_PACK, &wait_start, spins);
+    }
+    return true;
+}
+
+static void EpochAsyncReleaseCapPackSlot(uint64_t commit_epoch)
+{
+    if (!E_IsAsyncEpochMode() || !EpochAsyncGapPressure()) {
+        return;
+    }
+    if (EpochGetAsyncStalePackLimit() == UINT64_MAX) {
+        return;
+    }
+
+    EpochSharedState* state = EpochGetSharedState();
+    if (state == nullptr) {
+        return;
+    }
+
+    uint64_t cap = EpochAsyncCapEpoch();
+    if (commit_epoch != cap) {
+        return;
+    }
+    if (state->async_cap_pack_epoch.load(std::memory_order_acquire) != cap) {
+        return;
+    }
+
+    uint64_t prev = state->async_cap_pack_reserved.load(std::memory_order_relaxed);
+    if (prev > 0) {
+        (void)state->async_cap_pack_reserved.fetch_sub(1, std::memory_order_acq_rel);
+    }
+}
+
+/* pack 前仅在队列高压时等待 drain，不要求 logical 推进 */
+static void EpochAsyncWaitForPackQueue(void)
+{
+    if (!E_IsAsyncEpochMode() || !EpochAsyncQueuePressure()) {
+        return;
+    }
+
+    uint32_t queue_threshold = EpochAsyncQueuePressureThreshold();
+    instr_time wait_start;
+    INSTR_TIME_SET_CURRENT(wait_start);
+    uint64_t spins = 0;
+
+    while (EpochTxnQueueCount() >= queue_threshold) {
+        pg_usleep(EPOCH_ASYNC_PAUSE_US);
+        spins++;
+        CHECK_FOR_INTERRUPTS();
+    }
+
+    if (spins > 0) {
+        EpochRecordGateWait(EPOCH_PERF_GATE_ASYNC_ADMIT, &wait_start, spins);
+    }
+}
+
+static bool E_PackWriteTxnToQueue(O_TxnManager* txn, uint64_t commit_epoch, uint32_t node_id)
+{
+    bool cap_slot_reserved = false;
+    if (E_IsAsyncEpochMode() && EpochGetTotalNodes() > 1) {
+        cap_slot_reserved = EpochAsyncWaitForCapPackSlot(commit_epoch);
+    }
+
+    uint64_t csn = g_epochCsnManager.GetNextCSN();
+    txn->SetCommitSequenceNumber(csn);
+    E_WireTxn wire;
+    if (!E_BuildWireTxn(txn, csn, &wire)) {
+        if (cap_slot_reserved) {
+            EpochAsyncReleaseCapPackSlot(commit_epoch);
+        }
+        return false;
+    }
+    E_NodeManager::IncChangeSetTxnCounters(commit_epoch, node_id);
+    std::string payload;
+    if (!E_WireSerializeTxn(wire, &payload)) {
+        if (cap_slot_reserved) {
+            EpochAsyncReleaseCapPackSlot(commit_epoch);
+        }
+        ereport(ERROR, (errcode(ERRCODE_OUT_OF_MEMORY), errmsg("epoch: failed to serialize transaction")));
+    }
+    if (!EpochTxnQueuePush(payload.data(), static_cast<uint32_t>(payload.size()))) {
+        if (cap_slot_reserved) {
+            EpochAsyncReleaseCapPackSlot(commit_epoch);
+        }
+        ereport(ERROR, (errcode(ERRCODE_OUT_OF_MEMORY), errmsg("epoch: pending txn queue is full")));
+    }
+    E_NodeManager::IncLocalPackTxnCounters(commit_epoch, node_id);
+    if (cap_slot_reserved) {
+        EpochAsyncReleaseCapPackSlot(commit_epoch);
+    }
+    return true;
+}
+
+static void E_AssignEpochOnStart(void)
+{
+    if (u_sess->epoch_cxt.epoch_assigned) {
+        return;
+    }
+    uint64_t epoch = EpochAssignTxnEpoch();
+    u_sess->epoch_cxt.start_epoch = epoch;
+    u_sess->epoch_cxt.commit_epoch = epoch;
+    u_sess->epoch_cxt.epoch_assigned = true;
+}
+
+/*
+ * GeoGauss is_sync_exec START gate (mot_fdw.cpp)：
+ * while (start_epoch > logical || !IsRecordCommitted()) usleep(200);
+ *
+ * 单连接「多等一会」在 healthy 时可行（physical 仅领先 logical 数个 slot）；
+ * logical 卡死时 physical 可领先上百，新事务 commit_epoch 远超 logical，此处会
+ * 长时间自旋；每个 TPCC 终端占一个 backend，JDBC 建连/首条 SQL 有超时 → 表现为连不上。
+ */
+static void EpochWaitForStartGate(uint64_t commit_epoch)
+{
+    if (E_IsAsyncEpochMode()) {
+        /*
+         * async：不在 START 阻塞；gap 顶满时 cap epoch pack 硬配额在 COMMIT pack 路径生效。
+         * pack 前仅在队列 ≥75% 时等待 drain。
+         */
+        (void)commit_epoch;
+        return;
+    }
+
+    const long waitUs = 200;
+    if (E_IsSyncEpochMode()) {
+        instr_time wait_start;
+        INSTR_TIME_SET_CURRENT(wait_start);
+        uint64_t spins = 0;
+        while (commit_epoch > E_NodeManager::GetLogicalEpoch() ||
+               !E_NodeManager::IsRecordCommitted()) {
+            pg_usleep(waitUs);
+            spins++;
+            CHECK_FOR_INTERRUPTS();
+        }
+        EpochRecordGateWait(EPOCH_PERF_GATE_START, &wait_start, spins);
+    }
+}
+
+/*
+ * 已在途事务 COMMIT/pack：只等 logical 关窗，不再看 record_committed。
+ * 否则 remote_exec 将 record_committed 置 false 后，读事务无法 pack，
+ * change_set 永不对账，epoch 无法 seal。
+ */
+static void EpochWaitForLogicalEpoch(uint64_t commit_epoch)
+{
+    if (!E_IsSyncEpochMode()) {
+        return;
+    }
+    const long waitUs = 200;
+    instr_time wait_start;
+    INSTR_TIME_SET_CURRENT(wait_start);
+    uint64_t spins = 0;
+    while (commit_epoch > E_NodeManager::GetLogicalEpoch()) {
+        pg_usleep(waitUs);
+        spins++;
+        CHECK_FOR_INTERRUPTS();
+    }
+    EpochRecordGateWait(EPOCH_PERF_GATE_LOGICAL_COMMIT, &wait_start, spins);
+}
+
+static void EpochWaitForRemoteExeced(void)
+{
+    if (!E_IsSyncEpochMode()) {
+        return;
+    }
+    const long waitUs = 200;
+    instr_time wait_start;
+    INSTR_TIME_SET_CURRENT(wait_start);
+    uint64_t spins = 0;
+    while (!E_NodeManager::IsRemoteExeced()) {
+        pg_usleep(waitUs);
+        spins++;
+        CHECK_FOR_INTERRUPTS();
+    }
+    EpochRecordGateWait(EPOCH_PERF_GATE_REMOTE_EXEC, &wait_start, spins);
+}
+
+static void EpochWaitForRemoteRecordCommitted(void)
+{
+    if (!E_IsSyncEpochMode()) {
+        return;
+    }
+    const long waitUs = 200;
+    instr_time wait_start;
+    INSTR_TIME_SET_CURRENT(wait_start);
+    uint64_t spins = 0;
+    while (!E_NodeManager::IsRemoteRecordCommitted()) {
+        pg_usleep(waitUs);
+        spins++;
+        CHECK_FOR_INTERRUPTS();
+    }
+    EpochRecordGateWait(EPOCH_PERF_GATE_REMOTE_RECORD, &wait_start, spins);
+}
+
+void EpochXactCallback(XactEvent event)
+{
+    if (!g_enable_epoch_multimaster) {
+        return;
+    }
+
+    if (event == XACT_EVENT_START) {
+        if (E_ShouldTrackTxnEpoch()) {
+            E_AssignEpochOnStart();
+            EpochWaitForStartGate(u_sess->epoch_cxt.commit_epoch);
+        }
+        return;
+    }
+
+    O_TxnManager* txn = u_sess->occ_cxt.txn_manager;
+    if (txn == nullptr) {
+        if (event == XACT_EVENT_ABORT || event == XACT_EVENT_END_TRANSACTION) {
+            EpochReleaseTxnExecuting();
+        }
+        return;
+    }
+
+    if (event == XACT_EVENT_COMMIT) {
+        if (!E_TxnHasWriteSet(txn)) {
+            /* 只读：SQL 已结束，先释放 executing 再等待关窗，避免与 seal 互锁 */
+            EpochReleaseTxnExecuting();
+            if (u_sess->epoch_cxt.epoch_assigned && E_IsSyncEpochMode()) {
+                EpochWaitForLogicalEpoch(u_sess->epoch_cxt.commit_epoch);
+                /* GeoGauss read_committed_txn_num：只读不计入 pack */
+                E_NodeManager::IncReadCommittedTxnCounters(u_sess->epoch_cxt.commit_epoch, EpochGetNodeId());
+            }
+            u_sess->epoch_cxt.epoch_assigned = false;
+            return;
+        }
+        if (!u_sess->epoch_cxt.epoch_assigned) {
+            E_AssignEpochOnStart();
+            EpochWaitForStartGate(u_sess->epoch_cxt.commit_epoch);
+        }
+
+        /*
+         * 必须先 ValidateCommit 再等待 logical epoch。
+         * 否则等待期间 epoch apply 会更新 heap 上 m_rowCSN，单连接也会误判为 concurrent update。
+         */
+        if (O_ValidateCommit() != RC_OK) {
+            if (u_sess->epoch_cxt.epoch_assigned) {
+                E_NodeManager::IncAbortTxnCounters(u_sess->epoch_cxt.commit_epoch, EpochGetNodeId());
+            }
+            EpochReleaseTxnExecuting();
+            ereport(ERROR,
+                    (errcode(ERRCODE_T_R_SERIALIZATION_FAILURE),
+                     errmsg("epoch: could not serialize access due to concurrent update"),
+                     errhidestmt(true),
+                     errhideprefix(true),
+                     onlyfrontmsg(true)));
+        }
+
+        uint64_t commit_epoch = u_sess->epoch_cxt.commit_epoch;
+        uint32_t node_id = EpochGetNodeId();
+
+        /*
+         * 异步多主：pack 后立即入账 produce/record_commit/record_committed（与 sync 关窗计数对齐），
+         * 避免 worker 在 pack 与 RECORD_COMMIT 之间推进 logical 时 prod=0 → commit_path_incomplete，
+         * 以及 TryFinishCommitPhase 等 record_committed 导致 logical 卡死。
+         * RECORD_COMMIT 仅 O_RecordCommit。
+         */
+        if (E_IsAsyncEpochMode()) {
+            EpochAsyncWaitForCommitRateLimit();
+            if (EpochGetTotalNodes() > 1) {
+                EpochAsyncWaitForPackQueue();
+                if (E_PackWriteTxnToQueue(txn, commit_epoch, node_id)) {
+                    E_NodeManager::IncLocalProduceTxnCounters(commit_epoch, node_id);
+                    E_NodeManager::IncLocalRecordCommitCounters(commit_epoch, node_id);
+                    E_NodeManager::IncLocalRecordCommittedCounters(commit_epoch, node_id);
+                }
+            }
+            EpochReleaseTxnExecuting();
+            txn->ReleaseOccLocks();
+            u_sess->epoch_cxt.deferred_commit = true;
+            return;
+        }
+
+        /*
+         * 同步多主：先 pack 并释放 executing，再等待 logical 关窗与对端 exec。
+         * 若先等待 logical 再 pack，executing 未释放会挡住 seal → 死锁。
+         */
+        if (EpochGetTotalNodes() > 1) {
+            (void)E_PackWriteTxnToQueue(txn, commit_epoch, node_id);
+        }
+        EpochReleaseTxnExecuting();
+        /*
+         * ValidateCommit 已加 OCC 行锁；若带着锁等 remote_exec，其他事务无法提交 pack，
+         * executing 永不为 0 → seal 卡住 → logical/remote_exec 永不推进 → 死锁。
+         */
+        txn->ReleaseOccLocks();
+
+        EpochWaitForLogicalEpoch(u_sess->epoch_cxt.commit_epoch);
+        EpochWaitForRemoteExeced();
+
+        if (E_IsSyncEpochMode()) {
+            E_NodeManager::IncLocalProduceTxnCounters(commit_epoch, node_id);
+            uint64_t csn = txn->GetCommitSequenceNumber();
+            if (EpochAbortCsnContains(commit_epoch, csn, node_id)) {
+                E_NodeManager::IncWriteAbortAfterSendTxnCounters(commit_epoch, node_id);
+                E_NodeManager::IncAbortTxnCounters(commit_epoch, node_id);
+                O_OccStatsRecordAbort(OCC_ABORT_REMOTE_MERGE);
+                ereport(ERROR,
+                    (errcode(ERRCODE_T_R_SERIALIZATION_FAILURE),
+                     errmsg("epoch: transaction aborted after remote merge (csn %lu)", csn),
+                     errhidestmt(true),
+                     errhideprefix(true),
+                     onlyfrontmsg(true)));
+            }
+            E_NodeManager::IncLocalRecordCommitCounters(commit_epoch, node_id);
+        }
+
+        u_sess->epoch_cxt.deferred_commit = true;
+        return;
+    }
+
+    if (event == XACT_EVENT_RECORD_COMMIT) {
+        if (!E_TxnHasWriteSet(txn)) {
+            return;
+        }
+        if (E_IsSyncEpochMode() && !u_sess->epoch_cxt.deferred_commit) {
+            return;
+        }
+
+        uint64_t csn = txn->GetCommitSequenceNumber();
+        if (csn == INVALID_CSN) {
+            csn = g_epochCsnManager.GetNextCSN();
+            txn->SetCommitSequenceNumber(csn);
+        }
+        uint64_t commit_epoch = u_sess->epoch_cxt.commit_epoch;
+        uint32_t node_id = EpochGetNodeId();
+
+        if (E_IsAsyncEpochMode()) {
+            if (!u_sess->epoch_cxt.deferred_commit) {
+                return;
+            }
+            O_RecordCommit(csn);
+            O_OccStatsRecordCommit();
+            return;
+        }
+
+        if (E_IsSyncEpochMode() && !O_RevalidateWriteSet()) {
+            if (u_sess->epoch_cxt.epoch_assigned) {
+                E_NodeManager::IncWriteAbortAfterSendTxnCounters(commit_epoch, node_id);
+                E_NodeManager::IncAbortTxnCounters(commit_epoch, node_id);
+            }
+            O_OccStatsRecordAbort(OCC_ABORT_REVALIDATE);
+            ereport(ERROR,
+                (errcode(ERRCODE_T_R_SERIALIZATION_FAILURE),
+                 errmsg("epoch: could not serialize access due to concurrent update (revalidate)"),
+                 errhidestmt(true),
+                 errhideprefix(true),
+                 onlyfrontmsg(true)));
+        }
+
+        O_RecordCommit(csn);
+
+        if (E_IsSyncEpochMode()) {
+            E_NodeManager::IncLocalRecordCommittedCounters(commit_epoch, node_id);
+            EpochWaitForRemoteRecordCommitted();
+        } else if (EpochGetTotalNodes() > 1) {
+            E_NodeManager::IncLocalRecordCommitCounters(commit_epoch, node_id);
+        }
+        O_OccStatsRecordCommit();
+        return;
+    }
+
+    if (event == XACT_EVENT_END_TRANSACTION) {
+        u_sess->epoch_cxt.deferred_commit = false;
+        EpochReleaseTxnExecuting();
+        txn->EndTransaction();
+        u_sess->epoch_cxt.epoch_assigned = false;
+        u_sess->epoch_cxt.start_epoch = 0;
+        u_sess->epoch_cxt.commit_epoch = 0;
+        return;
+    }
+
+    if (event == XACT_EVENT_ABORT) {
+        bool had_deferred = u_sess->epoch_cxt.deferred_commit;
+        if (had_deferred) {
+            u_sess->epoch_cxt.deferred_commit = false;
+        }
+        if (u_sess->epoch_cxt.epoch_assigned && (E_IsSyncEpochMode() || E_IsAsyncEpochMode())) {
+            if (had_deferred) {
+                E_NodeManager::IncWriteAbortAfterSendTxnCounters(u_sess->epoch_cxt.commit_epoch, EpochGetNodeId());
+            }
+            E_NodeManager::IncAbortTxnCounters(u_sess->epoch_cxt.commit_epoch, EpochGetNodeId());
+        }
+        EpochReleaseTxnExecuting();
+        txn->Rollback();
+        u_sess->epoch_cxt.epoch_assigned = false;
+        u_sess->epoch_cxt.start_epoch = 0;
+        u_sess->epoch_cxt.commit_epoch = 0;
+    }
+}
