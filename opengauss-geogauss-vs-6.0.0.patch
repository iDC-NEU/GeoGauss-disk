+//
+// Legacy O_DeltaTable API — thin wrapper over O_StagingTable.
+//
+// Existing occ/ integration (g_enable_occ_delta) continues to compile against
+// include/occ/o_delta_table.h. When staging mode is fully wired, callers should
+// migrate to o_staging_api.h.
+//
+
+#include "occ/o_delta_table.h"
+#include "o_staging_table.h"
+#include "o_staging_memory.h"
+
+#include "utils/rel.h"
+
+O_DeltaTable &O_DeltaTable::Instance()
+{
+    static O_DeltaTable instance;
+    return instance;
+}
+
+O_DeltaKey O_DeltaTable::MakeKey(Relation relation, ItemPointer tid) const
+{
+    O_DeltaKey key;
+    key.relid = RelationGetRelid(relation);
+    key.block = ItemPointerGetBlockNumber(tid);
+    key.offset = ItemPointerGetOffsetNumber(tid);
+    return key;
+}
+
+size_t O_DeltaTable::ShardIndex(const O_DeltaKey &key) const
+{
+    return O_DeltaKeyHash{}(key) % SHARD_COUNT;
+}
+
+void O_DeltaTable::Upsert(Relation relation, ItemPointer tid, HeapTuple tuple, uint64_t csn)
+{
+    O_StagingTable::Instance().StageUpsert(relation, tid, tuple, csn);
+}
+
+void O_DeltaTable::MarkDeleted(Relation relation, ItemPointer tid, uint64_t csn)
+{
+    O_StagingTable::Instance().StageDelete(relation, tid, csn);
+}
+
+bool O_DeltaTable::Lookup(Relation relation, ItemPointer tid, O_DeltaEntry &outEntry)
+{
+    O_StagingEntry staged;
+    if (!O_StagingTable::Instance().Lookup(relation, tid, staged)) {
+        return false;
+    }
+
+    outEntry.deleted = staged.deleted;
+    outEntry.is_latest = staged.is_latest;
+    outEntry.csn = staged.csn;
+    outEntry.tuple = nullptr;
+    return true;
+}
+
+HeapTuple O_DeltaTable::LookupCopyTuple(Relation relation, ItemPointer tid)
+{
+    return O_StagingTable::Instance().LookupCopyTuple(relation, tid);
+}
diff --git a/src/occ-opt/o_dirty_page_tracker.cpp b/src/occ-opt/o_dirty_page_tracker.cpp
new file mode 100644
index 0000000..ababf35
--- /dev/null
+++ b/src/occ-opt/o_dirty_page_tracker.cpp
@@ -0,0 +1,113 @@
+//
+// Page-level dirty tuple tracking implementation.
+//
+
+#include "o_dirty_page_tracker.h"
+
+O_DirtyPageTracker &O_DirtyPageTracker::Instance()
+{
+    static O_DirtyPageTracker instance;
+    return instance;
+}
+
+O_DirtyPageTracker::O_DirtyPageTracker() : m_threshold(32) {}
+
+void O_DirtyPageTracker::Configure(uint32_t dirty_threshold_per_page)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_threshold = dirty_threshold_per_page > 0 ? dirty_threshold_per_page : 1;
+}
+
+bool O_DirtyPageTracker::RecordStaged(Oid relid, ItemPointer tid, uint64_t csn, bool is_new_slot)
+{
+    if (tid == nullptr) {
+        return false;
+    }
+
+    O_StagingPageKey pageKey = O_StagingPageKeyFromTid(relid, tid);
+    std::lock_guard<std::mutex> lock(m_mutex);
+    O_DirtyPageInfo &info = m_pages[pageKey];
+    info.last_staged_csn = csn;
+    if (is_new_slot) {
+        info.dirty_count++;
+    }
+    return info.dirty_count >= m_threshold;
+}
+
+void O_DirtyPageTracker::RecordFlushed(Oid relid, BlockNumber block, uint32_t flushed_count)
+{
+    O_StagingPageKey pageKey;
+    pageKey.relid = relid;
+    pageKey.block = block;
+
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto it = m_pages.find(pageKey);
+    if (it == m_pages.end()) {
+        return;
+    }
+
+    if (flushed_count >= it->second.dirty_count) {
+        m_pages.erase(it);
+        return;
+    }
+    it->second.dirty_count -= flushed_count;
+}
+
+bool O_DirtyPageTracker::ShouldFlush(const O_StagingPageKey &pageKey) const
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto it = m_pages.find(pageKey);
+    if (it == m_pages.end()) {
+        return false;
+    }
+    return it->second.dirty_count >= m_threshold;
+}
+
+uint32_t O_DirtyPageTracker::GetDirtyCount(const O_StagingPageKey &pageKey) const
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto it = m_pages.find(pageKey);
+    if (it == m_pages.end()) {
+        return 0;
+    }
+    return it->second.dirty_count;
+}
+
+void O_DirtyPageTracker::GetPagesExceedingThreshold(std::vector<O_StagingPageKey> &outPages) const
+{
+    outPages.clear();
+    std::lock_guard<std::mutex> lock(m_mutex);
+    for (const auto &kv : m_pages) {
+        if (kv.second.dirty_count >= m_threshold) {
+            outPages.push_back(kv.first);
+        }
+    }
+}
+
+void O_DirtyPageTracker::GetAllDirtyPages(std::vector<O_StagingPageKey> &outPages) const
+{
+    outPages.clear();
+    std::lock_guard<std::mutex> lock(m_mutex);
+    outPages.reserve(m_pages.size());
+    for (const auto &kv : m_pages) {
+        outPages.push_back(kv.first);
+    }
+}
+
+void O_DirtyPageTracker::ClearPage(const O_StagingPageKey &pageKey)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_pages.erase(pageKey);
+}
+
+void O_DirtyPageTracker::ClearAll()
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_pages.clear();
+}
+
+uint64_t O_DirtyPageTracker::GetTrackedPageCount() const
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    return m_pages.size();
+}
diff --git a/src/occ-opt/o_dirty_page_tracker.h b/src/occ-opt/o_dirty_page_tracker.h
new file mode 100644
index 0000000..ac6211b
--- /dev/null
+++ b/src/occ-opt/o_dirty_page_tracker.h
@@ -0,0 +1,70 @@
+//
+// Page-level dirty tuple tracking for deferred write-back.
+//
+
+#ifndef OCC_OPT_O_DIRTY_PAGE_TRACKER_H
+#define OCC_OPT_O_DIRTY_PAGE_TRACKER_H
+
+#include "o_staging_types.h"
+
+#include <mutex>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+struct O_DirtyPageInfo
+{
+    uint32_t dirty_count;
+    uint64_t last_staged_csn;
+
+    O_DirtyPageInfo() : dirty_count(0), last_staged_csn(0) {}
+};
+
+class O_DirtyPageTracker
+{
+public:
+    static O_DirtyPageTracker &Instance();
+
+    void Configure(uint32_t dirty_threshold_per_page);
+
+    /*
+     * Record that one tuple slot on the page was newly staged.
+     * Only increments dirty_count when is_new_slot is true (not an overwrite).
+     * Returns true if the page now exceeds the flush threshold.
+     */
+    bool RecordStaged(Oid relid, ItemPointer tid, uint64_t csn, bool is_new_slot);
+
+    /*
+     * Decrement dirty count after a tuple is flushed; remove page entry when zero.
+     */
+    void RecordFlushed(Oid relid, BlockNumber block, uint32_t flushed_count);
+
+    bool ShouldFlush(const O_StagingPageKey &pageKey) const;
+
+    uint32_t GetDirtyCount(const O_StagingPageKey &pageKey) const;
+
+    /*
+     * Pages whose dirty tuple count >= threshold.
+     */
+    void GetPagesExceedingThreshold(std::vector<O_StagingPageKey> &outPages) const;
+
+    /*
+     * All pages with any staged dirty tuples.
+     */
+    void GetAllDirtyPages(std::vector<O_StagingPageKey> &outPages) const;
+
+    void ClearPage(const O_StagingPageKey &pageKey);
+
+    void ClearAll();
+
+    uint64_t GetTrackedPageCount() const;
+
+private:
+    O_DirtyPageTracker();
+
+    uint32_t m_threshold;
+    mutable std::mutex m_mutex;
+    std::unordered_map<O_StagingPageKey, O_DirtyPageInfo, O_StagingPageKeyHash> m_pages;
+};
+
+#endif /* OCC_OPT_O_DIRTY_PAGE_TRACKER_H */
diff --git a/src/occ-opt/o_staging_api.cpp b/src/occ-opt/o_staging_api.cpp
new file mode 100644
index 0000000..ae75316
--- /dev/null
+++ b/src/occ-opt/o_staging_api.cpp
@@ -0,0 +1,217 @@
+//
+// Unified facade implementation for version staging hash table.
+//
+
+#include "o_staging_api.h"
+#include "o_staging_table.h"
+#include "o_dirty_page_tracker.h"
+#include "o_staging_flush.h"
+#include "o_background_flusher.h"
+
+#include "utils/rel.h"
+
+namespace {
+
+bool g_staging_enabled = false;
+O_StagingConfig g_staging_config;
+
+bool O_StagingAccessTypeNeedsStage(AccessType type)
+{
+    switch (type) {
+        case WR:
+        case DEL:
+        case INS:
+        case INV:
+            return true;
+        default:
+            return false;
+    }
+}
+
+void O_StagingMaybeRequestFlush(Oid relid, ItemPointer tid, uint64_t csn, bool is_new_slot)
+{
+    O_DirtyPageTracker &tracker = O_DirtyPageTracker::Instance();
+    if (tracker.RecordStaged(relid, tid, csn, is_new_slot)) {
+        BlockNumber block = ItemPointerGetBlockNumber(tid);
+        O_BackgroundFlusher::Instance().RequestImmediateFlush(relid, block);
+    }
+}
+
+}  // namespace
+
+void O_StagingInit(const O_StagingConfig *config)
+{
+    if (config != nullptr) {
+        g_staging_config = *config;
+    } else {
+        g_staging_config = O_StagingConfig{};
+    }
+
+    O_StagingTable::Instance().Configure(g_staging_config.shard_count);
+    O_DirtyPageTracker::Instance().Configure(g_staging_config.dirty_threshold_per_page);
+    O_BackgroundFlusher::Instance().Configure(g_staging_config);
+
+    O_StagingFlushCallbacks callbacks;
+    callbacks.write_tuple = O_StagingFlush::DefaultNoOpWrite;
+    O_StagingFlush::Instance().SetCallbacks(callbacks);
+
+    if (g_staging_config.enable_background_flusher) {
+        O_StagingStartBackgroundFlusher();
+    }
+}
+
+void O_StagingShutdown()
+{
+    O_StagingStopBackgroundFlusher();
+    O_StagingFlushAll();
+    O_DirtyPageTracker::Instance().ClearAll();
+    g_staging_enabled = false;
+}
+
+bool O_StagingEnabled()
+{
+    return g_staging_enabled;
+}
+
+void O_StagingSetEnabled(bool enabled)
+{
+    g_staging_enabled = enabled;
+    if (enabled && g_staging_config.enable_background_flusher) {
+        O_StagingStartBackgroundFlusher();
+    } else if (!enabled) {
+        O_StagingStopBackgroundFlusher();
+    }
+}
+
+const O_StagingConfig &O_StagingGetConfig()
+{
+    return g_staging_config;
+}
+
+void O_StagingSetConfig(const O_StagingConfig &config)
+{
+    g_staging_config = config;
+    O_StagingTable::Instance().Configure(config.shard_count);
+    O_DirtyPageTracker::Instance().Configure(config.dirty_threshold_per_page);
+    O_BackgroundFlusher::Instance().Configure(config);
+}
+
+void O_StagingSetFlushCallbacks(const O_StagingFlushCallbacks &callbacks)
+{
+    O_StagingFlush::Instance().SetCallbacks(callbacks);
+}
+
+bool O_StagingStageCommit(Relation relation, ItemPointer tid, HeapTuple tuple, uint64_t csn,
+                          AccessType access_type)
+{
+    if (!g_staging_enabled || relation == nullptr || tid == nullptr) {
+        return false;
+    }
+    if (!O_StagingAccessTypeNeedsStage(access_type)) {
+        return false;
+    }
+
+    O_StagingTable &staging = O_StagingTable::Instance();
+    Oid relid = RelationGetRelid(relation);
+    bool is_new_slot = false;
+
+    switch (access_type) {
+        case DEL:
+            is_new_slot = staging.StageDelete(relation, tid, csn);
+            break;
+        case INS:
+        case WR:
+        case INV:
+            if (tuple == nullptr || tuple->t_data == nullptr) {
+                return false;
+            }
+            is_new_slot = staging.StageUpsert(relation, tid, tuple, csn);
+            break;
+        default:
+            return false;
+    }
+
+    O_StagingMaybeRequestFlush(relid, tid, csn, is_new_slot);
+    return true;
+}
+
+bool O_StagingTryRead(Relation relation, ItemPointer tid, O_StagingLookupResult &result)
+{
+    if (!g_staging_enabled || relation == nullptr || tid == nullptr) {
+        return false;
+    }
+    return O_StagingTable::Instance().LookupForRead(relation, tid, result);
+}
+
+HeapTuple O_StagingReadCopyTuple(Relation relation, ItemPointer tid)
+{
+    if (!g_staging_enabled || relation == nullptr || tid == nullptr) {
+        return nullptr;
+    }
+    return O_StagingTable::Instance().LookupCopyTuple(relation, tid);
+}
+
+bool O_StagingHasEntry(Relation relation, ItemPointer tid)
+{
+    if (!g_staging_enabled || relation == nullptr || tid == nullptr) {
+        return false;
+    }
+    O_StagingEntry entry;
+    return O_StagingTable::Instance().Lookup(relation, tid, entry);
+}
+
+bool O_StagingCheckVersion(Relation relation, ItemPointer tid, uint64_t expected_csn,
+                           bool check_latest)
+{
+    if (!g_staging_enabled || relation == nullptr || tid == nullptr) {
+        return true;
+    }
+
+    O_StagingEntry entry;
+    if (!O_StagingTable::Instance().Lookup(relation, tid, entry)) {
+        return true;
+    }
+
+    if (entry.csn != expected_csn) {
+        return false;
+    }
+    if (check_latest && !entry.is_latest && !entry.deleted) {
+        return false;
+    }
+    return true;
+}
+
+size_t O_StagingFlushPage(Oid relid, BlockNumber block)
+{
+    return O_StagingFlush::Instance().FlushPage(relid, block);
+}
+
+size_t O_StagingFlushAll()
+{
+    return O_StagingFlush::Instance().FlushAll();
+}
+
+void O_StagingFlusherTick()
+{
+    if (!g_staging_enabled) {
+        return;
+    }
+    O_BackgroundFlusher::Instance().Tick();
+}
+
+void O_StagingStartBackgroundFlusher()
+{
+    O_BackgroundFlusher::Instance().Start();
+}
+
+void O_StagingStopBackgroundFlusher()
+{
+    O_BackgroundFlusher::Instance().Stop();
+}
+
+O_StagingStats O_StagingGetStats()
+{
+    O_StagingStats stats = O_StagingTable::Instance().GetStatsSnapshot();
+    stats.staged_pages = O_DirtyPageTracker::Instance().GetTrackedPageCount();
+    return stats;
+}
diff --git a/src/occ-opt/o_staging_api.h b/src/occ-opt/o_staging_api.h
