+//
+// Observed epoch tracking with link propagation compensation (CATCHUP).
+//
+
+#ifndef DYNAMIC_NET_DN_EPOCH_OBSERVER_H
+#define DYNAMIC_NET_DN_EPOCH_OBSERVER_H
+
+#include "dn_config.h"
+
+#include <atomic>
+#include <cstdint>
+
+class DnEpochObserver {
+public:
+    explicit DnEpochObserver(const DnNetworkConfig *config);
+
+    void Configure(const DnNetworkConfig *config);
+
+    /*
+     * Called when AppendEntries is received.
+     * projected = sender_epoch + ceil(one_way_latency / epoch_duration_ms)
+     */
+    void RecordObservedEpoch(int32_t sender_epoch, int from_node, int to_node);
+
+    void RecordObservedEpochDirect(int32_t projected_epoch);
+
+    int32_t GetMaxObservedEpoch() const;
+
+    void Reset();
+
+private:
+    const DnNetworkConfig *m_config;
+    std::atomic<int32_t> m_maxObservedEpoch;
+
+    int32_t CompensateEpoch(int32_t sender_epoch, int from_node, int to_node) const;
+};
+
+#endif /* DYNAMIC_NET_DN_EPOCH_OBSERVER_H */
diff --git a/src/dynamic-net/dn_hash.cpp b/src/dynamic-net/dn_hash.cpp
new file mode 100644
index 0000000..52bae8e
--- /dev/null
+++ b/src/dynamic-net/dn_hash.cpp
@@ -0,0 +1,35 @@
+#include "dn_hash.h"
+
+uint64_t DnHashTxn(const DnTransaction &txn)
+{
+    std::string data = txn.client_key + "_" + std::to_string(txn.client_txn_id);
+    uint64_t h = std::hash<std::string>{}(data);
+    for (const auto &row : txn.rows) {
+        h = DnCombineHashes(h, std::hash<std::string>{}(row.key));
+        h = DnCombineHashes(h, std::hash<std::string>{}(row.value));
+    }
+    return h;
+}
+
+uint64_t DnHashMergedTxns(const std::vector<DnTransaction> &txns)
+{
+    uint64_t h = 0;
+    for (const auto &txn : txns) {
+        h = DnCombineHashes(h, DnHashTxn(txn));
+    }
+    return h;
+}
+
+uint64_t DnHashRaftEntry(const DnRaftEntry &entry)
+{
+    uint64_t h = static_cast<uint64_t>(entry.epoch) ^ (static_cast<uint64_t>(entry.index) << 16);
+    for (const auto &txn : entry.txns) {
+        h = DnCombineHashes(h, DnHashTxn(txn));
+    }
+    return h;
+}
+
+uint64_t DnCombineHashes(uint64_t a, uint64_t b)
+{
+    return a ^ (b + 0x9e3779b97f4a7c15ULL + (a << 6) + (a >> 2));
+}
