+void EpochPerfMaybeReport(void)
+{
+    if (!EpochPerfIsEnabled()) {
+        return;
+    }
+
+    uint64_t physical = E_NodeManager::GetPhysicalEpoch();
+    if (g_last_perf_report_physical != 0 && physical <= g_last_perf_report_physical + 49) {
+        return;
+    }
+    g_last_perf_report_physical = physical;
+
+    EpochSharedState::EpochPerfCounters* perf = EpochPerfCounters();
+    if (perf == nullptr) {
+        return;
+    }
+
+    char path[MAXPGPATH];
+    if (!EpochFormatLogPath(path, sizeof(path), "epoch_perf")) {
+        return;
+    }
+
+    FILE* fp = fopen(path, "a");
+    if (fp == nullptr) {
+        return;
+    }
+
+    time_t now = time(nullptr);
+    struct tm tm_buf;
+    (void)localtime_r(&now, &tm_buf);
+    char ts[32];
+    (void)strftime(ts, sizeof(ts), "%Y-%m-%d %H:%M:%S", &tm_buf);
+
+    uint64_t logical = E_NodeManager::GetLogicalEpoch();
+    uint64_t gap_pl = (physical >= logical) ? (physical - logical) : 0;
+    uint32_t self = EpochGetNodeId();
+    uint64_t total_gate_us = 0;
+    for (uint32_t i = 0; i < EPOCH_PERF_GATE_COUNT; ++i) {
+        total_gate_us += perf->gate_wait_us[i].load(std::memory_order_relaxed);
+    }
+
+    char buf[512];
+    int rc = snprintf_s(buf,
+        sizeof(buf),
+        sizeof(buf) - 1,
+        "[%s] node=%u profile_gate_total_us=%lu physical=%lu logical=%lu gap=%lu commit_sync=%s",
+        ts,
+        self,
+        total_gate_us,
+        physical,
+        logical,
+        gap_pl,
+        g_epoch_commit_sync ? "on" : "off");
+    securec_check_ss(rc, "\0", "\0");
+    EpochPerfAppendLine(fp, buf);
+
+    for (uint32_t i = 0; i < EPOCH_PERF_GATE_COUNT; ++i) {
+        uint64_t wait_us = perf->gate_wait_us[i].load(std::memory_order_relaxed);
+        uint64_t waits = perf->gate_wait_count[i].load(std::memory_order_relaxed);
+        uint64_t spins = perf->gate_spin_count[i].load(std::memory_order_relaxed);
+        if (wait_us == 0 && waits == 0) {
+            continue;
+        }
+        rc = snprintf_s(buf,
+            sizeof(buf),
+            sizeof(buf) - 1,
+            "  GATE %s wait_us=%lu events=%lu spin_loops=%lu avg_us=%.1f",
+            EpochPerfGateName(static_cast<EpochPerfGateKind>(i)),
+            wait_us,
+            waits,
+            spins,
+            waits > 0 ? (static_cast<double>(wait_us) / static_cast<double>(waits)) : 0.0);
+        securec_check_ss(rc, "\0", "\0");
+        EpochPerfAppendLine(fp, buf);
+    }
+
+    uint64_t wire_txn = perf->zmq_wire_txn_send_count.load(std::memory_order_relaxed);
+    uint64_t wire_bytes = perf->zmq_wire_txn_send_bytes.load(std::memory_order_relaxed);
+    uint64_t row_bytes = perf->zmq_wire_row_bytes.load(std::memory_order_relaxed);
+    uint64_t row_count = perf->zmq_wire_row_count.load(std::memory_order_relaxed);
+    rc = snprintf_s(buf,
+        sizeof(buf),
+        sizeof(buf) - 1,
+        "  ZMQ_SEND wire_txn=%lu wire_bytes=%lu row_bytes=%lu row_count=%lu avg_txn_bytes=%.1f avg_row_bytes=%.1f "
+        "epoch_end=%lu epoch_end_bytes=%lu hello=%lu txn_req=%lu",
+        wire_txn,
+        wire_bytes,
+        row_bytes,
+        row_count,
+        wire_txn > 0 ? (static_cast<double>(wire_bytes) / static_cast<double>(wire_txn)) : 0.0,
+        row_count > 0 ? (static_cast<double>(row_bytes) / static_cast<double>(row_count)) : 0.0,
+        perf->zmq_epoch_end_send_count.load(std::memory_order_relaxed),
+        perf->zmq_epoch_end_send_bytes.load(std::memory_order_relaxed),
+        perf->zmq_hello_send_count.load(std::memory_order_relaxed),
+        perf->zmq_txn_req_send_count.load(std::memory_order_relaxed));
+    securec_check_ss(rc, "\0", "\0");
+    EpochPerfAppendLine(fp, buf);
+
+    rc = snprintf_s(buf,
+        sizeof(buf),
+        sizeof(buf) - 1,
+        "  ZMQ_RECV wire_txn=%lu wire_bytes=%lu epoch_end=%lu",
+        perf->zmq_wire_recv_count.load(std::memory_order_relaxed),
+        perf->zmq_wire_recv_bytes.load(std::memory_order_relaxed),
+        perf->zmq_epoch_end_recv_count.load(std::memory_order_relaxed));
+    securec_check_ss(rc, "\0", "\0");
+    EpochPerfAppendLine(fp, buf);
+
+    uint64_t adv_try = perf->logical_advance_try.load(std::memory_order_relaxed);
+    uint64_t adv_ok = perf->logical_advance_ok.load(std::memory_order_relaxed);
+    rc = snprintf_s(buf,
+        sizeof(buf),
+        sizeof(buf) - 1,
+        "  LOGICAL advance_try=%lu advance_ok=%lu ok_rate=%.4f worker_poll=%lu physical_advance=%lu seal_ok=%lu",
+        adv_try,
+        adv_ok,
+        adv_try > 0 ? (static_cast<double>(adv_ok) / static_cast<double>(adv_try)) : 0.0,
+        perf->worker_poll_count.load(std::memory_order_relaxed),
+        perf->physical_advance_count.load(std::memory_order_relaxed),
+        perf->seal_ok_count.load(std::memory_order_relaxed));
+    securec_check_ss(rc, "\0", "\0");
+    EpochPerfAppendLine(fp, buf);
+
+    rc = snprintf_s(buf,
+        sizeof(buf),
+        sizeof(buf) - 1,
+        "  STALL peer_nc=%lu peer_lag=%lu phys=%lu recv=%lu merge=%lu local_cmt=%lu send=%lu reseal=%lu cmt_path=%lu record=%lu",
+        perf->stall_peer_not_connected.load(std::memory_order_relaxed),
+        perf->stall_peer_lag.load(std::memory_order_relaxed),
+        perf->stall_physical_not_ready.load(std::memory_order_relaxed),
+        perf->stall_recv_incomplete.load(std::memory_order_relaxed),
+        perf->stall_merge_incomplete.load(std::memory_order_relaxed),
+        perf->stall_local_commit_pending.load(std::memory_order_relaxed),
+        perf->stall_send_incomplete.load(std::memory_order_relaxed),
+        perf->stall_reseal_pending.load(std::memory_order_relaxed),
+        perf->stall_commit_path_incomplete.load(std::memory_order_relaxed),
+        perf->stall_record_incomplete.load(std::memory_order_relaxed));
+    securec_check_ss(rc, "\0", "\0");
+    EpochPerfAppendLine(fp, buf);
+
+    rc = snprintf_s(buf,
+        sizeof(buf),
+        sizeof(buf) - 1,
+        "  SEAL_BLOCK phys_delay=%lu peer_lag=%lu exec=%lu chg_set=%lu epoch_active=%lu peer_txn=%lu",
+        perf->seal_block_physical_delay.load(std::memory_order_relaxed),
+        perf->seal_block_peer_lag.load(std::memory_order_relaxed),
+        perf->seal_block_exec_pending.load(std::memory_order_relaxed),
+        perf->seal_block_change_set_pending.load(std::memory_order_relaxed),
+        perf->seal_block_epoch_active.load(std::memory_order_relaxed),
+        perf->seal_block_peer_txn_pending.load(std::memory_order_relaxed));
+    securec_check_ss(rc, "\0", "\0");
+    EpochPerfAppendLine(fp, buf);
+
+    uint32_t total = EpochGetTotalNodes();
+    for (uint32_t peer = 0; peer < total; ++peer) {
+        if (peer == self) {
+            continue;
+        }
+        uint64_t peer_pack = 0;
+        uint64_t peer_should = 0;
+        uint64_t peer_rcv = 0;
+        for (uint64_t epoch = (logical > 8 ? logical - 8 : 1); epoch <= logical; ++epoch) {
+            peer_pack += E_NodeManager::GetLocalPackTxnCounters(epoch, peer);
+            peer_should += E_NodeManager::GetStoreShouldReceivedPackCounters(epoch, peer);
+            peer_rcv += E_NodeManager::GetStoreReceivedPackCounters(epoch, peer);
+        }
+        rc = snprintf_s(buf,
+            sizeof(buf),
+            sizeof(buf) - 1,
+            "  PEER peer=%u recent_pack=%lu should_rcv=%lu rcv=%lu peer_max_sealed=%lu",
+            peer,
+            peer_pack,
+            peer_should,
+            peer_rcv,
+            EpochGetPeerMaxSealedEpoch(peer));
+        securec_check_ss(rc, "\0", "\0");
+        EpochPerfAppendLine(fp, buf);
+    }
+
+    EpochPerfAppendLine(fp, "");
+    fclose(fp);
+}
diff --git a/src/epoch/e_pipeline.cpp b/src/epoch/e_pipeline.cpp
new file mode 100644
index 0000000..669ae18
--- /dev/null
+++ b/src/epoch/e_pipeline.cpp
@@ -0,0 +1,793 @@
+#include "postgres.h"
+
+#include "epoch/e_pipeline.h"
+#include "epoch/e_dyn_net.h"
+#include "epoch/e_apply.h"
+#include "epoch/e_abort_csn.h"
+#include "epoch/e_config.h"
+#include "epoch/e_crdt.h"
+#include "epoch/e_epoch.h"
+#include "epoch/e_net.h"
+#include "epoch/e_node_manager.h"
+#include "epoch/e_statistician.h"
+#include "epoch/e_trace.h"
+#include "epoch/e_shmem.h"
+#include "epoch/e_txn_queue.h"
+#include "epoch/e_txn_wire.h"
+#include "epoch/e_wire_envelope.h"
+#include "epoch/e_perf.h"
+
+#include "dn_api.h"
+#include "dn_config.h"
+#include "dn_types.h"
+#include "occ/o_staging.h"
+
+#include "neu_concurrency_tools/blockingconcurrentqueue.h"
+
+#include <mutex>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+#include <algorithm>
+
+static moodycamel::BlockingConcurrentQueue<std::string> g_local_wire_queue;
+static std::unordered_map<uint64_t, E_CrdtMerger> g_epoch_mergers;
+static std::mutex g_merger_mutex;
+static std::unordered_map<uint64_t, std::unordered_set<uint64_t>> g_seen_remote_txns;
+/* 按 epoch/peer 累计已收 wire txn；slot 被 Clear 后 dedupe 不重计，靠此恢复 received */
+static std::unordered_map<uint64_t, std::array<uint64_t, EPOCH_MAX_NODES>> g_peer_received_counts;
+
+struct EpochWireCacheSlot {
+    uint64_t epoch_id;
+    std::vector<std::string> wires;
+};
+
+static std::vector<EpochWireCacheSlot> g_wire_cache;
+static std::mutex g_wire_cache_mutex;
+
+static void EpochWireCacheInit(void)
+{
+    uint32_t slots = EpochGetCacheSlots();
+    if (slots == 0) {
+        slots = EPOCH_DEFAULT_CACHE_SLOTS;
+    }
+    std::lock_guard<std::mutex> lock(g_wire_cache_mutex);
+    g_wire_cache.assign(slots, EpochWireCacheSlot{0, {}});
+}
+
+static void EpochWireCacheStore(uint64_t epoch, const std::string& wire)
+{
+    std::lock_guard<std::mutex> lock(g_wire_cache_mutex);
+    uint32_t slots = EpochGetCacheSlots();
+    if (slots == 0) {
+        slots = EPOCH_DEFAULT_CACHE_SLOTS;
+    }
+    uint32_t slot = static_cast<uint32_t>(epoch % slots);
+    if (slot >= g_wire_cache.size()) {
+        return;
+    }
+    EpochWireCacheSlot& cache_slot = g_wire_cache[slot];
+    if (cache_slot.epoch_id != epoch) {
+        cache_slot.epoch_id = epoch;
+        cache_slot.wires.clear();
+    }
+    cache_slot.wires.push_back(wire);
+}
+
+void EpochPipelineResyncPeerReceived(uint64_t epoch, uint32_t from_node)
+{
+    if (from_node >= EPOCH_MAX_NODES) {
+        return;
+    }
+    auto it = g_peer_received_counts.find(epoch);
+    if (it == g_peer_received_counts.end()) {
+        return;
+    }
+    uint64_t tracked = it->second[from_node];
+    uint64_t current = E_NodeManager::GetStoreReceivedPackCounters(epoch, from_node);
+    if (tracked > current) {
+        E_NodeManager::SetStoreReceivedPackCounters(epoch, from_node, tracked);
+    }
+}
+
+void EpochPipelineRebroadcastCachedTxns(uint64_t epoch)
+{
+    std::vector<std::string> copy;
+    {
+        std::lock_guard<std::mutex> lock(g_wire_cache_mutex);
+        if (g_wire_cache.empty()) {
+            return;
+        }
+        uint32_t slots = EpochGetCacheSlots();
+        if (slots == 0) {
+            slots = EPOCH_DEFAULT_CACHE_SLOTS;
+        }
+        uint32_t slot = static_cast<uint32_t>(epoch % slots);
+        if (slot >= g_wire_cache.size()) {
+            return;
+        }
+        const EpochWireCacheSlot& cache_slot = g_wire_cache[slot];
+        if (cache_slot.epoch_id != epoch || cache_slot.wires.empty()) {
+            return;
+        }
+        copy = cache_slot.wires;
+    }
+    for (const auto& wire : copy) {
+        E_WireTxn txn;
+        if (E_WireDeserializeTxn(wire.data(), wire.size(), &txn)) {
+            (void)EpochPipelinePublishWire(wire, txn);
+        } else {
+            (void)EpochNetPublish(wire);
+        }
+    }
+}
+
+bool EpochPipelineHasWireCache(uint64_t epoch)
+{
+    std::lock_guard<std::mutex> lock(g_wire_cache_mutex);
+    if (g_wire_cache.empty()) {
+        return false;
+    }
+    uint32_t slots = EpochGetCacheSlots();
+    if (slots == 0) {
+        slots = EPOCH_DEFAULT_CACHE_SLOTS;
+    }
+    uint32_t slot = static_cast<uint32_t>(epoch % slots);
+    if (slot >= g_wire_cache.size()) {
+        return false;
+    }
+    const EpochWireCacheSlot& cache_slot = g_wire_cache[slot];
+    return cache_slot.epoch_id == epoch && !cache_slot.wires.empty();
+}
+
+uint64_t EpochPipelineCachedPackCount(uint64_t epoch)
+{
+    std::lock_guard<std::mutex> lock(g_wire_cache_mutex);
+    if (g_wire_cache.empty()) {
+        return 0;
+    }
+    uint32_t slots = EpochGetCacheSlots();
+    if (slots == 0) {
+        slots = EPOCH_DEFAULT_CACHE_SLOTS;
+    }
+    uint32_t slot = static_cast<uint32_t>(epoch % slots);
+    if (slot >= g_wire_cache.size()) {
+        return 0;
+    }
+    const EpochWireCacheSlot& cache_slot = g_wire_cache[slot];
+    if (cache_slot.epoch_id != epoch) {
+        return 0;
+    }
+    return cache_slot.wires.size();
+}
+
+void EpochPipelineInit(void)
+{
+    g_epoch_mergers.clear();
+    g_seen_remote_txns.clear();
+    EpochWireCacheInit();
+    if (g_enable_epoch_multimaster) {
+        /* worker 线程需 reattach 共享内存中的静态指针 */
+        EpochShmemInit();
+        EpochTxnQueueShmemInit(EPOCH_TXN_QUEUE_CAPACITY);
+    }
+    (void)EpochNetInit();
+}
+
+void EpochPipelineShutdown(void)
+{
+    OccStagingModuleShutdown();
+    EpochNetShutdown();
+    std::lock_guard<std::mutex> lock(g_merger_mutex);
+    g_epoch_mergers.clear();
+    g_seen_remote_txns.clear();
+}
+
+static bool EpochWireIsEpochEnd(const E_WireTxn& txn)
+{
+    return txn.start_epoch == 0 && txn.rows.empty() &&
+           txn.csn != EPOCH_WIRE_TXN_REQUEST_CSN;
+}
+
+static bool EpochWireIsTxnRequest(const E_WireTxn& txn)
+{
+    return txn.start_epoch == 0 && txn.rows.empty() &&
+           txn.csn == EPOCH_WIRE_TXN_REQUEST_CSN && txn.commit_epoch > 0;
+}
+
+static bool EpochPipelineMergeWireTxn(const E_WireTxn& txn);
+static bool EpochPipelineAllNodesSendCompleted(uint64_t epochId);
+static void EpochPipelineMaybeResealEpoch(uint64_t epoch);
+
+static void EpochPipelineRecordMergeAborts(uint64_t epoch, const E_WireTxn& txn,
+    const E_CrdtMergeOutcome& outcome)
+{
+    for (const auto& aborted : outcome.aborted_txns) {
+        EpochAbortCsnInsert(epoch, aborted.first, aborted.second);
+    }
+    /* GeoGauss MergeThread: if (!result) abort_transcation_csn_set.insert(csn_temp, csn_temp) */
+    if (!outcome.txn_accepted) {
+        EpochAbortCsnInsert(epoch, txn.csn, txn.server_id);
+    }
+}
+
+static void EpochPipelineDrainLocalQueue(void)
+{
+    char buffer[EPOCH_MAX_WIRE_TXN_BYTES];
+    uint32_t len = 0;
+    while (EpochTxnQueuePop(buffer, sizeof(buffer), &len)) {
+        std::string wire(buffer, buffer + len);
+        E_WireTxn txn;
+        if (!E_WireDeserializeTxn(wire.data(), wire.size(), &txn)) {
+            continue;
+        }
+
+        if (EpochGetTotalNodes() <= 1) {
+            if (EpochWireIsEpochEnd(txn)) {
+                continue;
+            }
+            /* 本地已在 backend 经 O_RecordCommit 落盘，仅推进 epoch 计数 */
+            E_NodeManager::IncCommittedTxnCounters(txn.commit_epoch, EpochGetNodeId());
+            continue;
+        }
+
+        if (EpochWireIsEpochEnd(txn)) {
+            (void)EpochPipelinePublishWire(wire, txn);
+            EpochPerfNoteEpochEndSend(wire.size());
+            continue;
+        }
+        EpochWireCacheStore(txn.commit_epoch, wire);
+        EpochPipelineMergeWireTxn(txn);
+        EpochWireDiagLogTxnSend(txn);
+        (void)EpochPipelinePublishWire(wire, txn);
+        EpochPerfNoteWireTxnSend(txn, wire.size());
+        EpochPipelineMaybeResealEpoch(txn.commit_epoch);
+    }
+}
+
+static bool EpochPipelineMergeWireTxn(const E_WireTxn& txn)
+{
+    /*
+     * merge 只在内存里做 CRDT 合并。算 pk_key 时会 heap_open 读 catalog，
+     * epoch worker 里不需要也不应该包一层事务——无写操作，Commit 会走
+     * after-trigger 提交流程并在 replica 下断言失败（trigger.cpp:4697）。
+     */
+    bool any_new = false;
+    uint64_t dedupe_key = txn.csn ^ (static_cast<uint64_t>(txn.server_id) << 48);
+    std::lock_guard<std::mutex> lock(g_merger_mutex);
+    g_seen_remote_txns[txn.commit_epoch].insert(dedupe_key);
+    E_CrdtMerger& merger = g_epoch_mergers[txn.commit_epoch];
+    E_CrdtMergeOutcome outcome = merger.MergeWireTxn(txn);
+    EpochPipelineRecordMergeAborts(txn.commit_epoch, txn, outcome);
+    if (outcome.txn_accepted) {
+        for (const auto& row : txn.rows) {
+            if (row.op_type != EPOCH_OP_READ) {
+                any_new = true;
+                break;
+            }
+        }
+    }
+    if (any_new) {
+        E_NodeManager::IncMergedTxnCounters(txn.commit_epoch, EpochGetNodeId());
+    }
+    return any_new;
+}
+
+static void EpochPipelineOnRemoteTxnReceived(const E_WireTxn& txn)
+{
+    uint64_t epoch = txn.commit_epoch;
+    uint32_t from_node = txn.server_id;
+
+    if (EpochDynNetProxyEnabled()) {
+        EpochDynNetRecordWireForProxy(txn, static_cast<int32_t>(from_node));
+    }
+
+    uint64_t dedupe_key = txn.csn ^ (static_cast<uint64_t>(txn.server_id) << 48);
+    bool any_new = false;
+    {
+        std::lock_guard<std::mutex> lock(g_merger_mutex);
+        std::unordered_set<uint64_t>& seen = g_seen_remote_txns[epoch];
+        if (!seen.insert(dedupe_key).second) {
+            return;
+        }
+        E_CrdtMerger& merger = g_epoch_mergers[epoch];
+        E_CrdtMergeOutcome outcome = merger.MergeWireTxn(txn);
+        EpochPipelineRecordMergeAborts(epoch, txn, outcome);
+        if (outcome.txn_accepted) {
+            for (const auto& row : txn.rows) {
+                if (row.op_type != EPOCH_OP_READ) {
+                    any_new = true;
+                    break;
+                }
+            }
+        }
+        if (any_new) {
+            E_NodeManager::IncMergedTxnCounters(epoch, EpochGetNodeId());
+        }
+    }
+    /*
+     * epoch-end 的 should_receive 按 pack 计数；须对每个唯一远端 wire 计 receive，
+     * 不能仅在 CRDT 接受行时计数，否则 merge 输家/空事务会导致 recv 永不完 → logical 卡死。
+     */
+    E_NodeManager::UpdateStoreReceivedPackCounters(epoch, from_node, 1);
+    g_peer_received_counts[epoch][from_node]++;
+    EpochWireDiagLogTxnRecv(txn);
+    (void)EpochCheckAndSetNodeReceiveCompleted(epoch, from_node);
+    EpochTraceMaybeLogPeerReceived(epoch);
+    EpochDynNetMaybeEmitProxySnapshot(epoch);
+}
+
+static void EpochPipelineTryEnterRemoteExecPhase(void)
+{
+    if (EpochGetTotalNodes() <= 1) {
+        return;
+    }
+
+    uint64_t target = E_NodeManager::GetLogicalEpoch();
+    if (!EpochPipelineAllNodesSendCompleted(target)) {
+        return;
+    }
+    if (!EpochIsAllPeersReceiveCompleted(target)) {
+        return;
+    }
+    if (E_NodeManager::IsRemoteExeced()) {
+        return;
+    }
+
+    /*
+     * GeoGauss 在 merge 全部完成、进入 commit 阶段 SetRemoteExeced(true)。
+     * 只检查对端 recv（本端 seal 后才 recv_done）；勿置 record_committed=false，
+     * 否则 START gate 阻塞新连接。
+     */
+    E_NodeManager::SetRemoteExeced(true);
+}
+
+static void EpochPipelineTrySignalRemoteRecordCommitted(void)
+{
+    if (EpochGetTotalNodes() <= 1) {
+        return;
+    }
+    if (!E_NodeManager::IsRemoteExeced()) {
+        return;
+    }
+
+    uint64_t target = E_NodeManager::GetLogicalEpoch();
+    uint64_t merged = E_NodeManager::GetMergedTxnCounters(target, EpochGetNodeId());
+    uint64_t committed = E_NodeManager::GetCommittedTxnCounters(target, EpochGetNodeId());
+    if (merged > committed) {
+        return;
+    }
+    /* GeoGauss：merge apply 完成且 commit 路径就绪后，END 路径可继续 */
+    if (!EpochIsRemoteMergeReady(target)) {
+        return;
+    }
+    E_NodeManager::SetRemoteRecordCommitted(true);
+}
+
+static void EpochPipelineConsumeRemote(void)
+{
+    std::string wire;
+
+    if (EpochDynNetIsEnabled()) {
+        while (EpochDynNetTryReceive(&wire)) {
+            E_WireTxn txn;
+            if (!E_WireDeserializeTxn(wire.data(), wire.size(), &txn)) {
+                continue;
+            }
+            if (EpochWireIsTxnRequest(txn)) {
+                EpochMarkPeerConnected(txn.server_id);
+                EpochHandleTxnRequest(txn);
+                continue;
+            }
+            if (EpochWireIsEpochEnd(txn)) {
+                if (txn.commit_epoch == 0) {
+                    EpochRecvDiagLogHello("RECV_HELLO", txn.server_id);
+                    if (txn.server_id != EpochGetNodeId() && txn.server_id < EpochGetTotalNodes()) {
+                        bool was_connected = EpochPeerIsConnected(txn.server_id);
+                        EpochMarkPeerConnected(txn.server_id);
+                        if (!was_connected) {
+                            EpochNetPublishHello();
+                        }
+                    }
+                    continue;
+                }
+                EpochMarkPeerConnected(txn.server_id);
+                EpochDynNetObserveEpochEnd(txn.commit_epoch);
+                EpochPerfNoteWireRecv(txn, wire.size());
+                EpochOnEpochEndWireReceived(txn);
+                continue;
+            }
+            if (EpochDynNetIsProxySlowNode()) {
+                continue;
+            }
+            EpochMarkPeerConnected(txn.server_id);
+            EpochDynNetObserveWireTxn(txn);
+            EpochPerfNoteWireRecv(txn, wire.size());
+            EpochPipelineOnRemoteTxnReceived(txn);
+        }
+        return;
+    }
+
+    while (EpochNetTryReceive(&wire, nullptr)) {
+        if (EpochDynNetHandleWireEnvelope(wire)) {
+            continue;
+        }
+        E_WireTxn txn;
+        if (!E_WireDeserializeTxn(wire.data(), wire.size(), &txn)) {
+            continue;
+        }
+        if (EpochWireIsTxnRequest(txn)) {
+            EpochMarkPeerConnected(txn.server_id);
+            EpochHandleTxnRequest(txn);
+            continue;
+        }
+        if (EpochWireIsEpochEnd(txn)) {
+            if (txn.commit_epoch == 0) {
+                EpochRecvDiagLogHello("RECV_HELLO", txn.server_id);
+                if (txn.server_id != EpochGetNodeId() && txn.server_id < EpochGetTotalNodes()) {
+                    bool was_connected = EpochPeerIsConnected(txn.server_id);
+                    EpochMarkPeerConnected(txn.server_id);
+                    /*
+                     * 仅在首次连通时回发 hello，避免双向 SYN-ACK 形成 hello 风暴。
+                     */
+                    if (!was_connected) {
+                        EpochNetPublishHello();
+                    }
+                }
+                continue;
+            }
+            EpochMarkPeerConnected(txn.server_id);
+            EpochDynNetObserveEpochEnd(txn.commit_epoch);
+            EpochPerfNoteWireRecv(txn, wire.size());
+            EpochOnEpochEndWireReceived(txn);
+            continue;
+        }
+        if (EpochDynNetIsProxySlowNode()) {
+            continue;
+        }
+        EpochMarkPeerConnected(txn.server_id);
+        EpochDynNetObserveWireTxn(txn);
+        EpochPerfNoteWireRecv(txn, wire.size());
+        EpochPipelineOnRemoteTxnReceived(txn);
+    }
+}
+
+static void EpochPipelineTryMergeLocal(void)
+{
+    std::string wire;
+    while (g_local_wire_queue.try_dequeue(wire)) {
+        E_WireTxn txn;
+        if (!E_WireDeserializeTxn(wire.data(), wire.size(), &txn)) {
+            continue;
+        }
+        if (EpochWireIsEpochEnd(txn)) {
+            continue;
+        }
+        EpochPipelineMergeWireTxn(txn);
+    }
+}
+
+static bool EpochPipelineEpochReadyToApply(uint64_t epoch)
+{
+    uint64_t merged = E_NodeManager::GetMergedTxnCounters(epoch, EpochGetNodeId());
+    uint64_t committed = E_NodeManager::GetCommittedTxnCounters(epoch, EpochGetNodeId());
+    {
+        std::lock_guard<std::mutex> lock(g_merger_mutex);
+        auto it = g_epoch_mergers.find(epoch);
+        if (it != g_epoch_mergers.end() && !it->second.IsEmpty() &&
+            it->second.HasRemoteRows(EpochGetNodeId())) {
+            return true;
+        }
+    }
+    if (merged > committed) {
+        return true;
+    }
+    if (merged == 0 && committed == 0) {
+        return true;
+    }
+    return false;
+}
+
+static void EpochPipelineMarkEpochCommitted(uint64_t epoch)
+{
+    uint64_t merged = E_NodeManager::GetMergedTxnCounters(epoch, EpochGetNodeId());
+    while (E_NodeManager::GetCommittedTxnCounters(epoch, EpochGetNodeId()) < merged) {
+        E_NodeManager::IncCommittedTxnCounters(epoch, EpochGetNodeId());
+    }
+    if (merged == 0 && E_NodeManager::GetCommittedTxnCounters(epoch, EpochGetNodeId()) == 0) {
+        E_NodeManager::IncCommittedTxnCounters(epoch, EpochGetNodeId());
+        E_NodeManager::IncCommittedTxnCounters(epoch, EpochGetNodeId());
+        /* 空 epoch：用 committed=0 语义，Inc 两次再 Dec 不划算；直接视为已提交 */
+    }
+}
+
+static bool EpochPipelineAllNodesSendCompleted(uint64_t epochId)
+{
+    uint32_t total = EpochGetTotalNodes();
+    for (uint32_t node = 0; node < total; ++node) {
+        if (node == EpochGetNodeId()) {
+            if (!E_NodeManager::IsNodeSendCompleted(epochId, node)) {
+                return false;
+            }
+            continue;
+        }
+        if (!EpochPeerIsConnected(node)) {
+            return false;
+        }
+        if (!E_NodeManager::IsNodeSendCompleted(epochId, node)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static void EpochPipelineTrySignalRemoteMergeReady(void)
+{
+    EpochPipelineTryEnterRemoteExecPhase();
+    EpochPipelineTrySignalRemoteRecordCommitted();
+}
+
+static bool EpochPipelineEpochHasRemoteMergeWork(uint64_t epoch)
+{
+    uint32_t self = EpochGetNodeId();
+    uint32_t total = EpochGetTotalNodes();
+    for (uint32_t n = 0; n < total; ++n) {
+        if (n == self) {
+            continue;
+        }
+        if (E_NodeManager::GetStoreShouldReceivedPackCounters(epoch, n) > 0) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool EpochPipelineEpochRecvReadyForApply(uint64_t epoch)
+{
+    if (EpochIsAsyncMultimasterMode()) {
+        uint32_t self = EpochGetNodeId();
+        uint64_t merged = E_NodeManager::GetMergedTxnCounters(epoch, self);
+        uint64_t committed = E_NodeManager::GetCommittedTxnCounters(epoch, self);
+        if (merged > committed) {
+            return true;
+        }
+    }
+    if (!EpochIsAllPeersReceiveCompleted(epoch)) {
+        return false;
+    }
+    if (EpochPipelineEpochHasRemoteMergeWork(epoch)) {
+        return true;
+    }
+    return EpochIsAllNodesReceiveCompleted(epoch);
+}
+
+static void EpochPipelinePeerRecvSummary(uint64_t epoch, uint64_t* peer_should, uint64_t* peer_rcv)
+{
+    uint32_t self = EpochGetNodeId();
+    uint64_t should = 0;
+    uint64_t rcv = 0;
+    for (uint32_t n = 0; n < EpochGetTotalNodes(); ++n) {
+        if (n == self) {
+            continue;
+        }
+        should += E_NodeManager::GetStoreShouldReceivedPackCounters(epoch, n);
+        rcv += E_NodeManager::GetStoreReceivedPackCounters(epoch, n);
+    }
+    if (peer_should != nullptr) {
+        *peer_should = should;
+    }
+    if (peer_rcv != nullptr) {
+        *peer_rcv = rcv;
+    }
+}
+
+static std::unordered_map<uint64_t, int> g_apply_skip_tick;
+
+static void EpochPipelineMaybeLogApplySkip(uint64_t epoch, const char* reason, uint64_t merged,
+    uint64_t committed, uint64_t peer_should, uint64_t peer_rcv, int has_remote_rows)
+{
+    int& tick = g_apply_skip_tick[epoch];
+    if (++tick % 300 != 1) {
+        return;
+    }
+    EpochRecvDiagLogApplySkip(epoch, reason, merged, committed, peer_should, peer_rcv, has_remote_rows);
+}
+
+static bool EpochPipelineTryApplyOneEpoch(uint64_t target)
+{
+    uint64_t peer_should = 0;
+    uint64_t peer_rcv = 0;
+    EpochPipelinePeerRecvSummary(target, &peer_should, &peer_rcv);
+    uint64_t merged_cnt = E_NodeManager::GetMergedTxnCounters(target, EpochGetNodeId());
+    uint64_t committed_cnt = E_NodeManager::GetCommittedTxnCounters(target, EpochGetNodeId());
+    bool remote_work = EpochPipelineEpochHasRemoteMergeWork(target);
+    int has_remote_rows = 0;
+
+    if (!EpochPipelineEpochRecvReadyForApply(target)) {
+        if (peer_should > 0 || peer_rcv > 0) {
+            EpochPipelineMaybeLogApplySkip(target, "recv_not_ready", merged_cnt, committed_cnt, peer_should,
+                peer_rcv, has_remote_rows);
+        }
+        return false;
+    }
+    if (!EpochPipelineEpochReadyToApply(target)) {
+        EpochPipelineMaybeLogApplySkip(target, "already_committed", merged_cnt, committed_cnt, peer_should,
+            peer_rcv, has_remote_rows);
+        return false;
+    }
+
+    EpochTraceMaybeLogPeerReceived(target);
+    EpochTraceMaybeLogMergeSummary(target, peer_rcv, merged_cnt);
+
+    bool has_rows = false;
+    E_WireTxn merged;
+    {
+        std::lock_guard<std::mutex> lock(g_merger_mutex);
+        auto it = g_epoch_mergers.find(target);
+        if (it != g_epoch_mergers.end() && !it->second.IsEmpty()) {
+            has_remote_rows = it->second.HasRemoteRows(EpochGetNodeId()) ? 1 : 0;
+            has_rows = it->second.BuildMergedTxn(target, 0, EPOCH_MERGED_SERVER_ID, &merged);
+        }
+    }
+
+    if (remote_work && peer_rcv > 0 && !has_rows) {
+        /*
+         * merged 计数含 CRDT 输家/无 heap 行事务时 BuildMergedTxn 为空，但仍须
+         * 对齐 committed，否则 merged>committed 永久 commit_path_incomplete。
+         */
+        if (merged_cnt <= committed_cnt) {
+            const char* issue = (has_remote_rows != 0) ? "build_empty" : "merge_empty";
+            EpochRecvDiagLogApplyIssue(target, issue, merged_cnt, peer_rcv);
+            return false;
+        }
+    } else if (has_rows) {
+        uint64_t row_count = merged.rows.size();
+        bool apply_ok = E_ApplyWireTxn(merged);
+        EpochRecvDiagOnApply(target, row_count, apply_ok);
+        if (!apply_ok && !EpochIsAsyncMultimasterMode()) {
+            return false;
+        }
+    }
+
+    {
+        std::lock_guard<std::mutex> lock(g_merger_mutex);
+        g_epoch_mergers.erase(target);
+    }
+
+    while (E_NodeManager::GetCommittedTxnCounters(target, EpochGetNodeId()) < merged_cnt) {
+        E_NodeManager::IncCommittedTxnCounters(target, EpochGetNodeId());
+    }
+    EpochTraceLogApplyDone(target, merged_cnt);
+    return true;
+}
+
+bool EpochPipelineTryApplyMergedEpoch(uint64_t epoch)
+{
+    if (EpochGetTotalNodes() <= 1) {
+        return true;
+    }
+    /*
+     * 由 TryAdvanceLogical 在 self seal / send 完成后调用：recv 已齐且 physical 已在
+     * advance 入口校验，此处不再挡 physical_delay。
+     */
+    return EpochPipelineTryApplyOneEpoch(epoch);
+}
+
+static bool EpochPipelineTryApplyReadyEpoch(uint64_t epoch)
+{
+    /*
+     * 当前 logical 关窗 epoch 须等 physical delay；已关窗的历史 epoch 只要求 recv 完成即可 apply，
+     * 否则 logical 推进后 merger 被丢弃，对端写入永远无法落盘到本节点。
+     */
+    if (epoch == E_NodeManager::GetLogicalEpoch() && !EpochIsLogicalReady(epoch)) {
+        return false;
+    }
+    return EpochPipelineTryApplyOneEpoch(epoch);
+}
+
+static bool EpochPipelineTryApplyOneReadyEpoch(void)
+{
+    return EpochPipelineTryApplyReadyEpoch(E_NodeManager::GetLogicalEpoch());
+}
+
+static void EpochPipelineApplyReadyEpochs(void)
+{
+    static constexpr int kMaxApplyBatch = 64;
+    for (int batch = 0; batch < kMaxApplyBatch; ++batch) {
+        std::vector<uint64_t> epochs;
+        uint64_t logical = E_NodeManager::GetLogicalEpoch();
+        uint64_t lookback = EpochGetPhysLogicalGapLimit() + 32;
+        if (lookback < 256) {
+            lookback = 256;
+        }
+        uint64_t start = (logical > lookback) ? (logical - lookback) : 1;
+        for (uint64_t epoch = start; epoch <= logical; ++epoch) {
+            epochs.push_back(epoch);
+        }
+        {
+            std::lock_guard<std::mutex> lock(g_merger_mutex);
+            for (const auto& kv : g_epoch_mergers) {
+                epochs.push_back(kv.first);
+            }
+        }
+        std::sort(epochs.begin(), epochs.end());
+        epochs.erase(std::unique(epochs.begin(), epochs.end()), epochs.end());
+
+        bool progress = false;
+        for (uint64_t epoch : epochs) {
+            if (EpochPipelineTryApplyReadyEpoch(epoch)) {
+                progress = true;
+                break;
+            }
+        }
+        if (!progress) {
+            break;
+        }
+    }
+}
+
+static void EpochPipelineMaybeResealEpoch(uint64_t epoch)
+{
+    if (EpochGetTotalNodes() <= 1 || epoch == 0) {
+        return;
+    }
+    uint32_t self = EpochGetNodeId();
+    if (!E_NodeManager::IsNodeSendCompleted(epoch, self)) {
+        return;
+    }
+    EpochMaybeInvalidateStaleSeal(epoch);
+    (void)EpochTrySealEpoch(epoch);
+}
+
+static void EpochPipelineTrySealEpochs(void)
+{
+    if (EpochGetTotalNodes() <= 1) {
+        return;
+    }
+    if (!EpochAllPeersConnected()) {
+        return;
+    }
+
+    uint64_t logical = E_NodeManager::GetLogicalEpoch();
+    EpochMaybeInvalidateStaleSeal(logical);
+    (void)EpochTrySealEpoch(logical);
+    if (logical > 0) {
+        EpochPipelineMaybeResealEpoch(logical - 1);
+    }
+}
+
+void EpochPipelinePoll(void)
+{
+    EpochNetMaybePublishHello();
+    EpochMaybeRequestMissingTxns();
+    EpochPipelineDrainLocalQueue();
+    if (EpochGetTotalNodes() > 1) {
+        EpochPipelineConsumeRemote();
+        EpochPipelineTryMergeLocal();
+        EpochPipelineTrySignalRemoteMergeReady();
+        EpochPipelineTrySealEpochs();
+        EpochPipelineApplyReadyEpochs();
+        EpochPipelineDrainLocalQueue();
+        uint64_t logical = E_NodeManager::GetLogicalEpoch();
+        if (logical > 1) {
+            EpochDynNetGcBeforeEpoch(logical - 1);
+        }
+    } else {
+        EpochPipelineTrySealEpochs();
+    }
+}
+
+void EpochPipelineInjectRemoteWireTxn(const E_WireTxn& txn)
+{
+    EpochMarkPeerConnected(txn.server_id);
+    EpochDynNetObserveWireTxn(txn);
+    EpochPipelineOnRemoteTxnReceived(txn);
+}
+
+bool EpochPipelinePublishWire(const std::string& wire, const E_WireTxn& txn)
+{
+    if (EpochDynNetProxyEnabled()) {
+        return EpochDynNetPublishWireTxn(wire, txn);
+    }
+    return EpochNetPublish(wire);
+}
diff --git a/src/epoch/e_row_key.cpp b/src/epoch/e_row_key.cpp
new file mode 100644
index 0000000..9598b4d
--- /dev/null
+++ b/src/epoch/e_row_key.cpp
@@ -0,0 +1,167 @@
+#include "postgres.h"
+
+#include "epoch/e_row_key.h"
+
+#include "access/heapam.h"
+#include "catalog/pg_namespace.h"
+#include "catalog/pg_type.h"
+#include "utils/lsyscache.h"
+#include "utils/rel.h"
+
+static void E_SetItemPointer(ItemPointer tid, const E_WireRow& row)
+{
+    tid->ip_blkid.bi_hi = row.bi_hi;
+    tid->ip_blkid.bi_lo = row.bi_lo;
+    tid->ip_posid = row.ip_posid;
+}
+
+static void E_AppendDatumToPkKey(Datum value, bool isnull, Oid typeOid, std::string* out)
+{
+    if (isnull) {
+        out->push_back('\0');
+        return;
+    }
+    out->push_back('\1');
+    switch (typeOid) {
+        case INT2OID: {
+            int16 v = DatumGetInt16(value);
+            out->append(reinterpret_cast<const char*>(&v), sizeof(v));
+            break;
+        }
+        case INT4OID: {
+            int32 v = DatumGetInt32(value);
+            out->append(reinterpret_cast<const char*>(&v), sizeof(v));
+            break;
+        }
+        case INT8OID: {
+            int64 v = DatumGetInt64(value);
+            out->append(reinterpret_cast<const char*>(&v), sizeof(v));
+            break;
+        }
+        case BOOLOID: {
+            char v = DatumGetBool(value) ? 1 : 0;
+            out->push_back(v);
+            break;
+        }
+        case TEXTOID:
+        case VARCHAROID: {
+            text* t = DatumGetTextPP(value);
+            int len = VARSIZE_ANY_EXHDR(t);
+            const char* data = VARDATA_ANY(t);
+            uint32_t ulen = static_cast<uint32_t>(len);
+            out->append(reinterpret_cast<const char*>(&ulen), sizeof(ulen));
+            out->append(data, len);
+            break;
+        }
+        default: {
+            int16 typlen = 0;
+            bool typbyval = false;
+            get_typlenbyval(typeOid, &typlen, &typbyval);
+            if (typbyval) {
+                out->append(reinterpret_cast<const char*>(&value), sizeof(Datum));
+            } else if (typlen == -1) {
+                struct varlena* vl = DatumGetByteaPP(value);
+                int len = VARSIZE_ANY(vl);
+                out->append(reinterpret_cast<const char*>(vl), len);
+            } else if (typlen > 0) {
+                out->append(DatumGetPointer(value), typlen);
+            }
+            break;
+        }
+    }
+}
+
+static void E_AppendTidToPkKey(const E_WireRow& row, std::string* out)
+{
+    out->push_back('T');
+    out->append(reinterpret_cast<const char*>(&row.bi_hi), sizeof(row.bi_hi));
+    out->append(reinterpret_cast<const char*>(&row.bi_lo), sizeof(row.bi_lo));
+    out->append(reinterpret_cast<const char*>(&row.ip_posid), sizeof(row.ip_posid));
+}
+
+bool E_HeapTupleFromWireRow(const E_WireRow& row, HeapTuple* out)
+{
+    if (out == nullptr || row.tuple_data.empty()) {
+        return false;
+    }
+    Size allocSize = HEAPTUPLESIZE + row.tuple_data.size();
+    HeapTuple tuple = (HeapTuple)palloc(allocSize);
+    tuple->tupTableType = HEAP_TUPLE;
+    tuple->t_len = row.tuple_data.size();
+    E_SetItemPointer(&tuple->t_self, row);
+    tuple->t_tableOid = row.relid;
+    tuple->t_bucketId = InvalidBktId;
+    HeapTupleSetZeroBase(tuple);
+    tuple->t_data = (HeapTupleHeader)((char*)tuple + HEAPTUPLESIZE);
+    errno_t rc = memcpy_s(tuple->t_data, row.tuple_data.size(), row.tuple_data.data(), row.tuple_data.size());
+    securec_check(rc, "\0", "\0");
+    *out = tuple;
+    return true;
+}
+
+void E_FreeWireHeapTuple(HeapTuple tup)
+{
+    if (tup != nullptr) {
+        pfree(tup);
+    }
+}
+
+bool E_BuildPkKey(Relation rel, HeapTuple tup, std::string* out)
+{
+    if (rel == nullptr || tup == nullptr || out == nullptr) {
+        return false;
+    }
+    out->clear();
+    Oid pkOid = RelationGetPrimaryKeyIndex(rel);
+    if (!OidIsValid(pkOid)) {
+        return false;
+    }
+
+    Relation idxRel = index_open(pkOid, AccessShareLock);
+    TupleDesc heapDesc = RelationGetDescr(rel);
+    int nkeys = IndexRelationGetNumberOfKeyAttributes(idxRel);
+    for (int i = 0; i < nkeys; ++i) {
+        AttrNumber attno = idxRel->rd_index->indkey.values[i];
+        bool isnull = false;
+        Datum value = heap_getattr(tup, attno, heapDesc, &isnull);
+        Oid typeOid = heapDesc->attrs[attno - 1].atttypid;
+        E_AppendDatumToPkKey(value, isnull, typeOid, out);
+    }
+    index_close(idxRel, AccessShareLock);
+    return true;
+}
+
+Oid E_ResolveLocalRelid(const E_WireRow& row)
+{
+    if (!row.relname.empty()) {
+        Oid local = get_relname_relid(row.relname.c_str(), PG_PUBLIC_NAMESPACE);
+        if (OidIsValid(local)) {
+            return local;
+        }
+    }
+    return row.relid;
+}
+
+bool E_BuildPkKeyFromWireRow(uint32_t relid, const E_WireRow& row, std::string* out)
+{
+    if (out == nullptr) {
+        return false;
+    }
+    Oid localRelid = E_ResolveLocalRelid(row);
+    Relation rel = heap_open(localRelid, AccessShareLock);
+    if (rel == nullptr) {
+        return false;
+    }
+    HeapTuple tuple = nullptr;
+    bool ok = false;
+    if (E_HeapTupleFromWireRow(row, &tuple)) {
+        ok = E_BuildPkKey(rel, tuple, out);
+        if (!ok) {
+            E_AppendTidToPkKey(row, out);
+            ok = true;
+        }
+        E_FreeWireHeapTuple(tuple);
+    }
+    heap_close(rel, AccessShareLock);
+    return ok;
+}
diff --git a/src/epoch/e_shmem.cpp b/src/epoch/e_shmem.cpp
new file mode 100644
index 0000000..a6c7ab4
--- /dev/null
+++ b/src/epoch/e_shmem.cpp
@@ -0,0 +1,82 @@
+#include "postgres.h"
+
+#include "epoch/e_shmem.h"
+
+#include "storage/ipc.h"
+#include "storage/shmem.h"
+
+#include <ctime>
+
+static EpochSharedState* g_epochSharedState = nullptr;
+
+Size EpochShmemSize(void)
+{
+    return sizeof(EpochSharedState);
+}
+
+static void EpochInitCounterBank(EpochCounterBank* bank)
+{
+    for (uint32_t slot = 0; slot < EPOCH_DEFAULT_CACHE_SLOTS; ++slot) {
+        bank->slot_epoch[slot].store(0, std::memory_order_relaxed);
+        for (uint32_t node = 0; node < EPOCH_MAX_NODES; ++node) {
+            bank->change_set_txn[slot][node].store(0, std::memory_order_relaxed);
+            bank->executing_txn[slot][node].store(0, std::memory_order_relaxed);
+            bank->local_produce_txn[slot][node].store(0, std::memory_order_relaxed);
+            bank->local_pack_txn[slot][node].store(0, std::memory_order_relaxed);
+            bank->sealed_pack_txn[slot][node].store(0, std::memory_order_relaxed);
+            bank->local_record_commit_txn[slot][node].store(0, std::memory_order_relaxed);
+            bank->local_record_committed_txn[slot][node].store(0, std::memory_order_relaxed);
+            bank->abort_txn[slot][node].store(0, std::memory_order_relaxed);
+            bank->read_committed_txn[slot][node].store(0, std::memory_order_relaxed);
+            bank->write_abort_after_send_txn[slot][node].store(0, std::memory_order_relaxed);
+            bank->store_should_receive_pack[slot][node].store(0, std::memory_order_relaxed);
+            bank->store_received_pack[slot][node].store(0, std::memory_order_relaxed);
+            bank->merged_txn[slot][node].store(0, std::memory_order_relaxed);
+            bank->committed_txn[slot][node].store(0, std::memory_order_relaxed);
+            bank->node_send_completed[slot][node].store(false, std::memory_order_relaxed);
+            bank->node_receive_completed[slot][node].store(false, std::memory_order_relaxed);
+        }
+    }
+}
+
+void EpochShmemInit(void)
+{
+    bool found = false;
+    g_epochSharedState = static_cast<EpochSharedState*>(
+        ShmemInitStruct("Epoch Shared State", EpochShmemSize(), &found));
+    if (!found) {
+        time_t now = time(nullptr);
+        struct tm tm_buf;
+        (void)localtime_r(&now, &tm_buf);
+        (void)strftime(g_epochSharedState->log_file_stamp,
+            sizeof(g_epochSharedState->log_file_stamp),
+            "%Y%m%d_%H%M%S",
+            &tm_buf);
+        g_epochSharedState->physical_epoch.store(1, std::memory_order_relaxed);
+        /* 与 GeoGauss MOTAdaptor::logical_epoch 初值 1 对齐 */
+        g_epochSharedState->logical_epoch.store(1, std::memory_order_relaxed);
+        g_epochSharedState->record_committed.store(true, std::memory_order_relaxed);
+        g_epochSharedState->remote_record_committed.store(true, std::memory_order_relaxed);
+        g_epochSharedState->remote_execed.store(false, std::memory_order_relaxed);
+        g_epochSharedState->epoch_advance_started.store(false, std::memory_order_relaxed);
+        g_epochSharedState->async_cap_pack_epoch.store(0, std::memory_order_relaxed);
+        g_epochSharedState->async_cap_pack_reserved.store(0, std::memory_order_relaxed);
+        g_epochSharedState->async_cap_pack_blocked_ms.store(0, std::memory_order_relaxed);
+        g_epochSharedState->async_cap_pack_drip_tokens.store(0, std::memory_order_relaxed);
+        g_epochSharedState->async_cap_pack_drip_refill_ms.store(0, std::memory_order_relaxed);
+        g_epochSharedState->async_commit_rate_tokens.store(0, std::memory_order_relaxed);
+        g_epochSharedState->async_commit_rate_last_ms.store(0, std::memory_order_relaxed);
+        EpochInitCounterBank(&g_epochSharedState->counters);
+        EpochAbortCsnBankInit(&g_epochSharedState->abort_csns);
+        for (uint32_t i = 0; i < EPOCH_PERF_GATE_COUNT; ++i) {
+            g_epochSharedState->perf.gate_wait_us[i].store(0, std::memory_order_relaxed);
+            g_epochSharedState->perf.gate_wait_count[i].store(0, std::memory_order_relaxed);
+            g_epochSharedState->perf.gate_spin_count[i].store(0, std::memory_order_relaxed);
+        }
+    }
+}
+
+EpochSharedState* EpochGetSharedState(void)
+{
+    return g_epochSharedState;
+}
diff --git a/src/epoch/e_statistician.cpp b/src/epoch/e_statistician.cpp
new file mode 100644
index 0000000..84a1afc
--- /dev/null
+++ b/src/epoch/e_statistician.cpp
@@ -0,0 +1,1217 @@
+#include "postgres.h"
+
+#include <atomic>
+
+#include "epoch/e_statistician.h"
+#include "epoch/e_config.h"
+#include "epoch/e_node_manager.h"
+#include "epoch/e_types.h"
+#include "epoch/e_net.h"
+#include "epoch/e_pipeline.h"
+#include "epoch/e_txn_wire.h"
+#include "epoch/e_txn_queue.h"
+#include "epoch/e_txn_wire.h"
+#include "epoch/e_trace.h"
+#include "epoch/e_perf.h"
+#include "epoch/e_log_path.h"
+
+#include "miscadmin.h"
+#include "knl/knl_variable.h"
+
+#include <cstdio>
+#include <cstring>
+#include <ctime>
+#include <unordered_map>
+#include <unordered_set>
+
+static uint64_t g_last_diag_physical = 0;
+static std::unordered_map<uint64_t, uint64_t> g_recvdiag_applied_rows;
+static std::unordered_map<uint64_t, uint64_t> g_recvdiag_applied_txns;
+static uint64_t g_recvdiag_last_stall_epoch = 0;
+static uint64_t g_recvdiag_stall_count = 0;
+static std::unordered_map<uint64_t, int> g_txn_request_retry_tick;
+static std::atomic<uint64_t> g_peer_max_sealed_epoch[EPOCH_MAX_NODES] = {};
+
+static uint64_t EpochComputeShouldSend(uint64_t epoch, uint32_t node_id);
+
+bool EpochIsAsyncMultimasterMode(void)
+{
+    return !g_epoch_commit_sync && g_enable_epoch_multimaster && EpochGetTotalNodes() > 1;
+}
+
+uint64_t EpochGetPeerMaxSealedEpoch(uint32_t peer_node)
+{
+    if (peer_node >= EPOCH_MAX_NODES) {
+        return 0;
+    }
+    return g_peer_max_sealed_epoch[peer_node].load(std::memory_order_acquire);
+}
+
+void EpochNotePeerSealedEpoch(uint32_t peer_node, uint64_t epoch)
+{
+    if (peer_node >= EPOCH_MAX_NODES || epoch == 0) {
+        return;
+    }
+    uint64_t cur = g_peer_max_sealed_epoch[peer_node].load(std::memory_order_relaxed);
+    while (epoch > cur &&
+           !g_peer_max_sealed_epoch[peer_node].compare_exchange_weak(
+               cur, epoch, std::memory_order_release, std::memory_order_relaxed)) {
+    }
+}
+
+void EpochRestorePastEpochPeerFlags(uint64_t epoch)
+{
+    if (EpochGetTotalNodes() <= 1 || epoch == 0) {
+        return;
+    }
+    uint64_t logical = E_NodeManager::GetLogicalEpoch();
+    if (epoch >= logical) {
+        return;
+    }
+    uint32_t self = EpochGetNodeId();
+    for (uint32_t node = 0; node < EpochGetTotalNodes(); ++node) {
+        if (node == self) {
+            continue;
+        }
+        E_NodeManager::SetNodeSendCompleted(epoch, node, true);
+        E_NodeManager::SetNodeReceiveCompleted(epoch, node, true);
+    }
+}
+
+/*
+ * 较快节点不可比任一 peer 已 seal 的 epoch 超前太多就关窗，否则 self_send=1 而对端
+ * 永远发不出 peer_send=1 → recv_incomplete 永久成立（本次 epoch=2113 卡死）。
+ */
+static bool EpochSealBlockedByPeerLag(uint64_t epoch, uint32_t node_id)
+{
+    if (EpochGetTotalNodes() <= 1) {
+        return false;
+    }
+    uint32_t total = EpochGetTotalNodes();
+    for (uint32_t peer = 0; peer < total; ++peer) {
+        if (peer == node_id) {
+            continue;
+        }
+        if (!EpochPeerIsConnected(peer)) {
+            continue;
+        }
+        if (E_NodeManager::IsNodeSendCompleted(epoch, peer)) {
+            continue;
+        }
+        uint64_t peer_max = EpochGetPeerMaxSealedEpoch(peer);
+        if (epoch > peer_max + 1) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void EpochRecvDiagAppendLine(const char* line)
+{
+    if (!g_epoch_recv_diag) {
+        return;
+    }
+    char path[MAXPGPATH];
+    if (!EpochFormatLogPath(path, sizeof(path), "epoch_recv_diag")) {
+        return;
+    }
+
+    FILE* fp = fopen(path, "a");
+    if (fp == nullptr) {
+        return;
+    }
+
+    time_t now = time(nullptr);
+    struct tm tm_buf;
+    (void)localtime_r(&now, &tm_buf);
+    char ts[32];
+    (void)strftime(ts, sizeof(ts), "%Y-%m-%d %H:%M:%S", &tm_buf);
+
+    fprintf(fp, "[%s] node=%u %s\n", ts, EpochGetNodeId(), line);
+    (void)fclose(fp);
+}
+
+void EpochWireDiagLogTxnSend(const E_WireTxn& txn)
+{
+    if (!g_enable_epoch_multimaster || EpochGetTotalNodes() <= 1) {
+        return;
+    }
+    if (txn.start_epoch == 0 && txn.rows.empty()) {
+        return;
+    }
+    char buf[192];
+    int rc = snprintf_s(buf,
+        sizeof(buf),
+        sizeof(buf) - 1,
+        "SEND_TXN epoch=%lu csn=%lu from=%u rows=%zu",
+        txn.commit_epoch,
+        txn.csn,
+        txn.server_id,
+        txn.rows.size());
+    securec_check_ss(rc, "\0", "\0");
+    EpochRecvDiagAppendLine(buf);
+}
+
+void EpochWireDiagLogTxnRecv(const E_WireTxn& txn)
+{
+    if (!g_enable_epoch_multimaster || EpochGetTotalNodes() <= 1) {
+        return;
+    }
+    if (txn.start_epoch == 0 && txn.rows.empty()) {
+        return;
+    }
+    char buf[192];
+    int rc = snprintf_s(buf,
+        sizeof(buf),
+        sizeof(buf) - 1,
+        "RECV_TXN epoch=%lu csn=%lu from=%u rows=%zu",
+        txn.commit_epoch,
+        txn.csn,
+        txn.server_id,
+        txn.rows.size());
+    securec_check_ss(rc, "\0", "\0");
+    EpochRecvDiagAppendLine(buf);
+}
+
+void EpochRecvDiagLogHello(const char* tag, uint32_t from_node)
+{
+    if (!g_enable_epoch_multimaster || EpochGetTotalNodes() <= 1 || tag == nullptr) {
+        return;
+    }
+    char buf[64];
+    int rc = snprintf_s(buf, sizeof(buf), sizeof(buf) - 1, "%s from=%u", tag, from_node);
+    securec_check_ss(rc, "\0", "\0");
+    EpochRecvDiagAppendLine(buf);
+}
+
+bool EpochBuildEpochEndWire(uint64_t epoch, E_WireTxn* out)
+{
+    if (out == nullptr) {
+        return false;
+    }
+    out->csn = E_NodeManager::GetLocalPackTxnCounters(epoch, EpochGetNodeId());
+    out->start_epoch = 0;
+    out->commit_epoch = epoch;
+    out->server_id = EpochGetNodeId();
+    out->txn_state = EPOCH_TXN_EMPTY;
+    out->rows.clear();
+    return true;
+}
+
+void EpochOnEpochEndWireReceived(const E_WireTxn& txn)
+{
+    if (txn.start_epoch != 0) {
+        return;
+    }
+    uint64_t epoch = txn.commit_epoch;
+    uint64_t logical = E_NodeManager::GetLogicalEpoch();
+    uint32_t from_node = txn.server_id;
+    /*
+     * 双节点 ZMQ 到达顺序不确定，较快节点可能先把 epoch-end 发到较慢节点尚未关窗的 epoch
+     * （epoch > logical）或已关窗的 epoch（epoch < logical）。
+     * 旧逻辑仅接受 epoch==logical，导致 RECV_FUTURE/RECV_STALE 丢弃对端 seal 信号，
+     * peer_send 永不为 1 → send_incomplete → logical 卡死 → gsql START gate 自旋。
+     * 允许 [logical, logical+1] 的未来一包，以及 epoch<logical 的迟到补录。
+     */
+    if (epoch + 1 < logical) {
+        const char* tag = "RECV_STALE";
+        char buf[160];
+        int rc = snprintf_s(buf,
+            sizeof(buf),
+            sizeof(buf) - 1,
+            "%s epoch=%lu logical=%lu peer=%u pack=%lu",
+            tag,
+            epoch,
+            logical,
+            from_node,
+            txn.csn);
+        securec_check_ss(rc, "\0", "\0");
+        EpochRecvDiagAppendLine(buf);
+    } else if (epoch > logical + EpochGetPhysLogicalGapLimit() + 1) {
+        const char* tag = "RECV_FUTURE";
+        char buf[160];
+        int rc = snprintf_s(buf,
+            sizeof(buf),
+            sizeof(buf) - 1,
+            "%s epoch=%lu logical=%lu peer=%u pack=%lu",
+            tag,
+            epoch,
+            logical,
+            from_node,
+            txn.csn);
+        securec_check_ss(rc, "\0", "\0");
+        EpochRecvDiagAppendLine(buf);
+        return;
+    }
+
+    E_NodeManager::EnsureEpochSlot(epoch);
+    uint64_t pack_count = txn.csn;
+    uint64_t prev_should = E_NodeManager::GetStoreShouldReceivedPackCounters(epoch, from_node);
+    bool already_send = E_NodeManager::IsNodeSendCompleted(epoch, from_node);
+    /*
+     * TXN_REQ 重播 epoch-end 时 send_completed 可能已为 1；若仍 recv 不齐须更新 should_receive
+     * 并重新判定 recv，不能因 early return 丢弃重播。
+     * 本端 reopen seal 后 pack 数增加时，也须用更大的 pack_count 刷新对端 should_receive。
+     */
+    if (already_send && pack_count == prev_should) {
+        EpochPipelineResyncPeerReceived(epoch, from_node);
+        (void)EpochCheckAndSetNodeReceiveCompleted(epoch, from_node);
+        EpochNotePeerSealedEpoch(from_node, epoch);
+        return;
+    }
+    if (already_send && pack_count < prev_should) {
+        EpochPipelineResyncPeerReceived(epoch, from_node);
+        (void)EpochCheckAndSetNodeReceiveCompleted(epoch, from_node);
+        EpochNotePeerSealedEpoch(from_node, epoch);
+        return;
+    }
+
+    E_NodeManager::SetStoreShouldReceivedPackCounters(epoch, from_node, pack_count);
+    /* 对端 epoch-end 的 pack 数同步到本节点视图，便于 seal / logical 推进 */
+    E_NodeManager::SetLocalPackTxnCounters(epoch, from_node, pack_count);
+    E_NodeManager::SetLocalProduceTxnCounters(epoch, from_node, pack_count);
+    E_NodeManager::SetNodeSendCompleted(epoch, from_node, true);
+    /*
+     * 重 seal 抬高 should 时，slot 可能已被 Clear 导致 received 归零，
+     * 但 dedupe 会丢弃重传 txn；用 g_peer_received_counts 恢复 received。
+     */
+    EpochPipelineResyncPeerReceived(epoch, from_node);
+    (void)EpochCheckAndSetNodeReceiveCompleted(epoch, from_node);
+    EpochNotePeerSealedEpoch(from_node, epoch);
+    EpochRecvDiagLogEpochEnd(epoch, from_node, pack_count);
+    EpochTraceMaybeLogPeerReceived(epoch);
+}
+
+bool EpochCheckAndSetNodeReceiveCompleted(uint64_t epochId, uint64_t nodeId)
+{
+    uint64_t should_receive = E_NodeManager::GetStoreShouldReceivedPackCounters(epochId, nodeId);
+    uint64_t received = E_NodeManager::GetStoreReceivedPackCounters(epochId, nodeId);
+    bool done = (should_receive == received);
+    /*
+     * 空 epoch（pack=0）时 should==received==0 不能单独判定完成；
+     * 须等对端真正 seal 并发出 epoch-end（IsNodeSendCompleted）。
+     */
+    if (done && should_receive == 0 && received == 0) {
+        done = E_NodeManager::IsNodeSendCompleted(epochId, nodeId);
+    }
+    E_NodeManager::SetNodeReceiveCompleted(epochId, nodeId, done);
+    return done;
+}
+
+bool EpochIsAllPeersReceiveCompleted(uint64_t epochId)
+{
+    uint32_t self = EpochGetNodeId();
+    uint32_t total = EpochGetTotalNodes();
+    for (uint32_t node = 0; node < total; ++node) {
+        if (node == self) {
+            continue;
+        }
+        if (!EpochPeerIsConnected(node)) {
+            return false;
+        }
+        if (!E_NodeManager::IsNodeReceiveCompleted(epochId, node)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool EpochIsAllNodesReceiveCompleted(uint64_t epochId)
+{
+    if (!E_NodeManager::IsNodeReceiveCompleted(epochId, EpochGetNodeId())) {
+        return false;
+    }
+    return EpochIsAllPeersReceiveCompleted(epochId);
+}
+
+static bool EpochSealEpoch(uint64_t epoch)
+{
+    E_WireTxn end_wire;
+    if (!EpochBuildEpochEndWire(epoch, &end_wire)) {
+        return false;
+    }
+    std::string payload;
+    if (!E_WireSerializeTxn(end_wire, &payload)) {
+        return false;
+    }
+    /* worker 内直接发布 epoch-end，避免仅入队时 drain 滞后一轮 */
+    (void)EpochNetPublish(payload);
+    EpochPerfNoteEpochEndSend(payload.size());
+    if (!EpochTxnQueuePush(payload.data(), static_cast<uint32_t>(payload.size()))) {
+        ereport(WARNING, (errmsg("epoch: failed to enqueue epoch-end marker for epoch %lu", epoch)));
+    }
+    return true;
+}
+
+static uint64_t EpochComputeShouldSend(uint64_t epoch, uint32_t node_id)
+{
+    uint64_t change_set = E_NodeManager::GetChangeSetTxnCounters(epoch, node_id);
+    uint64_t aborts = E_NodeManager::GetAbortTxnCounters(epoch, node_id);
+    uint64_t write_abort_after = E_NodeManager::GetWriteAbortAfterSendTxnCounters(epoch, node_id);
+    uint64_t abort_net = (aborts > write_abort_after) ? (aborts - write_abort_after) : 0;
+    /* change_set 仅 OCC 写事务 COMMIT pack 时 +1；只读不参与 should_send */
+    return (change_set > abort_net) ? (change_set - abort_net) : 0;
+}
+
+/*
+ * 推迟空 seal 仅看本端是否还有未 pack 的写事务。
+ * 对端 wire txn / merge 不能阻止本端 pack=0 关窗，否则双写时 node1 无本地写却
+ * 永远不发 epoch-end → node0 peer_send=0 → recv_incomplete 死锁。
+ */
+static bool EpochShouldDeferEmptySeal(uint64_t epoch, uint32_t node_id)
+{
+    uint64_t should_send = EpochComputeShouldSend(epoch, node_id);
+    uint64_t packed = E_NodeManager::GetLocalPackTxnCounters(epoch, node_id);
+    if (should_send > 0 || packed > 0) {
+        return false;
+    }
+    if (E_NodeManager::GetChangeSetTxnCounters(epoch, node_id) > 0) {
+        return true;
+    }
+    /*
+     * Async 无 WaitForRemoteExeced 互锁：允许空 seal，在途 SQL 后续 pack 触发 re-seal。
+     */
+    if (EpochIsAsyncMultimasterMode()) {
+        return false;
+    }
+    if (E_NodeManager::GetExecutingTxnCounters(epoch, node_id) > 0) {
+        return true;
+    }
+    return false;
+}
+
+/*
+ * 对端已 seal 且本端已收齐该 epoch txn，但对端仍等本端 epoch-end（peer_send=1, peer_recv=1）。
+ * 若本端 should_send=0 却因 executing>0 无法 seal，会形成 recv 互锁；此时强制空 seal，
+ * 在途事务后续 pack 会触发 re-seal。
+ */
+static bool EpochShouldForceEmptySealForPeerHandshake(uint64_t epoch, uint32_t node_id)
+{
+    if (EpochGetTotalNodes() <= 1) {
+        return false;
+    }
+    uint64_t should_send = EpochComputeShouldSend(epoch, node_id);
+    uint64_t packed = E_NodeManager::GetLocalPackTxnCounters(epoch, node_id);
+    if (should_send > 0 || packed > 0) {
+        return false;
+    }
+    if (E_NodeManager::GetChangeSetTxnCounters(epoch, node_id) > 0) {
+        return false;
+    }
+    uint32_t total = EpochGetTotalNodes();
+    bool saw_peer = false;
+    for (uint32_t peer = 0; peer < total; ++peer) {
+        if (peer == node_id || !EpochPeerIsConnected(peer)) {
+            continue;
+        }
+        saw_peer = true;
+        if (!E_NodeManager::IsNodeSendCompleted(epoch, peer)) {
+            return false;
+        }
+        if (!E_NodeManager::IsNodeReceiveCompleted(epoch, peer)) {
+            return false;
+        }
+    }
+    return saw_peer;
+}
+
+void EpochMaybeInvalidateStaleSeal(uint64_t epoch)
+{
+    if (EpochGetTotalNodes() <= 1) {
+        return;
+    }
+    uint32_t node_id = EpochGetNodeId();
+    if (!E_NodeManager::IsNodeSendCompleted(epoch, node_id)) {
+        return;
+    }
+    uint64_t sealed = E_NodeManager::GetSealedPackTxnCounters(epoch, node_id);
+    uint64_t packed = E_NodeManager::GetLocalPackTxnCounters(epoch, node_id);
+    uint64_t should_send = EpochComputeShouldSend(epoch, node_id);
+    /*
+     * 空 seal 后 change_set 增加但尚未 pack 时 packed==sealed==0，须撤销 send 以便 re-seal。
+     */
+    if (should_send > sealed || packed > sealed) {
+        E_NodeManager::SetNodeSendCompleted(epoch, node_id, false);
+        E_NodeManager::SetNodeReceiveCompleted(epoch, node_id, false);
+    }
+}
+
+/*
+ * 关窗前要求本 epoch 无仍在执行 SQL、尚未 pack 读写集的事务。
+ * 不等 OCC produce / END_TRANSACTION。
+ * gap 顶满且 should_send=0 时，若 executing 仍不归零，多为泄漏或已 pack 前释放 executing
+ * 的 backend 异常退出；核销以免 logical 永久卡住。
+ */
+static void EpochMaybeWriteOffStaleExecuting(uint64_t epoch, uint32_t node_id)
+{
+    if (E_NodeManager::GetExecutingTxnCounters(epoch, node_id) == 0) {
+        return;
+    }
+    /*
+     * change_set==0 时尚无 COMMIT pack，executing 表示在途 SQL/尚未 pack 的事务。
+     * 若此时核销 executing，会空 seal 并推进 logical，随后旧 epoch 又补 pack → 双端卡死。
+     */
+    if (E_NodeManager::GetChangeSetTxnCounters(epoch, node_id) == 0) {
+        /*
+         * Async：physical 已顶满 gap 时，泄漏的 executing 会挡住空 epoch seal（epoch=830
+         * exec_pending）；核销以便先跑通 TPCC，在途 SQL 后续 pack 触发 re-seal。
+         */
+        if (EpochIsAsyncMultimasterMode()) {
+            uint64_t physical = E_NodeManager::GetPhysicalEpoch();
+            uint64_t logical = E_NodeManager::GetLogicalEpoch();
+            uint64_t gap = (physical > logical) ? (physical - logical) : 0;
+            if (gap >= EpochGetPhysLogicalGapLimit()) {
+                while (E_NodeManager::GetExecutingTxnCounters(epoch, node_id) > 0) {
+                    E_NodeManager::DecExecutingTxnCounters(epoch, node_id);
+                }
+            }
+        }
+        return;
+    }
+    if (EpochComputeShouldSend(epoch, node_id) > 0) {
+        return;
+    }
+    uint64_t physical = E_NodeManager::GetPhysicalEpoch();
+    uint64_t logical = E_NodeManager::GetLogicalEpoch();
+    uint64_t gap = (physical > logical) ? (physical - logical) : 0;
+    if (gap < EpochGetPhysLogicalGapLimit()) {
+        return;
+    }
+    while (E_NodeManager::GetExecutingTxnCounters(epoch, node_id) > 0) {
+        E_NodeManager::DecExecutingTxnCounters(epoch, node_id);
+    }
+}
+
+static bool EpochSealBlockedByExecuting(uint64_t epoch, uint32_t node_id)
+{
+    if (E_NodeManager::GetExecutingTxnCounters(epoch, node_id) == 0) {
+        return false;
+    }
+    uint64_t should_send = EpochComputeShouldSend(epoch, node_id);
+    uint64_t packed = E_NodeManager::GetLocalPackTxnCounters(epoch, node_id);
+    /*
+     * 本 epoch 写集已 pack 齐 should_send 时，剩余 executing 为在途 SQL；
+     * 继续等待会与 WaitForRemoteExeced 互锁，后续 pack 由 re-seal 补上。
+     */
+    if (should_send > 0 && packed >= should_send) {
+        return false;
+    }
+    /*
+     * Async：无 backend 等 remote_exec，executing 仅表示在途 SQL，不应阻塞空 epoch 关窗。
+     */
+    if (EpochIsAsyncMultimasterMode() && should_send == 0 && packed == 0) {
+        return false;
+    }
+    return true;
+}
+
+static bool EpochShouldForceSealDespiteExecuting(uint64_t epoch, uint32_t node_id)
+{
+    if (EpochSealBlockedByExecuting(epoch, node_id)) {
+        return EpochShouldForceEmptySealForPeerHandshake(epoch, node_id);
+    }
+    return false;
+}
+
+bool EpochLogicalEpochHasPendingPack(uint64_t epoch)
+{
+    if (EpochGetTotalNodes() <= 1) {
+        return false;
+    }
+    uint32_t node_id = EpochGetNodeId();
+    uint64_t should_send = EpochComputeShouldSend(epoch, node_id);
+    if (should_send == 0) {
+        return false;
+    }
+    uint64_t packed = E_NodeManager::GetLocalPackTxnCounters(epoch, node_id);
+    return packed < should_send;
+}
+
+bool EpochTrySealEpoch(uint64_t epoch)
+{
+    if (EpochGetTotalNodes() <= 1) {
+        return false;
+    }
+
+    E_NodeManager::EnsureEpochSlot(epoch);
+
+    uint32_t node_id = EpochGetNodeId();
+    uint64_t packed = E_NodeManager::GetLocalPackTxnCounters(epoch, node_id);
+    uint64_t should_send = EpochComputeShouldSend(epoch, node_id);
+
+    /*
+     * change_set 仅在写 COMMIT pack 时 +1；若已 seal 但 pack 未齐或 pack 数变化，撤销 send 并重 seal。
+     */
+    if (E_NodeManager::IsNodeSendCompleted(epoch, node_id)) {
+        uint64_t sealed = E_NodeManager::GetSealedPackTxnCounters(epoch, node_id);
+        should_send = EpochComputeShouldSend(epoch, node_id);
+        if (packed >= should_send && packed == sealed && should_send == sealed) {
+            return true;
+        }
+        E_NodeManager::SetNodeSendCompleted(epoch, node_id, false);
+        E_NodeManager::SetNodeReceiveCompleted(epoch, node_id, false);
+    }
+
+    uint64_t physical = E_NodeManager::GetPhysicalEpoch();
+    uint32_t delay = static_cast<uint32_t>(g_epoch_delay_slots);
+    if (delay == 0) {
+        delay = EPOCH_DEFAULT_DELAY;
+    }
+    /*
+     * 关窗前等 physical 窗口；若有事务仍在执行且读写集未 pack，则暂不 seal。
+     */
+    if (physical <= epoch + static_cast<uint64_t>(delay) + 1) {
+        EpochRecvDiagLogSealBlock(epoch, "physical_delay");
+        return false;
+    }
+
+    if (EpochSealBlockedByPeerLag(epoch, node_id)) {
+        EpochRecvDiagLogSealBlock(epoch, "peer_lag");
+        return false;
+    }
+
+    EpochMaybeWriteOffStaleExecuting(epoch, node_id);
+
+    bool force_despite_executing = EpochShouldForceSealDespiteExecuting(epoch, node_id);
+    if (EpochSealBlockedByExecuting(epoch, node_id) && !force_despite_executing) {
+        EpochRecvDiagLogSealBlock(epoch, "exec_pending");
+        EpochTraceMaybeLogSealBlocked(epoch, "exec_pending",
+            E_NodeManager::GetExecutingTxnCounters(epoch, node_id),
+            E_NodeManager::GetChangeSetTxnCounters(epoch, node_id),
+            E_NodeManager::GetLocalPackTxnCounters(epoch, node_id));
+        return false;
+    }
+
+    /*
+     * GeoGauss IsCurrentEpochFinished: packed >= should_send
+     */
+    should_send = EpochComputeShouldSend(epoch, node_id);
+    packed = E_NodeManager::GetLocalPackTxnCounters(epoch, node_id);
+
+    if (packed < should_send) {
+        EpochRecvDiagLogSealBlock(epoch, "change_set_pending");
+        return false;
+    }
+
+    if (should_send == 0 && packed == 0 && EpochShouldDeferEmptySeal(epoch, node_id) &&
+        !force_despite_executing) {
+        EpochRecvDiagLogSealBlock(epoch, "epoch_active");
+        return false;
+    }
+
+    /*
+     * 对端 epoch-end 已到但 txn 未收齐时暂不 seal，避免本端先关窗而对端永远 recv 不齐。
+     * 空 epoch 无 epoch-end 前 IsNodeSendCompleted(peer) 为 false，不会误伤启动握手。
+     * 本端已空 seal 但 should_send 已抬高时须优先 re-seal，不可被 peer_txn_pending 挡住。
+     */
+    uint64_t sealed_now = E_NodeManager::GetSealedPackTxnCounters(epoch, node_id);
+    bool self_reseal_needed = (should_send > sealed_now || packed > sealed_now);
+    uint32_t total = EpochGetTotalNodes();
+    if (!self_reseal_needed) {
+        for (uint32_t peer = 0; peer < total; ++peer) {
+            if (peer == node_id || !EpochPeerIsConnected(peer)) {
+                continue;
+            }
+            if (E_NodeManager::IsNodeSendCompleted(epoch, peer) &&
+                !E_NodeManager::IsNodeReceiveCompleted(epoch, peer)) {
+                EpochRecvDiagLogSealBlock(epoch, "peer_txn_pending");
+                return false;
+            }
+        }
+    }
+
+    EpochPipelineRebroadcastCachedTxns(epoch);
+    pg_usleep(500L);
+    EpochPipelineRebroadcastCachedTxns(epoch);
+
+    /* usleep 期间可能有新 change_set / pack，关窗前再核对一次 */
+    should_send = EpochComputeShouldSend(epoch, node_id);
+    packed = E_NodeManager::GetLocalPackTxnCounters(epoch, node_id);
+    if (packed < should_send) {
+        EpochRecvDiagLogSealBlock(epoch, "change_set_pending");
+        return false;
+    }
+    force_despite_executing = EpochShouldForceSealDespiteExecuting(epoch, node_id);
+    if (EpochSealBlockedByExecuting(epoch, node_id) && !force_despite_executing) {
+        EpochRecvDiagLogSealBlock(epoch, "exec_pending");
+        EpochTraceMaybeLogSealBlocked(epoch, "exec_pending",
+            E_NodeManager::GetExecutingTxnCounters(epoch, node_id),
+            E_NodeManager::GetChangeSetTxnCounters(epoch, node_id), packed);
+        return false;
+    }
+
+    EpochTraceLogSealPrepare(epoch, packed);
+
+    if (!EpochSealEpoch(epoch)) {
+        return false;
+    }
+
+    E_NodeManager::SetSealedPackTxnCounters(epoch, node_id, packed);
+    E_NodeManager::SetNodeSendCompleted(epoch, EpochGetNodeId(), true);
+    E_NodeManager::SetNodeReceiveCompleted(epoch, EpochGetNodeId(), true);
+    EpochRecvDiagLogSent(epoch, E_NodeManager::GetLocalPackTxnCounters(epoch, EpochGetNodeId()));
+    EpochPerfNoteSealOk();
+    return true;
+}
+
+void EpochMaybeRequestMissingTxns(void)
+{
+    if (!g_enable_epoch_multimaster || EpochGetTotalNodes() <= 1 || !EpochAllPeersConnected()) {
+        return;
+    }
+    uint64_t logical = E_NodeManager::GetLogicalEpoch();
+    uint32_t self = EpochGetNodeId();
+    uint32_t total = EpochGetTotalNodes();
+    uint64_t lookback = EpochGetPhysLogicalGapLimit() + 64;
+    uint64_t start = (logical > lookback) ? (logical - lookback) : 1;
+    uint64_t request_epoch = 0;
+    uint32_t request_peer = self;
+    for (uint32_t peer = 0; peer < total; ++peer) {
+        if (peer == self) {
+            continue;
+        }
+        uint64_t peer_max = EpochGetPeerMaxSealedEpoch(peer);
+        for (uint64_t epoch = start; epoch <= logical; ++epoch) {
+            if (E_NodeManager::IsNodeReceiveCompleted(epoch, peer)) {
+                continue;
+            }
+            if (epoch < peer_max) {
+                EpochRestorePastEpochPeerFlags(epoch);
+                continue;
+            }
+            if (request_epoch == 0 || epoch < request_epoch) {
+                request_epoch = epoch;
+                request_peer = peer;
+            }
+            break;
+        }
+    }
+    if (request_epoch == 0) {
+        return;
+    }
+    static int tick = 0;
+    if (++tick % 50 != 0) {
+        return;
+    }
+    /*
+     * GeoGauss mot_internal.cpp: cache_txn_request / server_txn_request：
+     * 对端 pack 未收齐时主动请求，由 EpochHandleTxnRequest 重放 cache + epoch-end。
+     */
+    EpochPublishTxnRequest(request_epoch);
+    char buf[96];
+    int rc = snprintf_s(buf, sizeof(buf), sizeof(buf) - 1,
+        "TXN_REQ_SENT epoch=%lu peer=%u", request_epoch, request_peer);
+    securec_check_ss(rc, "\0", "\0");
+    EpochRecvDiagAppendLine(buf);
+}
+
+void EpochOnPeerConnected(uint32_t peerId)
+{
+    if (peerId == EpochGetNodeId() || EpochGetTotalNodes() <= 1) {
+        return;
+    }
+    /*
+     * GeoGauss 不在上线时主动重播 epoch；缺包由对端发 cache_txn_request 拉取。
+     */
+}
