+uint32_t E_NodeManager::GetSlot(uint64_t epochId)
+{
+    uint32_t slots = EpochGetCacheSlots();
+    if (slots == 0) {
+        return 0;
+    }
+    return static_cast<uint32_t>(epochId % slots);
+}
