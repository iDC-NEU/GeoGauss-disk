+        uint32_t slot = GetSlot(epochId);                                                  \
+        if (!EpochSlotIsCurrent(state, epochId, slot)) {                                   \
+            return 0;                                                                      \
+        }                                                                                  \
+        uint32_t node = static_cast<uint32_t>(nodeId);                                     \
+        if (node >= EPOCH_MAX_NODES) {                                                     \
+            node = EPOCH_MAX_NODE_ID;                                                      \
+        }                                                                                  \
+        return state->counters.field[slot][node] op;                                       \
+    }
