+++ b/src/occ-opt/o_staging_api.h
@@ -0,0 +1,69 @@
+//
+// Unified facade for version staging hash table (occ-opt).
+//
+// Integration points (not wired yet — call from occ/ when ready):
+//   - O_StagingStageCommit()  replaces immediate heap write in O_Access::WriteGlobalChanges
+//   - O_StagingTryRead()      called from occ_sentinel / O_TxnAccess read path
+//   - O_StagingCheckVersion() called from OccTransactionManager validation
+//   - O_StagingFlusherTick()  driven by postmaster or bgworker
+//
+
+#ifndef OCC_OPT_O_STAGING_API_H
+#define OCC_OPT_O_STAGING_API_H
+
+#include "o_staging_types.h"
+#include "occ/o_global.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+void O_StagingInit(const O_StagingConfig *config);
+void O_StagingShutdown();
+
+bool O_StagingEnabled();
+void O_StagingSetEnabled(bool enabled);
+
+const O_StagingConfig &O_StagingGetConfig();
+void O_StagingSetConfig(const O_StagingConfig &config);
+
+void O_StagingSetFlushCallbacks(const O_StagingFlushCallbacks &callbacks);
+
+/*
+ * Write path: stage committed version after OCC validation.
+ * Does NOT write heap page — deferred write-back handles persistence.
+ */
+bool O_StagingStageCommit(Relation relation, ItemPointer tid, HeapTuple tuple, uint64_t csn,
+                          AccessType access_type);
+
+/*
+ * Read path: consult staging table before heap.
+ */
+bool O_StagingTryRead(Relation relation, ItemPointer tid, O_StagingLookupResult &result);
+
+HeapTuple O_StagingReadCopyTuple(Relation relation, ItemPointer tid);
+
+/*
+ * Validation: compare expected CSN against staged version (if present).
+ * Returns true when no staged entry exists (caller should fall back to heap check).
+ */
+bool O_StagingHasEntry(Relation relation, ItemPointer tid);
+bool O_StagingCheckVersion(Relation relation, ItemPointer tid, uint64_t expected_csn,
+                           bool check_latest);
+
+/*
+ * Flush / maintenance
+ */
+size_t O_StagingFlushPage(Oid relid, BlockNumber block);
+size_t O_StagingFlushAll();
+void O_StagingFlusherTick();
+void O_StagingStartBackgroundFlusher();
+void O_StagingStopBackgroundFlusher();
+
+O_StagingStats O_StagingGetStats();
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* OCC_OPT_O_STAGING_API_H */
diff --git a/src/occ-opt/o_staging_flush.cpp b/src/occ-opt/o_staging_flush.cpp
new file mode 100644
index 0000000..d68b83d
--- /dev/null
+++ b/src/occ-opt/o_staging_flush.cpp
@@ -0,0 +1,126 @@
+//
+// Deferred write-back implementation.
+//
+
+#include "o_staging_flush.h"
+#include "o_staging_table.h"
+#include "o_dirty_page_tracker.h"
+
+#include "access/heapam.h"
+#include "utils/rel.h"
+
+O_StagingFlush &O_StagingFlush::Instance()
+{
+    static O_StagingFlush instance;
+    return instance;
+}
+
+O_StagingFlush::O_StagingFlush()
+{
+    m_callbacks.write_tuple = DefaultNoOpWrite;
+}
+
+void O_StagingFlush::SetCallbacks(const O_StagingFlushCallbacks &callbacks)
+{
+    std::lock_guard<std::mutex> lock(m_callbackMutex);
+    m_callbacks = callbacks;
+    if (!m_callbacks.write_tuple) {
+        m_callbacks.write_tuple = DefaultNoOpWrite;
+    }
+}
+
+bool O_StagingFlush::DefaultNoOpWrite(Relation relation, ItemPointer tid, HeapTuple tuple,
+                                      uint64_t csn, bool deleted)
+{
+    (void)relation;
+    (void)tid;
+    (void)tuple;
+    (void)csn;
+    (void)deleted;
+    return true;
+}
+
+size_t O_StagingFlush::FlushPage(Oid relid, BlockNumber block)
+{
+    O_StagingTable &staging = O_StagingTable::Instance();
+    O_DirtyPageTracker &tracker = O_DirtyPageTracker::Instance();
+
+    std::vector<std::pair<O_StagingKey, O_StagingEntry>> entries;
+    staging.CollectPageEntries(relid, block, entries);
+    if (entries.empty()) {
+        O_StagingPageKey pageKey;
+        pageKey.relid = relid;
+        pageKey.block = block;
+        tracker.ClearPage(pageKey);
+        return 0;
+    }
+
+    Relation rel = heap_open(relid, RowExclusiveLock);
+    if (!RelationIsValid(rel)) {
+        return 0;
+    }
+
+    O_StagingFlushCallbacks callbacks;
+    {
+        std::lock_guard<std::mutex> lock(m_callbackMutex);
+        callbacks = m_callbacks;
+    }
+
+    size_t flushed = 0;
+    size_t failures = 0;
+
+    for (const auto &kv : entries) {
+        ItemPointerData tid;
+        ItemPointerSet(&tid, kv.first.block, kv.first.offset);
+
+        bool ok = false;
+        if (kv.second.deleted) {
+            ok = callbacks.write_tuple(rel, &tid, nullptr, kv.second.csn, true);
+        } else if (kv.second.tuple != nullptr) {
+            ok = callbacks.write_tuple(rel, &tid, kv.second.tuple, kv.second.csn, false);
+        } else {
+            ok = true;
+        }
+
+        if (!ok) {
+            failures++;
+            continue;
+        }
+
+        if (staging.Remove(rel, &tid)) {
+            flushed++;
+        }
+    }
+
+    heap_close(rel, RowExclusiveLock);
+    tracker.RecordFlushed(relid, block, static_cast<uint32_t>(flushed));
+
+    O_StagingStats stats = staging.GetStatsSnapshot();
+    (void)stats;
+    if (failures > 0) {
+        ereport(DEBUG1,
+                (errmsg("O_StagingFlush::FlushPage rel=%u block=%u flushed=%zu failures=%zu",
+                        relid, block, flushed, failures)));
+    }
+
+    return flushed;
+}
+
+size_t O_StagingFlush::FlushAll()
+{
+    O_StagingTable &staging = O_StagingTable::Instance();
+    O_DirtyPageTracker &tracker = O_DirtyPageTracker::Instance();
+
+    std::vector<O_StagingPageKey> pages;
+    tracker.GetAllDirtyPages(pages);
+
+    if (pages.empty()) {
+        return 0;
+    }
+
+    size_t totalFlushed = 0;
+    for (const O_StagingPageKey &pageKey : pages) {
+        totalFlushed += FlushPage(pageKey.relid, pageKey.block);
+    }
+    return totalFlushed;
+}
diff --git a/src/occ-opt/o_staging_flush.h b/src/occ-opt/o_staging_flush.h
