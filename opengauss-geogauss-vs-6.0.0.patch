diff --git a/src/dynamic-net/dn_snapshot_validator.cpp b/src/dynamic-net/dn_snapshot_validator.cpp
new file mode 100644
index 0000000..ffc2cc9
--- /dev/null
+++ b/src/dynamic-net/dn_snapshot_validator.cpp
@@ -0,0 +1,103 @@
+#include "dn_snapshot_validator.h"
+#include "dn_hash.h"
+
+void DnSlowNodeMetadataStore::RecordMetadata(int32_t epoch, int32_t sender_channel, int32_t term,
+                                             uint64_t payload_hash, int32_t payload_size)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    DnEpochMetadata &meta = m_table[epoch][sender_channel];
+    meta.epoch = epoch;
+    meta.received = true;
+    meta.term = term;
+    meta.payload_hash = payload_hash;
+    meta.payload_size = payload_size;
+}
+
+bool DnSlowNodeMetadataStore::HasMetadata(int32_t epoch, int32_t sender_channel) const
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto eit = m_table.find(epoch);
+    if (eit == m_table.end()) {
+        return false;
+    }
+    auto cit = eit->second.find(sender_channel);
+    return cit != eit->second.end() && cit->second.received;
+}
+
+const DnEpochMetadata *DnSlowNodeMetadataStore::GetMetadata(int32_t epoch, int32_t sender_channel) const
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto eit = m_table.find(epoch);
+    if (eit == m_table.end()) {
+        return nullptr;
+    }
+    auto cit = eit->second.find(sender_channel);
+    if (cit == eit->second.end()) {
+        return nullptr;
+    }
+    return &cit->second;
+}
+
+void DnSlowNodeMetadataStore::GcBeforeEpoch(int32_t epoch)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto it = m_table.begin();
+    while (it != m_table.end()) {
+        if (it->first < epoch) {
+            it = m_table.erase(it);
+        } else {
+            ++it;
+        }
+    }
+}
+
+DnSnapshotValidationResult DnSnapshotValidator::Validate(const DnPartialSnapshotMessage &snap,
+                                                         const DnSlowNodeMetadataStore &meta_store,
+                                                         std::vector<DnTransaction> *out_all_txns)
+{
+    if (out_all_txns != nullptr) {
+        out_all_txns->clear();
+    }
+
+    for (const auto &contrib : snap.contributions) {
+        int32_t nid = contrib.origin_node_id;
+        if (!meta_store.HasMetadata(snap.epoch, nid)) {
+            return DnSnapshotValidationResult::MISSING_META;
+        }
+
+        uint64_t reconstructed = 0;
+        for (const auto &txn : contrib.committed_txns) {
+            reconstructed = DnCombineHashes(reconstructed, DnHashTxn(txn));
+            if (out_all_txns != nullptr) {
+                out_all_txns->push_back(txn);
+            }
+        }
+        for (uint64_t dh : contrib.dropped_hashes) {
+            reconstructed = DnCombineHashes(reconstructed, dh);
+        }
+
+        const DnEpochMetadata *meta = meta_store.GetMetadata(snap.epoch, nid);
+        if (meta == nullptr || reconstructed != meta->payload_hash) {
+            return DnSnapshotValidationResult::ORIGIN_HASH_MISMATCH;
+        }
+    }
+
+    if (out_all_txns != nullptr) {
+        uint64_t computed = DnHashMergedTxns(*out_all_txns);
+        if (computed != snap.checksum) {
+            return DnSnapshotValidationResult::GLOBAL_CHECKSUM_MISMATCH;
+        }
+    } else {
+        std::vector<DnTransaction> tmp;
+        for (const auto &contrib : snap.contributions) {
+            for (const auto &txn : contrib.committed_txns) {
+                tmp.push_back(txn);
+            }
+        }
+        if (DnHashMergedTxns(tmp) != snap.checksum) {
+            return DnSnapshotValidationResult::GLOBAL_CHECKSUM_MISMATCH;
+        }
+    }
+
+    return DnSnapshotValidationResult::OK;
+}
diff --git a/src/dynamic-net/dn_snapshot_validator.h b/src/dynamic-net/dn_snapshot_validator.h
new file mode 100644
index 0000000..fd77b40
--- /dev/null
+++ b/src/dynamic-net/dn_snapshot_validator.h
@@ -0,0 +1,49 @@
+//
+// Slow-node metadata table + dual-layer PartialSnapshot validation.
+//
+
+#ifndef DYNAMIC_NET_DN_SNAPSHOT_VALIDATOR_H
+#define DYNAMIC_NET_DN_SNAPSHOT_VALIDATOR_H
+
+#include "dn_types.h"
+
+#include <map>
+#include <mutex>
+#include <vector>
+
+enum class DnSnapshotValidationResult {
+    OK,
+    MISSING_META,
+    ORIGIN_HASH_MISMATCH,
+    GLOBAL_CHECKSUM_MISMATCH
+};
+
+class DnSlowNodeMetadataStore {
+public:
+    void RecordMetadata(int32_t epoch, int32_t sender_channel, int32_t term, uint64_t payload_hash,
+                        int32_t payload_size);
+
+    bool HasMetadata(int32_t epoch, int32_t sender_channel) const;
+
+    const DnEpochMetadata *GetMetadata(int32_t epoch, int32_t sender_channel) const;
+
+    void GcBeforeEpoch(int32_t epoch);
+
+private:
+    mutable std::mutex m_mutex;
+    /* epoch -> (channel -> metadata) */
+    std::map<int32_t, std::map<int32_t, DnEpochMetadata>> m_table;
+};
+
+class DnSnapshotValidator {
+public:
+    /*
+     * Layer-1: per-origin hash reconstruction vs previously received metadata.
+     * Layer-2: global merged checksum vs snapshot.checksum.
+     */
+    static DnSnapshotValidationResult Validate(const DnPartialSnapshotMessage &snap,
+                                               const DnSlowNodeMetadataStore &meta_store,
+                                               std::vector<DnTransaction> *out_all_txns);
+};
+
+#endif /* DYNAMIC_NET_DN_SNAPSHOT_VALIDATOR_H */
diff --git a/src/dynamic-net/dn_timer_handler.cpp b/src/dynamic-net/dn_timer_handler.cpp
new file mode 100644
index 0000000..07a7ba1
--- /dev/null
+++ b/src/dynamic-net/dn_timer_handler.cpp
@@ -0,0 +1,47 @@
+#include "dn_timer_handler.h"
+#include "dn_api.h"
+
+DnTimerTickResult DnTimerHandler::OnTimerTick(const DnTimerTickInput &input)
+{
+    DnTimerTickResult result;
+    DnRuntime &rt = DnRuntime::Instance();
+    if (!rt.GetConfig().node_count) {
+        return result;
+    }
+
+    result.strategy = rt.ConsultProposal(input.local_proposal_epoch);
+    result.should_propose = result.strategy.should_propose;
+    if (!result.should_propose) {
+        return result;
+    }
+
+    int32_t epoch_to_propose = result.strategy.target_epoch;
+    result.log_epoch_updates.clear();
+
+    if (result.strategy.action == DnStrategyAction::JUMP) {
+        result.log_epoch_updates = rt.ExecuteCatchupJump(epoch_to_propose);
+
+        int32_t max_new_epoch = epoch_to_propose;
+        for (const auto &kv : result.log_epoch_updates) {
+            if (kv.second > max_new_epoch) {
+                max_new_epoch = kv.second;
+            }
+        }
+        epoch_to_propose = max_new_epoch + 1;
+        result.strategy.jump_delta = epoch_to_propose - input.local_proposal_epoch;
+    }
+
+    result.proposed_entry.term = input.current_term;
+    result.proposed_entry.index = input.next_log_index;
+    result.proposed_entry.epoch = epoch_to_propose;
+
+    if (input.pending_txns.empty()) {
+        result.proposed_entry.type = DnEntryType::NOOP;
+    } else {
+        result.proposed_entry.type = DnEntryType::WRITE;
+        result.proposed_entry.txns = input.pending_txns;
+    }
+
+    result.next_local_epoch = epoch_to_propose + 1;
+    return result;
+}
diff --git a/src/dynamic-net/dn_timer_handler.h b/src/dynamic-net/dn_timer_handler.h
new file mode 100644
index 0000000..4f5ee31
--- /dev/null
+++ b/src/dynamic-net/dn_timer_handler.h
@@ -0,0 +1,48 @@
+//
+// Epoch Timer orchestration: FIXED vs CATCHUP proposal + Jump rewrite.
+//
+
+#ifndef DYNAMIC_NET_DN_TIMER_HANDLER_H
+#define DYNAMIC_NET_DN_TIMER_HANDLER_H
+
+#include "dn_types.h"
+
+#include <map>
+#include <vector>
+
+struct DnTimerTickInput {
+    int32_t local_proposal_epoch;
+    int32_t current_term;
+    int32_t next_log_index;
+    std::vector<DnTransaction> pending_txns;
+
+    DnTimerTickInput()
+        : local_proposal_epoch(0), current_term(0), next_log_index(0)
+    {
+    }
+};
+
+struct DnTimerTickResult {
+    bool should_propose;
+    DnProposalStrategy strategy;
+    DnRaftEntry proposed_entry;
+    int32_t next_local_epoch;
+
+    /*
+     * When CATCHUP Jump fires: log_index -> rewritten epoch for local uncommitted entries.
+     */
+    std::map<int32_t, int32_t> log_epoch_updates;
+
+    DnTimerTickResult() : should_propose(false), next_local_epoch(0) {}
+};
+
+class DnTimerHandler {
+public:
+    /*
+     * One Timer period: consult strategy, optionally rewrite send queue, build RaftEntry.
+     * Does NOT send on wire — caller uses result with DnPrepareAppendForTarget().
+     */
+    static DnTimerTickResult OnTimerTick(const DnTimerTickInput &input);
+};
+
+#endif /* DYNAMIC_NET_DN_TIMER_HANDLER_H */
diff --git a/src/dynamic-net/dn_traffic_shaper.cpp b/src/dynamic-net/dn_traffic_shaper.cpp
new file mode 100644
index 0000000..2c84737
--- /dev/null
+++ b/src/dynamic-net/dn_traffic_shaper.cpp
@@ -0,0 +1,140 @@
+//
+// Bandwidth / latency shaping implementation.
+//
+
+#include "dn_traffic_shaper.h"
+
+#include <algorithm>
+#include <cmath>
+
+DnTrafficShaper::DnTrafficShaper(const DnNetworkConfig *config)
+    : m_config(config),
+      m_lastTxFinishCtrl(0),
+      m_lastTxFinishData(0),
+      m_lastRxFinishCtrl(0),
+      m_lastRxFinishData(0)
+{
+    if (m_config != nullptr && m_config->node_count > 0) {
+        m_latencyMatrix.assign(m_config->node_count, std::vector<int>(m_config->node_count, 50));
+        for (int i = 0; i < m_config->node_count; ++i) {
+            m_latencyMatrix[i][i] = 1;
+        }
+    }
+}
+
+void DnTrafficShaper::Configure(const DnNetworkConfig *config)
+{
+    m_config = config;
+}
+
+void DnTrafficShaper::SetLatencyMatrix(const std::vector<std::vector<int>> &matrix)
+{
+    m_latencyMatrix = matrix;
+}
+
+long long DnTrafficShaper::BandwidthCostMs(size_t bytes, double bps)
+{
+    if (bps <= 0.0 || bytes == 0) {
+        return 0;
+    }
+    double seconds = (static_cast<double>(bytes) * 8.0) / bps;
+    return static_cast<long long>(std::ceil(seconds * 1000.0));
+}
+
+double DnTrafficShaper::EffectiveUploadBps() const
+{
+    if (m_config == nullptr) {
+        return 0.0;
+    }
+    if (!DnIsConfiguredSlow(*m_config, m_config->local_node_id)) {
+        return 0.0;
+    }
+    switch (m_config->bandwidth_mode) {
+        case DnBandwidthLimitMode::UP_LIMIT:
+        case DnBandwidthLimitMode::BI_LIMIT:
+            return m_config->upload_bandwidth_bps;
+        default:
+            return 0.0;
+    }
+}
+
+double DnTrafficShaper::EffectiveDownloadBps() const
+{
+    if (m_config == nullptr) {
+        return 0.0;
+    }
+    if (!DnIsConfiguredSlow(*m_config, m_config->local_node_id)) {
+        return 0.0;
+    }
+    switch (m_config->bandwidth_mode) {
+        case DnBandwidthLimitMode::DOWN_LIMIT:
+        case DnBandwidthLimitMode::BI_LIMIT:
+            return m_config->download_bandwidth_bps;
+        default:
+            return 0.0;
+    }
+}
+
+bool DnTrafficShaper::ShouldLimitTx() const
+{
+    return EffectiveUploadBps() > 0.0;
+}
+
+bool DnTrafficShaper::ShouldLimitRx() const
+{
+    return EffectiveDownloadBps() > 0.0;
+}
+
+long long DnTrafficShaper::CalculateTxCost(size_t packet_size, bool is_high_priority) const
+{
+    (void)is_high_priority;
+    return BandwidthCostMs(packet_size, EffectiveUploadBps());
+}
+
+long long DnTrafficShaper::CalculateLatency(int from_node, int to_node) const
+{
+    if (from_node < 0 || to_node < 0) {
+        return 50;
+    }
+    if (from_node >= static_cast<int>(m_latencyMatrix.size())) {
+        return 50;
+    }
+    if (to_node >= static_cast<int>(m_latencyMatrix[from_node].size())) {
+        return 50;
+    }
+    return m_latencyMatrix[from_node][to_node];
+}
+
+void DnTrafficShaper::UpdateBusyState(long long finish_time_ms, bool is_high_priority)
+{
+    if (is_high_priority) {
+        m_lastTxFinishCtrl = std::max(m_lastTxFinishCtrl, finish_time_ms);
+    } else {
+        m_lastTxFinishData = std::max(m_lastTxFinishData, finish_time_ms);
+    }
+}
+
+long long DnTrafficShaper::GetLastFinishTime(bool is_high_priority) const
+{
+    return is_high_priority ? m_lastTxFinishCtrl : m_lastTxFinishData;
+}
+
+long long DnTrafficShaper::GetRxQueueAheadMs(long long arrival_time_ms, bool is_high_priority) const
+{
+    long long last = is_high_priority ? m_lastRxFinishCtrl : m_lastRxFinishData;
+    return std::max(0LL, last - arrival_time_ms);
+}
+
+long long DnTrafficShaper::CalculateRxFinishTime(long long arrival_time_ms, size_t packet_size,
+                                                   bool is_high_priority)
+{
+    long long start = std::max(arrival_time_ms, is_high_priority ? m_lastRxFinishCtrl : m_lastRxFinishData);
+    long long cost = BandwidthCostMs(packet_size, EffectiveDownloadBps());
+    long long finish = start + cost;
+    if (is_high_priority) {
+        m_lastRxFinishCtrl = finish;
+    } else {
+        m_lastRxFinishData = finish;
+    }
+    return finish;
+}
