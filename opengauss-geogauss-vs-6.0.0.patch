diff --git a/src/occ/Makefile b/src/occ/Makefile
new file mode 100644
index 0000000..38679f0
--- /dev/null
+++ b/src/occ/Makefile
@@ -0,0 +1,33 @@
+# Makefile for src/occ
+subdir = src/occ
+top_builddir = ../..
+include $(top_builddir)/src/Makefile.global
+
+# 所有 cpp 文件对象（含 occ-opt 优化路径）
+OCC_OPT_CPPFLAGS = -I$(top_srcdir)/src/occ-opt
+CPPFLAGS += $(OCC_OPT_CPPFLAGS)
+
+OBJS = $(patsubst %.cpp,%.o,$(wildcard *.cpp)) \
+       $(patsubst ../occ-opt/%.cpp,../occ-opt/%.o,$(wildcard ../occ-opt/*.cpp))
+
+../occ-opt/%.o: ../occ-opt/%.cpp
+	$(CXX) $(CXXFLAGS) $(CPPFLAGS) $(OCC_OPT_CPPFLAGS) -c -o $@ $<
+
+%.o: %.cpp
+	$(CXX) $(CXXFLAGS) $(CPPFLAGS) $(OCC_OPT_CPPFLAGS) -c -o $@ $<
+
+# 生成所有对象文件
+all: $(OBJS) SUBSYS.o objfiles.txt
+
+# 生成 SUBSYS.o，供主程序链接
+SUBSYS.o: $(OBJS)
+	$(LD) $(LDREL) $(LDOUT) $@ $^
+
+# 生成 objfiles.txt，供主程序链接
+objfiles.txt: $(OBJS)
+	echo $(addprefix $(subdir)/,$(OBJS)) > $@
+
+clean:
+	rm -f *.o ../occ-opt/*.o SUBSYS.o objfiles.txt
+
+.PHONY: all clean
diff --git a/src/occ/o_access.cpp b/src/occ/o_access.cpp
new file mode 100644
index 0000000..6680455
--- /dev/null
+++ b/src/occ/o_access.cpp
@@ -0,0 +1,164 @@
+//
+// Created by hcj2003 on 10/8/25.
+//
+
+#include "occ/o_txn.h"
+#include "occ/o_heapam.h"
+#include "occ/o_executor.h"
+#include "occ/o_delta_table.h"
+#include "occ/o_staging.h"
+#include "occ/occ_internal.h"
+
+#include "utils/rel.h"
+#include "access/xact.h"
+
+static Relation O_OpenAccessRelation(O_Access *access, bool *needClose)
+{
+    Oid relid = OccResolveAccessRelid(access, nullptr);
+    if (!OidIsValid(relid)) {
+        *needClose = false;
+        return nullptr;
+    }
+    access->m_origSentinel.relid = relid;
+
+    O_TxnManager *txn = GetTxnManager();
+    if (txn != nullptr) {
+        return txn->GetCachedRelation(relid, nullptr, needClose);
+    }
+
+    *needClose = true;
+    return heap_open(relid, RowExclusiveLock);
+}
+
+static void O_MirrorToDelta(O_Access *access, HeapTuple tuple, uint64_t csn, bool deleted)
+{
+    if (!g_enable_occ_delta || g_enable_occ_staging || access == nullptr) {
+        return;
+    }
+
+    O_DeltaTable &delta = O_DeltaTable::Instance();
+    if (deleted) {
+        delta.MarkDeleted(access->m_origSentinel.relation, &access->m_origSentinel.tuple_id, csn);
+        return;
+    }
+
+    if (tuple != nullptr && tuple->t_data != nullptr) {
+        tuple->t_data->m_rowCSN = csn;
+        tuple->t_data->is_latest = true;
+        delta.Upsert(access->m_origSentinel.relation, &access->m_origSentinel.tuple_id, tuple, csn);
+    }
+}
+
+static bool O_StageAccessCommit(O_Access *access, Relation rel, ItemPointer tid, uint64_t csn)
+{
+    OccStagingEnsureInit();
+
+    switch (access->m_type) {
+    case WR:
+    case INV: {
+        HeapTuple newVersion = access->m_localRow;
+        if (newVersion == nullptr || newVersion->t_data == nullptr) {
+            return false;
+        }
+        newVersion->t_data->m_rowCSN = csn;
+        newVersion->t_data->is_latest = true;
+        return OccStageAccessCommit(rel, tid, newVersion, csn, access->m_type);
+    }
+    case DEL:
+        return OccStageAccessCommit(rel, tid, nullptr, csn, access->m_type);
+    case INS: {
+        HeapTuple insTuple = access->m_localInsertRow ? access->m_localInsertRow : access->m_localRow;
+        if (insTuple != nullptr && insTuple->t_data != nullptr) {
+            insTuple->t_data->m_rowCSN = csn;
+            insTuple->t_data->is_latest = true;
+        }
+        return OccStageAccessCommit(rel, tid, insTuple, csn, access->m_type);
+    }
+    default:
+        return false;
+    }
+}
+
+void O_Access::WriteGlobalChanges(uint64_t csn)
+{
+    WriteGlobalChanges(csn, m_origSentinel);
+}
+
+void O_Access::WriteGlobalChanges(uint64_t csn, const occ_sentinel &key)
+{
+    if (m_type == RD) {
+        return;
+    }
+
+    Oid relid = InvalidOid;
+    ItemPointerData tid;
+    if (!OccPrepareAccessTarget(this, &key, &relid, &tid)) {
+        return;
+    }
+
+    bool relClosed = false;
+    Relation rel = O_OpenAccessRelation(this, &relClosed);
+    if (rel == nullptr || !OccTidIsPlausible(&tid, rel)) {
+        if (relClosed && rel != nullptr) {
+            heap_close(rel, RowExclusiveLock);
+        }
+        return;
+    }
+    m_origSentinel.tuple_id = tid;
+
+    if (g_enable_occ_staging) {
+        (void)O_StageAccessCommit(this, rel, &tid, csn);
+        if (relClosed) {
+            heap_close(rel, RowExclusiveLock);
+        }
+        return;
+    }
+
+    switch (m_type) {
+    case WR:
+    case INV: {
+        HeapTuple newVersion = m_localRow;
+        if (newVersion == nullptr || newVersion->t_data == nullptr) {
+            break;
+        }
+        CommandId cid = m_outputCid;
+        if (cid == InvalidCommandId) {
+            cid = GetCurrentCommandId(false);
+        }
+        newVersion->t_data->m_rowCSN = csn;
+        newVersion->t_data->is_latest = true;
+        if (update_index) {
+            O_heap_update2(rel, &m_origSentinel.tuple_id, newVersion, cid, csn);
+        } else {
+            O_heap_update(rel, &m_origSentinel.tuple_id, newVersion, cid, csn, nullptr, nullptr);
+        }
+        O_MirrorToDelta(this, newVersion, csn, false);
+        break;
+    }
+    case DEL: {
+        CommandId cid = m_outputCid;
+        if (cid == InvalidCommandId) {
+            cid = GetCurrentCommandId(false);
+        }
+        O_heap_delete(rel, &m_origSentinel.tuple_id, cid, csn);
+        O_MirrorToDelta(this, nullptr, csn, true);
+        break;
+    }
+    case INS: {
+        HeapTuple insTuple = m_localInsertRow ? m_localInsertRow : m_localRow;
+        if (insTuple != nullptr && insTuple->t_data != nullptr) {
+            insTuple->t_data->m_rowCSN = csn;
+            insTuple->t_data->is_latest = true;
+        }
+        O_heap_commit_insert_csn(rel, &m_origSentinel.tuple_id, csn);
+        O_MirrorToDelta(this, insTuple, csn, false);
+        break;
+    }
+    default:
+        break;
+    }
+
+    if (relClosed) {
+        heap_close(rel, RowExclusiveLock);
+    }
+}
diff --git a/src/occ/o_commit.cpp b/src/occ/o_commit.cpp
new file mode 100644
index 0000000..3cbca64
--- /dev/null
+++ b/src/occ/o_commit.cpp
@@ -0,0 +1,84 @@
+#include "occ/o_txn.h"
+#include "occ/o_commit.h"
+#include "occ/o_csn_manager.h"
+#include "occ/occ_internal.h"
+#include "occ/occ_mem.h"
+#include "occ/occ_stats.h"
+#include "utils/elog.h"
+
+static O_CSNManager csnManager;
+
+O_CSNManager::O_CSNManager() : m_csn(INITIAL_CSN)
+{
+}
+
+// 接口
+void OCCXactCallback(XactEvent event)
+{
+    if (event == XACT_EVENT_START) {
+        return;
+    }
+
+    O_TxnManager *txn = u_sess->occ_cxt.txn_manager;
+    if (txn == nullptr) {
+        return;
+    }
+
+    if (event == XACT_EVENT_COMMIT)
+    {
+        if (!O_TxnHasActiveWriteSet()) {
+            return;
+        }
+        if (O_ValidateCommit() != RC_OK)
+        {
+            ereport(ERROR,
+                    (errcode(ERRCODE_T_R_SERIALIZATION_FAILURE),
+                     errmsg("occ: could not serialize access due to concurrent update"),
+                     errhidestmt(true),
+                     errhideprefix(true),
+                     onlyfrontmsg(true)));
+        }
+        else
+        {
+            O_OccStatsRecordCommit();
+        }
+    }
+    else if (event == XACT_EVENT_RECORD_COMMIT)
+    {
+        if (!O_TxnHasActiveWriteSet()) {
+            return;
+        }
+        uint64_t csn = csnManager.GetNextCSN();
+        O_RecordCommit(csn);
+    }
+    else if (event == XACT_EVENT_END_TRANSACTION)
+    {
+        txn->EndTransaction();
+    }
+    else if (event == XACT_EVENT_ABORT)
+    {
+        txn->Rollback();
+    }
+}
+
+RC O_ValidateCommit()
+{
+    O_TxnManager *txn = GetTxnManager();
+    return txn->ValidateCommit();
+}
+
+bool O_RevalidateWriteSet(void)
+{
+    O_TxnManager *txn = u_sess->occ_cxt.txn_manager;
+    if (txn == nullptr) {
+        return true;
+    }
+    return txn->RevalidateWriteSet();
+}
+
+void O_RecordCommit(uint64_t csn)
+{
+    O_TxnManager *txn = GetTxnManager();
+    txn->SetCommitSequenceNumber(csn);
+    txn->RecordCommit();
+}
