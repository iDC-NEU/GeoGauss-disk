+static bool EpochSlotIsCurrent(EpochSharedState* state, uint64_t epochId, uint32_t slot)
+{
+    if (state == nullptr) {
+        return false;
+    }
+    return state->counters.slot_epoch[slot].load(std::memory_order_acquire) == epochId;
+}
