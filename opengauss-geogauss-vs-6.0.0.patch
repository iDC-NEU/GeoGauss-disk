diff --git a/src/occ-opt/o_staging_table.cpp b/src/occ-opt/o_staging_table.cpp
new file mode 100644
index 0000000..8cc3aaa4
--- /dev/null
+++ b/src/occ-opt/o_staging_table.cpp
@@ -0,0 +1,319 @@
+//
+// Version Staging Hash Table implementation.
+//
+
+#include "o_staging_table.h"
+#include "o_staging_memory.h"
+
+#include "utils/rel.h"
+
+O_StagingTable &O_StagingTable::Instance()
+{
+    static O_StagingTable instance;
+    return instance;
+}
+
+O_StagingTable::O_StagingTable() : m_shardCount(DEFAULT_SHARD_COUNT)
+{
+    ResetStats();
+}
+
+void O_StagingTable::Configure(size_t shard_count)
+{
+    if (shard_count == 0) {
+        shard_count = DEFAULT_SHARD_COUNT;
+    }
+    if (shard_count > MAX_SHARD_COUNT) {
+        ereport(WARNING,
+                (errmsg("O_StagingTable::Configure: shard_count %zu capped to %zu",
+                        shard_count,
+                        MAX_SHARD_COUNT)));
+        shard_count = MAX_SHARD_COUNT;
+    }
+    if (shard_count == m_shardCount) {
+        return;
+    }
+
+    for (size_t i = 0; i < m_shardCount; ++i) {
+        std::lock_guard<std::mutex> lock(m_mutexes[i]);
+        if (!m_shards[i].empty()) {
+            ereport(WARNING,
+                    (errmsg("O_StagingTable::Configure ignored: table is not empty (%zu shards)",
+                            m_shardCount)));
+            return;
+        }
+    }
+
+    m_shardCount = shard_count;
+}
+
+O_StagingKey O_StagingTable::MakeKey(Relation relation, ItemPointer tid) const
+{
+    return O_StagingKeyFromTid(RelationGetRelid(relation), tid);
+}
+
+size_t O_StagingTable::ShardIndex(const O_StagingKey &key) const
+{
+    return O_StagingKeyHash{}(key) % m_shardCount;
+}
+
+bool O_StagingTable::StageUpsert(Relation relation, ItemPointer tid, HeapTuple tuple, uint64_t csn)
+{
+    if (relation == nullptr || tid == nullptr || tuple == nullptr || tuple->t_data == nullptr) {
+        return false;
+    }
+
+    O_StagingKey key = MakeKey(relation, tid);
+    size_t shard = ShardIndex(key);
+
+    std::lock_guard<std::mutex> lock(m_mutexes[shard]);
+    StagingMap &table = m_shards[shard];
+
+    HeapTuple copy = O_StagingCopyToPersistent(tuple);
+    if (copy == nullptr) {
+        return false;
+    }
+
+    copy->t_self = *tid;
+    copy->t_tableOid = RelationGetRelid(relation);
+    copy->t_bucketId = RelationGetBktid(relation);
+    if (copy->t_data != nullptr) {
+        copy->t_data->m_rowCSN = csn;
+        copy->t_data->is_latest = true;
+    }
+
+    bool is_new = false;
+    auto it = table.find(key);
+    if (it == table.end()) {
+        is_new = true;
+        O_StagingEntry entry;
+        entry.tuple = copy;
+        entry.deleted = false;
+        entry.is_latest = true;
+        entry.csn = csn;
+        entry.staged_csn = csn;
+        table.emplace(key, entry);
+    } else {
+        if (it->second.tuple != nullptr) {
+            O_StagingFreePersistent(it->second.tuple);
+        }
+        it->second.tuple = copy;
+        it->second.deleted = false;
+        it->second.is_latest = true;
+        it->second.csn = csn;
+        it->second.staged_csn = csn;
+    }
+
+    {
+        std::lock_guard<std::mutex> statsLock(m_statsMutex);
+        m_stats.stage_upserts++;
+    }
+    return is_new;
+}
+
+bool O_StagingTable::StageDelete(Relation relation, ItemPointer tid, uint64_t csn)
+{
+    if (relation == nullptr || tid == nullptr) {
+        return false;
+    }
+
+    O_StagingKey key = MakeKey(relation, tid);
+    size_t shard = ShardIndex(key);
+
+    std::lock_guard<std::mutex> lock(m_mutexes[shard]);
+    StagingMap &table = m_shards[shard];
+    auto it = table.find(key);
+    bool is_new = false;
+    if (it == table.end()) {
+        is_new = true;
+        O_StagingEntry entry;
+        entry.tuple = nullptr;
+        entry.deleted = true;
+        entry.is_latest = false;
+        entry.csn = csn;
+        entry.staged_csn = csn;
+        table.emplace(key, entry);
+    } else {
+        if (it->second.tuple != nullptr) {
+            O_StagingFreePersistent(it->second.tuple);
+            it->second.tuple = nullptr;
+        }
+        it->second.deleted = true;
+        it->second.is_latest = false;
+        it->second.csn = csn;
+        it->second.staged_csn = csn;
+    }
+
+    {
+        std::lock_guard<std::mutex> statsLock(m_statsMutex);
+        m_stats.stage_deletes++;
+    }
+    return is_new;
+}
+
+bool O_StagingTable::Lookup(Relation relation, ItemPointer tid, O_StagingEntry &outEntry) const
+{
+    if (relation == nullptr || tid == nullptr) {
+        return false;
+    }
+
+    O_StagingKey key = MakeKey(relation, tid);
+    size_t shard = ShardIndex(key);
+
+    std::lock_guard<std::mutex> lock(m_mutexes[shard]);
+    auto it = m_shards[shard].find(key);
+    if (it == m_shards[shard].end()) {
+        std::lock_guard<std::mutex> statsLock(m_statsMutex);
+        m_stats.read_misses++;
+        return false;
+    }
+
+    outEntry.deleted = it->second.deleted;
+    outEntry.is_latest = it->second.is_latest;
+    outEntry.csn = it->second.csn;
+    outEntry.staged_csn = it->second.staged_csn;
+    outEntry.tuple = nullptr;
+
+    {
+        std::lock_guard<std::mutex> statsLock(m_statsMutex);
+        m_stats.read_hits++;
+    }
+    return true;
+}
+
+HeapTuple O_StagingTable::LookupCopyTuple(Relation relation, ItemPointer tid) const
+{
+    if (relation == nullptr || tid == nullptr) {
+        return nullptr;
+    }
+
+    O_StagingKey key = MakeKey(relation, tid);
+    size_t shard = ShardIndex(key);
+
+    std::lock_guard<std::mutex> lock(m_mutexes[shard]);
+    auto it = m_shards[shard].find(key);
+    if (it == m_shards[shard].end()) {
+        return nullptr;
+    }
+    if (it->second.deleted || !O_StagingTupleLengthValid(it->second.tuple)) {
+        return nullptr;
+    }
+
+    return O_StagingCopyToPersistent(it->second.tuple);
+}
+
+bool O_StagingTable::LookupForRead(Relation relation, ItemPointer tid,
+                                   O_StagingLookupResult &result) const
+{
+    result = O_StagingLookupResult();
+    if (relation == nullptr || tid == nullptr) {
+        return false;
+    }
+
+    O_StagingKey key = MakeKey(relation, tid);
+    size_t shard = ShardIndex(key);
+
+    std::lock_guard<std::mutex> lock(m_mutexes[shard]);
+    auto it = m_shards[shard].find(key);
+    if (it == m_shards[shard].end()) {
+        std::lock_guard<std::mutex> statsLock(m_statsMutex);
+        m_stats.read_misses++;
+        return false;
+    }
+
+    result.found = true;
+    result.deleted = it->second.deleted;
+    result.is_latest = it->second.is_latest;
+    result.csn = it->second.csn;
+
+    if (!it->second.deleted) {
+        if (!O_StagingTupleLengthValid(it->second.tuple)) {
+            result.found = false;
+            return false;
+        }
+        result.tuple_copy = O_StagingCopyToPersistent(it->second.tuple);
+        if (result.tuple_copy == nullptr) {
+            result.found = false;
+            return false;
+        }
+    }
+
+    {
+        std::lock_guard<std::mutex> statsLock(m_statsMutex);
+        m_stats.read_hits++;
+    }
+    return true;
+}
+
+bool O_StagingTable::Remove(Relation relation, ItemPointer tid)
+{
+    if (relation == nullptr || tid == nullptr) {
+        return false;
+    }
+
+    O_StagingKey key = MakeKey(relation, tid);
+    size_t shard = ShardIndex(key);
+
+    std::lock_guard<std::mutex> lock(m_mutexes[shard]);
+    auto it = m_shards[shard].find(key);
+    if (it == m_shards[shard].end()) {
+        return false;
+    }
+
+    if (it->second.tuple != nullptr) {
+        O_StagingFreePersistent(it->second.tuple);
+    }
+    m_shards[shard].erase(it);
+    return true;
+}
+
+void O_StagingTable::CollectPageEntries(Oid relid, BlockNumber block,
+                                        std::vector<std::pair<O_StagingKey, O_StagingEntry>> &outEntries) const
+{
+    outEntries.clear();
+    for (size_t shard = 0; shard < m_shardCount; ++shard) {
+        std::lock_guard<std::mutex> lock(m_mutexes[shard]);
+        for (const auto &kv : m_shards[shard]) {
+            if (kv.first.relid == relid && kv.first.block == block) {
+                outEntries.push_back(kv);
+            }
+        }
+    }
+}
+
+bool O_StagingTable::PageHasEntries(Oid relid, BlockNumber block) const
+{
+    return CountPageEntries(relid, block) > 0;
+}
+
+size_t O_StagingTable::CountPageEntries(Oid relid, BlockNumber block) const
+{
+    size_t count = 0;
+    for (size_t shard = 0; shard < m_shardCount; ++shard) {
+        std::lock_guard<std::mutex> lock(m_mutexes[shard]);
+        for (const auto &kv : m_shards[shard]) {
+            if (kv.first.relid == relid && kv.first.block == block) {
+                count++;
+            }
+        }
+    }
+    return count;
+}
+
+O_StagingStats O_StagingTable::GetStatsSnapshot() const
+{
+    std::lock_guard<std::mutex> statsLock(m_statsMutex);
+    O_StagingStats stats = m_stats;
+    stats.staged_entries = 0;
+    for (size_t i = 0; i < m_shardCount; ++i) {
+        std::lock_guard<std::mutex> lock(m_mutexes[i]);
+        stats.staged_entries += m_shards[i].size();
+    }
+    return stats;
+}
+
+void O_StagingTable::ResetStats()
+{
+    std::lock_guard<std::mutex> statsLock(m_statsMutex);
+    m_stats = O_StagingStats{};
+}
diff --git a/src/occ-opt/o_staging_table.h b/src/occ-opt/o_staging_table.h
new file mode 100644
index 0000000..5aae74d
--- /dev/null
+++ b/src/occ-opt/o_staging_table.h
@@ -0,0 +1,82 @@
+//
+// Version Staging Hash Table — core in-memory store for deferred write-back.
+//
+
+#ifndef OCC_OPT_O_STAGING_TABLE_H
+#define OCC_OPT_O_STAGING_TABLE_H
+
+#include "o_staging_types.h"
+
+#include <array>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+
+class O_StagingTable
+{
+public:
+    static constexpr size_t DEFAULT_SHARD_COUNT = 64;
+    static constexpr size_t MAX_SHARD_COUNT = 64;
+
+    static O_StagingTable &Instance();
+
+    void Configure(size_t shard_count);
+
+    /*
+     * Write path: stage a committed tuple version without touching heap page.
+     * Overwrites any previous staged version for the same (relid, block, offset).
+     * Returns true when this is a newly staged slot (not overwriting an existing entry).
+     */
+    bool StageUpsert(Relation relation, ItemPointer tid, HeapTuple tuple, uint64_t csn);
+
+    /* Returns true when this is a newly staged slot. */
+    bool StageDelete(Relation relation, ItemPointer tid, uint64_t csn);
+
+    /*
+     * Read path: metadata lookup (tuple pointer is NOT returned — use LookupCopyTuple).
+     */
+    bool Lookup(Relation relation, ItemPointer tid, O_StagingEntry &outEntry) const;
+
+    HeapTuple LookupCopyTuple(Relation relation, ItemPointer tid) const;
+
+    bool LookupForRead(Relation relation, ItemPointer tid, O_StagingLookupResult &result) const;
+
+    /*
+     * Remove a staged entry after successful flush to heap.
+     */
+    bool Remove(Relation relation, ItemPointer tid);
+
+    /*
+     * Collect all staged entries belonging to one heap page.
+     * Used by deferred write-back to batch-merge modifications.
+     */
+    void CollectPageEntries(Oid relid, BlockNumber block,
+                            std::vector<std::pair<O_StagingKey, O_StagingEntry>> &outEntries) const;
+
+    bool PageHasEntries(Oid relid, BlockNumber block) const;
+
+    size_t CountPageEntries(Oid relid, BlockNumber block) const;
+
+    O_StagingStats GetStatsSnapshot() const;
+
+    void ResetStats();
+
+private:
+    O_StagingTable();
+    O_StagingTable(const O_StagingTable &) = delete;
+    O_StagingTable &operator=(const O_StagingTable &) = delete;
+
+    O_StagingKey MakeKey(Relation relation, ItemPointer tid) const;
+    size_t ShardIndex(const O_StagingKey &key) const;
+
+    using StagingMap = std::unordered_map<O_StagingKey, O_StagingEntry, O_StagingKeyHash>;
+
+    size_t m_shardCount;
+    std::array<StagingMap, MAX_SHARD_COUNT> m_shards;
+    mutable std::array<std::mutex, MAX_SHARD_COUNT> m_mutexes;
+
+    mutable O_StagingStats m_stats;
+    mutable std::mutex m_statsMutex;
+};
+
+#endif /* OCC_OPT_O_STAGING_TABLE_H */
diff --git a/src/occ-opt/o_staging_types.h b/src/occ-opt/o_staging_types.h
new file mode 100644
index 0000000..5d27bf0
--- /dev/null
+++ b/src/occ-opt/o_staging_types.h
@@ -0,0 +1,153 @@
+//
+// Shared types for OCC version staging hash table (occ-opt).
+// Implements the "Version Staging Hash Table + Deferred Write-back" design.
+//
+
+#ifndef OCC_OPT_O_STAGING_TYPES_H
+#define OCC_OPT_O_STAGING_TYPES_H
+
+#include "postgres.h"
+#include "access/htup.h"
+#include "utils/relcache.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+
+/* (Relation OID, PageID, TupleID) — staging table primary key */
+struct O_StagingKey
+{
+    Oid relid;
+    BlockNumber block;
+    OffsetNumber offset;
+
+    bool operator==(const O_StagingKey &other) const
+    {
+        return relid == other.relid && block == other.block && offset == other.offset;
+    }
+};
+
+struct O_StagingKeyHash
+{
+    std::size_t operator()(const O_StagingKey &key) const noexcept
+    {
+        std::size_t h1 = std::hash<Oid>{}(key.relid);
+        std::size_t h2 = std::hash<BlockNumber>{}(key.block);
+        std::size_t h3 = std::hash<OffsetNumber>{}(key.offset);
+        return ((h1 ^ (h2 << 1)) >> 1) ^ (h3 << 1);
+    }
+};
+
+/* Page-level aggregation key for dirty tracking and batch flush */
+struct O_StagingPageKey
+{
+    Oid relid;
+    BlockNumber block;
+
+    bool operator==(const O_StagingPageKey &other) const
+    {
+        return relid == other.relid && block == other.block;
+    }
+};
+
+struct O_StagingPageKeyHash
+{
+    std::size_t operator()(const O_StagingPageKey &key) const noexcept
+    {
+        std::size_t h1 = std::hash<Oid>{}(key.relid);
+        std::size_t h2 = std::hash<BlockNumber>{}(key.block);
+        return h1 ^ (h2 << 1);
+    }
+};
+
+/*
+ * One staged version for a tuple slot.
+ * While not flushed, this is the authoritative visible version for readers.
+ */
+struct O_StagingEntry
+{
+    HeapTuple tuple; /* nullptr when deleted tombstone */
+    bool deleted;
+    bool is_latest;
+    uint64_t csn;
+    uint64_t staged_csn; /* CSN assigned at stage time (same as csn for now) */
+
+    O_StagingEntry() : tuple(nullptr), deleted(false), is_latest(false), csn(0), staged_csn(0) {}
+};
+
+/* Unified read-path result */
+struct O_StagingLookupResult
+{
+    bool found;
+    bool deleted;
+    bool is_latest;
+    uint64_t csn;
+    HeapTuple tuple_copy; /* caller owns; heap_freetuple when done */
+
+    O_StagingLookupResult()
+        : found(false), deleted(false), is_latest(false), csn(0), tuple_copy(nullptr)
+    {
+    }
+};
+
+struct O_StagingConfig
+{
+    size_t shard_count;
+    uint32_t dirty_threshold_per_page;
+    uint64_t flush_interval_ms;
+    bool enable_background_flusher;
+
+    O_StagingConfig()
+        : shard_count(64),
+          dirty_threshold_per_page(32),
+          flush_interval_ms(100),
+          enable_background_flusher(false)
+    {
+    }
+};
+
+struct O_StagingStats
+{
+    uint64_t staged_entries;
+    uint64_t staged_pages;
+    uint64_t stage_upserts;
+    uint64_t stage_deletes;
+    uint64_t read_hits;
+    uint64_t read_misses;
+    uint64_t flush_pages;
+    uint64_t flush_tuples;
+    uint64_t flush_failures;
+};
+
+/*
+ * Callback invoked for each staged tuple during page flush.
+ * Return true on success; false aborts the page flush and leaves entries staged.
+ */
+using O_StagingTupleWriteFn = std::function<bool(
+    Relation relation, ItemPointer tid, HeapTuple tuple, uint64_t csn, bool deleted)>;
+
+struct O_StagingFlushCallbacks
+{
+    O_StagingTupleWriteFn write_tuple;
+
+    O_StagingFlushCallbacks() : write_tuple(nullptr) {}
+};
+
+inline O_StagingPageKey O_StagingPageKeyFromTid(Oid relid, ItemPointer tid)
+{
+    O_StagingPageKey key;
+    key.relid = relid;
+    key.block = ItemPointerGetBlockNumber(tid);
+    return key;
+}
+
+inline O_StagingKey O_StagingKeyFromTid(Oid relid, ItemPointer tid)
+{
+    O_StagingKey key;
+    key.relid = relid;
+    key.block = ItemPointerGetBlockNumber(tid);
+    key.offset = ItemPointerGetOffsetNumber(tid);
+    return key;
+}
+
+#endif /* OCC_OPT_O_STAGING_TYPES_H */
