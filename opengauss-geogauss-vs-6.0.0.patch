diff --git a/src/epoch/e_crdt.cpp b/src/epoch/e_crdt.cpp
new file mode 100644
index 0000000..f2cab6a
--- /dev/null
+++ b/src/epoch/e_crdt.cpp
@@ -0,0 +1,183 @@
+#include "postgres.h"
+
+#include "epoch/e_crdt.h"
+#include "epoch/e_config.h"
+#include "epoch/e_row_key.h"
+#include "epoch/e_statistician.h"
+
+#include <unordered_map>
+
+bool E_CrdtMerger::Key::operator==(const Key& o) const
+{
+    return relid == o.relid && pk_key == o.pk_key;
+}
+
+size_t E_CrdtMerger::KeyHash::operator()(const Key& k) const
+{
+    return std::hash<std::string>{}(k.pk_key) ^ (static_cast<size_t>(k.relid) << 1);
+}
+
+bool E_CrdtMerger::RowWins(uint64_t csn_a, uint32_t sid_a, uint64_t csn_b, uint32_t sid_b)
+{
+    /*
+     * 同一 txn 重放（TXN_REQ、乱序重传）时 csn/sid 相同，须视为幂等胜出，
+     * 否则 RowWins 在相等时返回 false → txn_accepted=false → 误记 abort_csn。
+     */
+    if (csn_a == csn_b && sid_a == sid_b) {
+        return true;
+    }
+    if (csn_a > csn_b) {
+        return true;
+    }
+    if (csn_a < csn_b) {
+        return false;
+    }
+    return sid_a > sid_b;
+}
+
+void E_CrdtMerger::Clear()
+{
+    map_.clear();
+    insert_winners_.clear();
+}
+
+bool E_CrdtMerger::MergeRowInternal(const E_WireRow& row, uint64_t csn, uint32_t server_id, bool* accepted,
+    std::vector<std::pair<uint64_t, uint32_t>>* aborted_txns)
+{
+    if (accepted != nullptr) {
+        *accepted = true;
+    }
+
+    Key key;
+    key.relid = row.relid;
+    if (!E_BuildPkKeyFromWireRow(row.relid, row, &key.pk_key)) {
+        static std::unordered_map<uint32_t, int> g_pk_fail_tick;
+        int& tick = g_pk_fail_tick[row.relid];
+        if (++tick % 20 == 1) {
+            Oid localRelid = E_ResolveLocalRelid(row);
+            EpochRecvDiagLogMergePkFail(row.relid,
+                static_cast<uint32_t>(localRelid),
+                row.relname.empty() ? nullptr : row.relname.c_str(),
+                row.op_type);
+        }
+        if (accepted != nullptr) {
+            *accepted = false;
+        }
+        return false;
+    }
+
+    if (row.op_type == EPOCH_OP_INSERT) {
+        auto ins_it = insert_winners_.find(key.pk_key);
+        if (ins_it == insert_winners_.end()) {
+            insert_winners_[key.pk_key] = InsertWinner{csn, server_id};
+        } else {
+            InsertWinner& winner = ins_it->second;
+            if (winner.csn == csn && winner.server_id == server_id) {
+                return true;
+            }
+            if (RowWins(csn, server_id, winner.csn, winner.server_id)) {
+                if (aborted_txns != nullptr) {
+                    aborted_txns->emplace_back(winner.csn, winner.server_id);
+                }
+                winner = InsertWinner{csn, server_id};
+            } else {
+                if (accepted != nullptr) {
+                    *accepted = false;
+                }
+                return false;
+            }
+        }
+    }
+
+    auto it = map_.find(key);
+    if (it == map_.end()) {
+        map_[key] = Entry{row, csn, server_id};
+        return true;
+    }
+
+    const Entry& old = it->second;
+    if (old.csn == csn && old.server_id == server_id) {
+        return true;
+    }
+    if (RowWins(csn, server_id, old.csn, old.server_id)) {
+        if (aborted_txns != nullptr) {
+            aborted_txns->emplace_back(old.csn, old.server_id);
+        }
+        it->second = Entry{row, csn, server_id};
+        return true;
+    }
+
+    if (accepted != nullptr) {
+        *accepted = false;
+    }
+    return false;
+}
+
+bool E_CrdtMerger::MergeRow(const E_WireRow& row, uint64_t csn, uint32_t server_id)
+{
+    return MergeRowInternal(row, csn, server_id, nullptr, nullptr);
+}
+
+E_CrdtMergeOutcome E_CrdtMerger::MergeWireTxn(const E_WireTxn& txn)
+{
+    E_CrdtMergeOutcome outcome;
+    outcome.txn_accepted = true;
+    if (txn.rows.empty()) {
+        return outcome;
+    }
+
+    for (const auto& row : txn.rows) {
+        if (row.op_type == EPOCH_OP_READ) {
+            continue;
+        }
+        bool accepted = true;
+        (void)MergeRowInternal(row, txn.csn, txn.server_id, &accepted, &outcome.aborted_txns);
+        if (!accepted) {
+            outcome.txn_accepted = false;
+        }
+    }
+
+    return outcome;
+}
+
+bool E_CrdtMerger::BuildMergedTxn(uint64_t epoch, uint64_t base_csn, uint32_t server_id, E_WireTxn* out) const
+{
+    if (out == nullptr) {
+        return false;
+    }
+    out->csn = base_csn;
+    out->start_epoch = epoch;
+    out->commit_epoch = epoch;
+    out->server_id = server_id;
+    out->txn_state = EPOCH_TXN_COMMIT;
+    out->rows.clear();
+    uint32_t local_node = EpochGetNodeId();
+    uint64_t max_csn = base_csn;
+    for (const auto& kv : map_) {
+        /* 本节点已在 O_RecordCommit 落盘，仅 apply 对端获胜的行 */
+        if (kv.second.server_id == local_node) {
+            continue;
+        }
+        out->rows.push_back(kv.second.row);
+        if (kv.second.csn > max_csn) {
+            max_csn = kv.second.csn;
+        }
+    }
+    out->csn = max_csn;
+    return !out->rows.empty();
+}
+
+bool E_CrdtMerger::HasRemoteRows(uint32_t local_node) const
+{
+    for (const auto& kv : map_) {
+        if (kv.second.server_id != local_node) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool E_CrdtMerger::IsEmpty(void) const
+{
+    return map_.empty();
+}
diff --git a/src/epoch/e_dyn_net.cpp b/src/epoch/e_dyn_net.cpp
new file mode 100644
index 0000000..5186b71
--- /dev/null
+++ b/src/epoch/e_dyn_net.cpp
@@ -0,0 +1,485 @@
+#include "postgres.h"
+
+#include "epoch/e_dyn_net.h"
+#include "epoch/e_config.h"
+#include "epoch/e_node_manager.h"
+#include "epoch/e_statistician.h"
+#include "epoch/e_types.h"
+#include "epoch/e_txn_wire.h"
+#include "epoch/e_wire_envelope.h"
+#include "epoch/e_node_manager.h"
+#include "epoch/e_pipeline.h"
+
+#include "dn_api.h"
+#include "dn_hash.h"
+#include "dn_proxy_merge.h"
+#include "dn_snapshot_validator.h"
+#include "dn_transport.h"
+#include "dn_wire_codec.h"
+
+#include <deque>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include "miscadmin.h"
+
+extern bool EpochNetPublishDirect(const std::string& payload);
+extern bool EpochNetPublishTo(uint32_t target_node, const std::string& payload);
+
+static bool g_dyn_net_active = false;
+
+static void EpochDynNetBuildConfig(DnNetworkConfig* cfg)
+{
+    if (cfg == nullptr) {
+        return;
+    }
+    cfg->node_count = static_cast<int>(EpochGetTotalNodes());
+    cfg->local_node_id = static_cast<int>(EpochGetNodeId());
+    cfg->epoch_duration_ms = g_epoch_physical_interval_ms > 0 ? g_epoch_physical_interval_ms : 10;
+    cfg->lag_tolerance = g_epoch_dyn_net_lag_tolerance;
+    cfg->queue_size_tolerance = g_epoch_dyn_net_queue_tolerance;
+    cfg->catchup_factor_k = g_epoch_dyn_net_catchup_k;
+    cfg->rtt_estimate_ms = g_epoch_dyn_net_rtt_ms;
+    cfg->enable_proxy = g_epoch_dyn_net_proxy;
+
+    if (g_epoch_dyn_net_catchup) {
+        cfg->advancement = DnEpochAdvancement::CATCHUP;
+    } else {
+        cfg->advancement = DnEpochAdvancement::FIXED;
+    }
+
+    cfg->slow_node_ids.clear();
+    if (g_epoch_dyn_net_slow_nodes != nullptr && g_epoch_dyn_net_slow_nodes[0] != '\0') {
+        char* raw = pstrdup(g_epoch_dyn_net_slow_nodes);
+        char* tok = strtok(raw, ",");
+        while (tok != nullptr) {
+            cfg->slow_node_ids.push_back(atoi(tok));
+            tok = strtok(nullptr, ",");
+        }
+        pfree(raw);
+    }
+
+    switch (g_epoch_dyn_net_bw_mode) {
+        case EPOCH_DYN_NET_BW_UP:
+            cfg->bandwidth_mode = DnBandwidthLimitMode::UP_LIMIT;
+            break;
+        case EPOCH_DYN_NET_BW_DOWN:
+            cfg->bandwidth_mode = DnBandwidthLimitMode::DOWN_LIMIT;
+            break;
+        case EPOCH_DYN_NET_BW_BI:
+            cfg->bandwidth_mode = DnBandwidthLimitMode::BI_LIMIT;
+            break;
+        default:
+            cfg->bandwidth_mode = DnBandwidthLimitMode::UNLIMIT;
+            break;
+    }
+    cfg->upload_bandwidth_bps = g_epoch_dyn_net_upload_bps;
+    cfg->download_bandwidth_bps = g_epoch_dyn_net_download_bps;
+}
+
+bool EpochDynNetIsEnabled(void)
+{
+    return g_enable_epoch_dyn_net && g_dyn_net_active;
+}
+
+bool EpochDynNetProxyEnabled(void)
+{
+    return EpochDynNetIsEnabled() && g_epoch_dyn_net_proxy;
+}
+
+bool EpochDynNetIsProxySlowNode(void)
+{
+    if (!EpochDynNetProxyEnabled()) {
+        return false;
+    }
+    return DnIsConfiguredSlow(DnRuntime::Instance().GetConfig(), static_cast<int>(EpochGetNodeId()));
+}
+
+static void EpochDynNetTryEmitProxySnapshot(int32_t epoch)
+{
+    if (!EpochDynNetProxyEnabled()) {
+        return;
+    }
+    DnRuntime& rt = DnRuntime::Instance();
+    if (!DnIsFastNode(rt.GetConfig(), rt.GetConfig().local_node_id)) {
+        return;
+    }
+
+    (void)rt.TryFastPathMerge(epoch, nullptr);
+    DnPartialSnapshotMessage snap = rt.BuildProxySnapshot(epoch);
+    if (snap.contributions.empty()) {
+        return;
+    }
+
+    DnNetworkModule* net = rt.Net();
+    if (net == nullptr) {
+        return;
+    }
+
+    for (const auto& contrib : snap.contributions) {
+        uint64_t origin_hash = 0;
+        for (const auto& t : contrib.committed_txns) {
+            origin_hash = DnCombineHashes(origin_hash, DnHashTxn(t));
+        }
+        for (uint64_t dh : contrib.dropped_hashes) {
+            origin_hash = DnCombineHashes(origin_hash, dh);
+        }
+
+        E_WireTxn meta_txn;
+        meta_txn.csn = 0;
+        meta_txn.start_epoch = static_cast<uint64_t>(epoch);
+        meta_txn.commit_epoch = static_cast<uint64_t>(epoch);
+        meta_txn.server_id = static_cast<uint32_t>(contrib.origin_node_id);
+
+        std::string meta_wire;
+        int32_t payload_size =
+            static_cast<int32_t>(contrib.committed_txns.size() + contrib.dropped_hashes.size());
+        if (!EpochWireSerializeMetadata(meta_txn, origin_hash, payload_size, &meta_wire)) {
+            continue;
+        }
+
+        DnNetworkPacket meta_pkt;
+        meta_pkt.kind = DnMsgKind::WIRE_PAYLOAD;
+        meta_pkt.from_node_id = rt.GetConfig().local_node_id;
+        meta_pkt.wire_payload = meta_wire;
+        for (int slow_id : rt.GetConfig().slow_node_ids) {
+            if (slow_id == rt.GetConfig().local_node_id) {
+                continue;
+            }
+            net->SendMessage(meta_pkt, slow_id, false);
+        }
+    }
+
+    DnNetworkPacket pkt;
+    pkt.kind = DnMsgKind::PARTIAL_SNAPSHOT;
+    pkt.partial_snapshot = snap;
+    pkt.from_node_id = rt.GetConfig().local_node_id;
+
+    for (int slow_id : rt.GetConfig().slow_node_ids) {
+        if (slow_id == rt.GetConfig().local_node_id) {
+            continue;
+        }
+        net->SendMessage(pkt, slow_id, false);
+    }
+    EpochDynNetFlushOutgoing();
+}
+
+void EpochDynNetInit(void)
+{
+    if (!g_enable_epoch_dyn_net || EpochGetTotalNodes() <= 1) {
+        return;
+    }
+
+    DnNetworkConfig cfg;
+    EpochDynNetBuildConfig(&cfg);
+    DnInit(&cfg);
+
+    DnRuntime& rt = DnRuntime::Instance();
+
+    rt.SetPeerLogSyncFn([](int32_t epoch, int32_t origin_node_id, int32_t commit_index, size_t txn_count) {
+        (void)commit_index;
+        if (txn_count == 0) {
+            return;
+        }
+        uint64_t ep = static_cast<uint64_t>(epoch);
+        uint64_t origin = static_cast<uint64_t>(origin_node_id);
+        uint64_t self = static_cast<uint64_t>(EpochGetNodeId());
+        E_NodeManager::UpdateStoreReceivedPackCounters(ep, origin, txn_count);
+        for (size_t i = 0; i < txn_count; ++i) {
+            (void)E_NodeManager::IncMergedTxnCounters(ep, self);
+        }
+    });
+
+    rt.SetDispatchSideEffectFn([](const DnIncomingPacket& in, const DnDispatchResult& dr) {
+        if (dr.snapshot_applied) {
+            for (const auto& dn_txn : dr.applied_txns) {
+                E_WireTxn wt = EpochDynNetDnTxnToWire(dn_txn, dr.snapshot_epoch);
+                EpochPipelineInjectRemoteWireTxn(wt);
+            }
+        }
+        if (dr.handled && in.packet.kind == DnMsgKind::APPEND_ENTRIES &&
+            in.packet.append_req.IsMetadataOnly() && EpochDynNetIsProxySlowNode()) {
+            const DnAppendEntriesRequest& req = in.packet.append_req;
+            E_WireTxn pseudo;
+            pseudo.csn = 0;
+            pseudo.start_epoch = static_cast<uint64_t>(req.epoch);
+            pseudo.commit_epoch = static_cast<uint64_t>(req.epoch);
+            pseudo.server_id = static_cast<uint32_t>(req.channel_id);
+            EpochPipelineInjectRemoteWireTxn(pseudo);
+        }
+        if (dr.need_try_fast_merge && dr.fast_merge_epoch > 0) {
+            EpochDynNetTryEmitProxySnapshot(static_cast<uint64_t>(dr.fast_merge_epoch));
+        }
+    });
+
+    DnTransport::Instance().SetReceiveHook([](DnNetworkModule* net) {
+        (void)net;
+        /* ZMQ listen thread feeds EnqueueIncoming; hook reserved for pull-model transports. */
+    });
+
+    DnTransport::Instance().SetSendFn([](int target_node_id, const DnNetworkPacket& pkt, bool is_reply) {
+        (void)is_reply;
+        std::string wire;
+        if (pkt.kind == DnMsgKind::WIRE_PAYLOAD && !pkt.wire_payload.empty()) {
+            wire = pkt.wire_payload;
+        } else if (!DnWireSerializePacket(pkt, &wire)) {
+            return;
+        }
+        if (wire.empty()) {
+            return;
+        }
+        if (target_node_id >= 0) {
+            (void)EpochNetPublishTo(static_cast<uint32_t>(target_node_id), wire);
+        } else {
+            (void)EpochNetPublishDirect(wire);
+        }
+    });
+
+    g_dyn_net_active = true;
+}
+
+void EpochDynNetEnqueueIncoming(const std::string& payload, int from_node, size_t raw_bytes)
+{
+    if (!EpochDynNetIsEnabled()) {
+        return;
+    }
+    DnNetworkModule* net = DnRuntime::Instance().Net();
+    if (net == nullptr) {
+        return;
+    }
+
+    DnNetworkPacket pkt;
+    if (DnWireTryDecodePayload(payload.data(), payload.size(), from_node, &pkt)) {
+        pkt.from_node_id = from_node;
+    } else {
+        pkt.kind = DnMsgKind::WIRE_PAYLOAD;
+        pkt.wire_payload = payload;
+        pkt.from_node_id = from_node;
+    }
+
+    long long now_ms = 0;
+    struct timeval tv;
+    if (gettimeofday(&tv, nullptr) == 0) {
+        now_ms = static_cast<long long>(tv.tv_sec) * 1000LL + tv.tv_usec / 1000;
+    }
+
+    int latency = g_epoch_dyn_net_rtt_ms / 2;
+    if (from_node >= 0 && from_node < static_cast<int>(EpochGetTotalNodes())) {
+        latency = g_epoch_dyn_net_rtt_ms;
+    }
+    net->EnqueueIncoming(pkt, from_node, raw_bytes, now_ms + latency);
+}
+
+void EpochDynNetShutdown(void)
+{
+    if (!g_dyn_net_active) {
+        return;
+    }
+    DnShutdown();
+    g_dyn_net_active = false;
+}
+
+bool EpochDynNetPublish(const std::string& payload)
+{
+    if (!EpochDynNetIsEnabled()) {
+        return EpochNetPublishDirect(payload);
+    }
+
+    DnNetworkModule* net = DnRuntime::Instance().Net();
+    if (net == nullptr) {
+        return EpochNetPublishDirect(payload);
+    }
+
+    DnNetworkPacket pkt;
+    pkt.kind = DnMsgKind::WIRE_PAYLOAD;
+    pkt.wire_payload = payload;
+    pkt.from_node_id = static_cast<int32_t>(EpochGetNodeId());
+
+    /* PUB/SUB 广播：target 用 0 占位 */
+    net->SendMessage(pkt, 0, false);
+    EpochDynNetFlushOutgoing();
+    return true;
+}
+
+void EpochDynNetRecordWireForProxy(const E_WireTxn& txn, int32_t channel_id)
+{
+    if (!EpochDynNetProxyEnabled()) {
+        return;
+    }
+    DnRuntime& rt = DnRuntime::Instance();
+    const DnNetworkConfig& cfg = rt.GetConfig();
+    if (!DnIsFastNode(cfg, cfg.local_node_id) || rt.PartialRegistry() == nullptr) {
+        return;
+    }
+    DnRaftEntry entry = EpochDynNetWireToRaftEntry(txn);
+    rt.PartialRegistry()->AppendFastNodeEntry(static_cast<int32_t>(txn.commit_epoch), channel_id,
+                                              entry);
+}
+
+bool EpochDynNetPublishWireTxn(const std::string& wire, const E_WireTxn& txn)
+{
+    if (!EpochDynNetProxyEnabled()) {
+        return EpochDynNetPublish(wire);
+    }
+
+    DnRuntime& rt = DnRuntime::Instance();
+    const DnNetworkConfig& cfg = rt.GetConfig();
+    int self = cfg.local_node_id;
+    (void)self;
+    EpochDynNetRecordWireForProxy(txn, self);
+
+    DnNetworkModule* net = rt.Net();
+    if (net == nullptr) {
+        return EpochNetPublishDirect(wire);
+    }
+
+    uint32_t total = EpochGetTotalNodes();
+    for (uint32_t peer = 0; peer < total; ++peer) {
+        if (static_cast<int>(peer) == self) {
+            continue;
+        }
+        if (DnProxyMerge::ShouldSendMetadataOnly(cfg, static_cast<int>(peer))) {
+            continue;
+        }
+        DnNetworkPacket pkt;
+        pkt.kind = DnMsgKind::WIRE_PAYLOAD;
+        pkt.from_node_id = self;
+        pkt.wire_payload = wire;
+        net->SendMessage(pkt, static_cast<int>(peer), false);
+    }
+    EpochDynNetFlushOutgoing();
+    EpochDynNetTryEmitProxySnapshot(static_cast<int32_t>(txn.commit_epoch));
+    return true;
+}
+
+void EpochDynNetFlushOutgoing(void)
+{
+    if (!EpochDynNetIsEnabled()) {
+        return;
+    }
+    DnNetworkModule* net = DnRuntime::Instance().Net();
+    if (net != nullptr) {
+        DnTransport::Instance().FlushOutgoing(net);
+    }
+}
+
+void EpochDynNetDrainAndDispatch(void)
+{
+    if (!EpochDynNetIsEnabled()) {
+        return;
+    }
+    DnNetworkModule* net = DnRuntime::Instance().Net();
+    if (net != nullptr) {
+        DnTransport::Instance().PollIncoming(net);
+    }
+}
+
+bool EpochDynNetTryReceive(std::string* payload)
+{
+    if (payload == nullptr) {
+        return false;
+    }
+    if (!EpochDynNetIsEnabled()) {
+        return false;
+    }
+
+    EpochDynNetDrainAndDispatch();
+    return DnTransport::Instance().PopPendingWirePayload(payload);
+}
+
+bool EpochDynNetHandleWireEnvelope(const std::string& wire)
+{
+    if (!EpochDynNetIsEnabled()) {
+        return false;
+    }
+
+    DnNetworkModule* net = DnRuntime::Instance().Net();
+    if (net == nullptr) {
+        return false;
+    }
+
+    DnNetworkPacket pkt;
+    if (!DnWireTryDecodePayload(wire.data(), wire.size(), -1, &pkt)) {
+        return false;
+    }
+
+    net->EnqueueIncoming(pkt, pkt.from_node_id >= 0 ? pkt.from_node_id : 0, wire.size(), 0);
+    DnTransport::Instance().PollIncoming(net);
+    return true;
+}
+
+void EpochDynNetObserveWireTxn(const E_WireTxn& txn)
+{
+    if (!EpochDynNetIsEnabled()) {
+        return;
+    }
+    DnEpochObserver* observer = DnRuntime::Instance().Observer();
+    if (observer == nullptr) {
+        return;
+    }
+
+    uint64_t observed = txn.commit_epoch;
+    if (observed == 0) {
+        observed = txn.start_epoch;
+    }
+    if (observed > 0) {
+        observer->RecordObservedEpochDirect(static_cast<int32_t>(observed));
+    }
+}
+
+void EpochDynNetObserveEpochEnd(uint64_t epoch)
+{
+    if (!EpochDynNetIsEnabled() || epoch == 0) {
+        return;
+    }
+    DnEpochObserver* observer = DnRuntime::Instance().Observer();
+    if (observer != nullptr) {
+        observer->RecordObservedEpochDirect(static_cast<int32_t>(epoch));
+    }
+    if (EpochDynNetProxyEnabled()) {
+        EpochDynNetTryEmitProxySnapshot(static_cast<int32_t>(epoch));
+    }
+}
+
+void EpochDynNetMaybeCatchup(void)
+{
+    if (!EpochDynNetIsEnabled() || !g_epoch_dyn_net_catchup) {
+        return;
+    }
+
+    DnNetworkConfig cfg = DnRuntime::Instance().GetConfig();
+    if (!DnIsConfiguredSlow(cfg, cfg.local_node_id)) {
+        return;
+    }
+
+    DnRuntime& rt = DnRuntime::Instance();
+    DnNetworkModule* net = rt.Net();
+    if (net == nullptr) {
+        return;
+    }
+
+    uint64_t local_phys = E_NodeManager::GetPhysicalEpoch();
+    DnProposalStrategy strategy =
+        rt.ConsultProposal(static_cast<int32_t>(local_phys));
+
+    if (strategy.action != DnStrategyAction::JUMP || strategy.jump_delta <= 0) {
+        return;
+    }
+
+    (void)rt.ExecuteCatchupJump(strategy.target_epoch);
+    E_NodeManager::SetPhysicalEpoch(static_cast<uint64_t>(strategy.target_epoch));
+}
+
+void EpochDynNetMaybeEmitProxySnapshot(uint64_t epoch)
+{
+    EpochDynNetTryEmitProxySnapshot(static_cast<int32_t>(epoch));
+}
+
+void EpochDynNetGcBeforeEpoch(uint64_t epoch)
+{
+    if (!EpochDynNetIsEnabled() || epoch == 0) {
+        return;
+    }
+    DnRuntime::Instance().GcEpochState(static_cast<int32_t>(epoch));
+}
diff --git a/src/epoch/e_dyn_net_bridge.cpp b/src/epoch/e_dyn_net_bridge.cpp
new file mode 100644
index 0000000..b5c3662
--- /dev/null
+++ b/src/epoch/e_dyn_net_bridge.cpp
@@ -0,0 +1,103 @@
+#include "postgres.h"
+
+#include "epoch/e_dyn_net.h"
+#include "epoch/e_txn_wire.h"
+#include "epoch/e_types.h"
+
+#include "dn_hash.h"
+#include "dn_types.h"
+
+#include <cstdio>
+#include <cstring>
+
+static DnRow EpochWireRowToDnRow(const E_WireRow& row)
+{
+    DnRow dn;
+    char key_buf[512];
+    int rc = snprintf_s(key_buf, sizeof(key_buf), sizeof(key_buf) - 1, "%s:%u:%u:%u:%u:%u",
+                        row.relname.c_str(), row.relid, row.bi_hi, row.bi_lo, row.ip_posid,
+                        static_cast<unsigned>(row.op_type));
+    securec_check_ss(rc, "\0", "\0");
+    dn.key = key_buf;
+    dn.value.assign(row.tuple_data.begin(), row.tuple_data.end());
+    dn.is_delete = (row.op_type == EPOCH_OP_DELETE);
+    return dn;
+}
+
+static bool EpochParseDnRowKey(const std::string& key, E_WireRow* row)
+{
+    if (row == nullptr) {
+        return false;
+    }
+    unsigned op = 0;
+    char relname[256];
+    relname[0] = '\0';
+    unsigned relid = 0;
+    unsigned bi_hi = 0;
+    unsigned bi_lo = 0;
+    unsigned ip_posid = 0;
+    int matched = sscanf_s(key.c_str(), "%255[^:]:%u:%u:%u:%u:%u", relname, sizeof(relname), &relid,
+                           &bi_hi, &bi_lo, &ip_posid, &op);
+    if (matched < 6) {
+        return false;
+    }
+    row->relname = relname;
+    row->relid = relid;
+    row->bi_hi = static_cast<uint16_t>(bi_hi);
+    row->bi_lo = static_cast<uint16_t>(bi_lo);
+    row->ip_posid = static_cast<uint16_t>(ip_posid);
+    row->op_type = static_cast<EpochOpType>(op);
+    return true;
+}
+
+DnRaftEntry EpochDynNetWireToRaftEntry(const E_WireTxn& txn)
+{
+    DnRaftEntry entry;
+    entry.epoch = static_cast<int32_t>(txn.commit_epoch);
+    entry.type = txn.rows.empty() ? DnEntryType::NOOP : DnEntryType::WRITE;
+    entry.index = 0;
+    entry.term = 0;
+
+    DnTransaction dn_txn;
+    dn_txn.client_txn_id = txn.csn;
+    dn_txn.origin_node_id = txn.server_id;
+    char key_buf[64];
+    int rc = snprintf_s(key_buf, sizeof(key_buf), sizeof(key_buf) - 1, "%llu:%u",
+                        static_cast<unsigned long long>(txn.csn), txn.server_id);
+    securec_check_ss(rc, "\0", "\0");
+    dn_txn.client_key = key_buf;
+    for (const auto& row : txn.rows) {
+        dn_txn.rows.push_back(EpochWireRowToDnRow(row));
+    }
+    if (!txn.rows.empty() || txn.csn != 0) {
+        entry.txns.push_back(std::move(dn_txn));
+    }
+    return entry;
+}
+
+E_WireTxn EpochDynNetDnTxnToWire(const DnTransaction& txn, int32_t epoch)
+{
+    E_WireTxn wire;
+    wire.csn = txn.client_txn_id;
+    wire.start_epoch = static_cast<uint64_t>(epoch);
+    wire.commit_epoch = static_cast<uint64_t>(epoch);
+    wire.server_id = txn.origin_node_id;
+    wire.txn_state = EPOCH_TXN_COMMIT;
+
+    for (const auto& dn_row : txn.rows) {
+        E_WireRow row;
+        if (!EpochParseDnRowKey(dn_row.key, &row)) {
+            row.relname = dn_row.key;
+            row.op_type = dn_row.is_delete ? EPOCH_OP_DELETE : EPOCH_OP_UPDATE;
+        }
+        row.tuple_data.assign(dn_row.value.begin(), dn_row.value.end());
+        wire.rows.push_back(std::move(row));
+    }
+    return wire;
+}
+
+uint64_t EpochDynNetWireEntryHash(const E_WireTxn& txn)
+{
+    DnRaftEntry entry = EpochDynNetWireToRaftEntry(txn);
+    return DnHashRaftEntry(entry);
+}
diff --git a/src/epoch/e_epoch.cpp b/src/epoch/e_epoch.cpp
new file mode 100644
index 0000000..a5b98cf
--- /dev/null
+++ b/src/epoch/e_epoch.cpp
@@ -0,0 +1,506 @@
+#include "postgres.h"
+
+#include "epoch/e_epoch.h"
+#include "epoch/e_net.h"
+
+#include "epoch/e_config.h"
+#include "epoch/e_node_manager.h"
+#include "epoch/e_shmem.h"
+#include "epoch/e_pipeline.h"
+#include "epoch/e_statistician.h"
+#include "epoch/e_perf.h"
+
+#include "miscadmin.h"
+
+static void EpochMaybeWriteOffStaleChangeSet(uint64_t epoch);
+
+void EpochAdvancePhysicalOnce(void)
+{
+    if (g_enable_epoch_multimaster && EpochGetTotalNodes() > 1) {
+        uint64_t physical = E_NodeManager::GetPhysicalEpoch();
+        uint64_t logical = E_NodeManager::GetLogicalEpoch();
+        uint64_t gap = (physical > logical) ? (physical - logical) : 0;
+        uint64_t limit = EpochGetPhysLogicalGapLimit();
+
+        if (gap >= limit) {
+            return;
+        }
+        /*
+         * logical 关窗因 change_set_pending 卡住时，禁止继续推高 physical，
+         * 否则新事务 START gate 的 commit_epoch 远超 logical，形成不可恢复自旋。
+         */
+        if (EpochLogicalEpochHasPendingPack(logical)) {
+            return;
+        }
+    }
+    (void)E_NodeManager::AddPhysicalEpoch();
+    EpochPerfNotePhysicalAdvance();
+}
+
+bool EpochIsLogicalReady(uint64_t logicalEpoch)
+{
+    uint64_t physical = E_NodeManager::GetPhysicalEpoch();
+    uint32_t delay = static_cast<uint32_t>(g_epoch_delay_slots);
+    if (delay == 0) {
+        delay = EPOCH_DEFAULT_DELAY;
+    }
+    return physical > logicalEpoch + delay;
+}
+
+static bool EpochAllNodesReceiveCompleted(uint64_t epochId)
+{
+    uint32_t totalNodes = EpochGetTotalNodes();
+    for (uint32_t node = 0; node < totalNodes; ++node) {
+        if (node != EpochGetNodeId() && !EpochPeerIsConnected(node)) {
+            return false;
+        }
+        if (!E_NodeManager::IsNodeReceiveCompleted(epochId, node)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool EpochAllNodesSendCompleted(uint64_t epochId)
+{
+    uint32_t totalNodes = EpochGetTotalNodes();
+    for (uint32_t node = 0; node < totalNodes; ++node) {
+        if (node != EpochGetNodeId() && !EpochPeerIsConnected(node)) {
+            return false;
+        }
+        if (!E_NodeManager::IsNodeSendCompleted(epochId, node)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+/* GeoGauss: change_set（仅写）<= produce + abort */
+bool EpochLocalTxnExcComplete(uint64_t epochId)
+{
+    uint32_t node_id = EpochGetNodeId();
+    uint64_t change_set = E_NodeManager::GetChangeSetTxnCounters(epochId, node_id);
+    uint64_t produced = E_NodeManager::GetLocalProduceTxnCounters(epochId, node_id);
+    uint64_t aborts = E_NodeManager::GetAbortTxnCounters(epochId, node_id);
+    return change_set <= produced + aborts;
+}
+
+static bool EpochLocalCommitPathComplete(uint64_t epochId)
+{
+    uint32_t node_id = EpochGetNodeId();
+    uint64_t merged = E_NodeManager::GetMergedTxnCounters(epochId, node_id);
+    uint64_t committed = E_NodeManager::GetCommittedTxnCounters(epochId, node_id);
+    /*
+     * Async best-effort：只要求 merge/apply 计数对齐即可关窗；pack/produce/record
+     * 由 heal 补齐，避免 abort 计数漂移导致 commit_path_incomplete 永久卡住。
+     */
+    if (EpochIsAsyncMultimasterMode()) {
+        return merged <= committed;
+    }
+    uint64_t packed = E_NodeManager::GetLocalPackTxnCounters(epochId, node_id);
+    uint64_t produced = E_NodeManager::GetLocalProduceTxnCounters(epochId, node_id);
+    uint64_t record_commit = E_NodeManager::GetLocalRecordCommitCounters(epochId, node_id);
+    if (packed > 0 && produced < packed) {
+        return false;
+    }
+    if (packed > 0 && record_commit < packed) {
+        uint64_t write_abort_after = E_NodeManager::GetWriteAbortAfterSendTxnCounters(epochId, node_id);
+        if (record_commit + write_abort_after < packed) {
+            return false;
+        }
+    }
+    if (merged > committed) {
+        return false;
+    }
+    return true;
+}
+
+static void EpochAsyncHealLocalCommitCounters(uint64_t epoch, uint32_t node_id)
+{
+    if (!EpochIsAsyncMultimasterMode()) {
+        return;
+    }
+    uint64_t packed = E_NodeManager::GetLocalPackTxnCounters(epoch, node_id);
+    while (E_NodeManager::GetLocalProduceTxnCounters(epoch, node_id) < packed) {
+        E_NodeManager::IncLocalProduceTxnCounters(epoch, node_id);
+    }
+    while (E_NodeManager::GetLocalRecordCommitCounters(epoch, node_id) < packed) {
+        E_NodeManager::IncLocalRecordCommitCounters(epoch, node_id);
+        E_NodeManager::IncLocalRecordCommittedCounters(epoch, node_id);
+    }
+}
+
+static void EpochAsyncAlignMergedCommitted(uint64_t epoch, uint32_t node_id)
+{
+    if (!EpochIsAsyncMultimasterMode()) {
+        return;
+    }
+    uint64_t merged = E_NodeManager::GetMergedTxnCounters(epoch, node_id);
+    while (E_NodeManager::GetCommittedTxnCounters(epoch, node_id) < merged) {
+        E_NodeManager::IncCommittedTxnCounters(epoch, node_id);
+    }
+}
+
+static void EpochAsyncHealLocalTxnExc(uint64_t epoch, uint32_t node_id)
+{
+    if (!EpochIsAsyncMultimasterMode()) {
+        return;
+    }
+    EpochMaybeWriteOffStaleChangeSet(epoch);
+    uint64_t change_set = E_NodeManager::GetChangeSetTxnCounters(epoch, node_id);
+    uint64_t produced = E_NodeManager::GetLocalProduceTxnCounters(epoch, node_id);
+    uint64_t aborts = E_NodeManager::GetAbortTxnCounters(epoch, node_id);
+    while (change_set > produced + aborts) {
+        E_NodeManager::IncAbortTxnCounters(epoch, node_id);
+        aborts++;
+    }
+}
+
+static bool EpochLocalRecordApplied(uint64_t epochId)
+{
+    uint32_t node_id = EpochGetNodeId();
+    uint64_t record_committed = E_NodeManager::GetLocalRecordCommittedCounters(epochId, node_id);
+    uint64_t record_commit = E_NodeManager::GetLocalRecordCommitCounters(epochId, node_id);
+    uint64_t write_abort_after = E_NodeManager::GetWriteAbortAfterSendTxnCounters(epochId, node_id);
+    /*
+     * COMMIT 已 IncLocalRecordCommit 但 RECORD_COMMIT 前 revalidate 失败/aborted 的路径
+     * 只计 write_abort_after，不会 IncLocalRecordCommitted。
+     */
+    return record_committed + write_abort_after >= record_commit;
+}
+
+/*
+ * GeoGauss 用 merged 与 should_receive 对齐；本实现 merged 仅统计含写且 CRDT 接受的 txn，
+ * 只读/merge 输家 wire 仍计入 pack/recv。merge 在 OnRemoteTxnReceived 中与 recv 同步完成，
+ * 故以 peer recv 对齐为准，不能用 merged >= pack。
+ */
+static bool EpochRemoteMergeReady(uint64_t epochId)
+{
+    if (EpochGetTotalNodes() <= 1) {
+        return true;
+    }
+    uint32_t node_id = EpochGetNodeId();
+    uint32_t total = EpochGetTotalNodes();
+    for (uint32_t n = 0; n < total; ++n) {
+        if (n == node_id) {
+            continue;
+        }
+        if (!EpochPeerIsConnected(n)) {
+            return false;
+        }
+        uint64_t should = E_NodeManager::GetStoreShouldReceivedPackCounters(epochId, n);
+        uint64_t received = E_NodeManager::GetStoreReceivedPackCounters(epochId, n);
+        if (received < should) {
+            return false;
+        }
+    }
+    return true;
+}
+
+/*
+ * GeoGauss mot_internal.cpp:3257「Merge结束 开始Commit」：
+ * 仅在 commit 路径就绪后短暂置 record_committed=false，并在同函数内等到
+ * record 落盘计数对齐；若本轮未凑齐必须恢复 true，避免 START gate 永久冻住连接。
+ * 返回 true 表示可 AddLogicalEpoch。
+ */
+static bool EpochTryFinishCommitPhase(uint64_t targetEpoch)
+{
+    if (!EpochLocalCommitPathComplete(targetEpoch)) {
+        return false;
+    }
+
+    /*
+     * Async：produce/record_commit/record_committed 均在 COMMIT pack 时入账，
+     * 无 backend 等 record_committed gate；勿在此自旋，否则 logical 卡死。
+     */
+    if (EpochIsAsyncMultimasterMode()) {
+        return true;
+    }
+
+    E_NodeManager::SetRecordCommitted(false);
+    E_NodeManager::SetRemoteRecordCommitted(false);
+
+    static const int kRecordSpin = 500;
+    for (int spin = 0; spin < kRecordSpin && !EpochLocalRecordApplied(targetEpoch); ++spin) {
+        pg_usleep(200L);
+    }
+    if (!EpochLocalRecordApplied(targetEpoch)) {
+        E_NodeManager::SetRecordCommitted(true);
+        EpochRecvDiagLogStall(targetEpoch, "record_incomplete");
+        return false;
+    }
+    return true;
+}
+
+bool EpochIsRemoteMergeReady(uint64_t epochId)
+{
+    if (!g_enable_epoch_multimaster || EpochGetTotalNodes() <= 1) {
+        return true;
+    }
+    if (!EpochAllNodesSendCompleted(epochId)) {
+        return false;
+    }
+    return EpochAllNodesReceiveCompleted(epochId);
+}
+
+static void EpochMaybeWriteOffStaleChangeSet(uint64_t epoch)
+{
+    uint32_t node_id = EpochGetNodeId();
+    uint64_t change_set = E_NodeManager::GetChangeSetTxnCounters(epoch, node_id);
+    uint64_t produced = E_NodeManager::GetLocalProduceTxnCounters(epoch, node_id);
+    uint64_t aborts = E_NodeManager::GetAbortTxnCounters(epoch, node_id);
+    uint64_t write_abort_after = E_NodeManager::GetWriteAbortAfterSendTxnCounters(epoch, node_id);
+    uint64_t abort_net = (aborts > write_abort_after) ? (aborts - write_abort_after) : 0;
+    uint64_t should_send = (change_set > abort_net) ? (change_set - abort_net) : 0;
+    uint64_t packed = E_NodeManager::GetLocalPackTxnCounters(epoch, node_id);
+    if (should_send > 0 && packed < should_send) {
+        return;
+    }
+    if (change_set <= produced + aborts) {
+        return;
+    }
+    uint64_t physical = E_NodeManager::GetPhysicalEpoch();
+    uint64_t logical = E_NodeManager::GetLogicalEpoch();
+    uint64_t gap = (physical > logical) ? (physical - logical) : 0;
+    if (gap < EpochGetPhysLogicalGapLimit()) {
+        return;
+    }
+    uint64_t orphan = change_set - produced - aborts;
+    for (uint64_t i = 0; i < orphan; ++i) {
+        E_NodeManager::IncAbortTxnCounters(epoch, node_id);
+    }
+}
+
+bool EpochTryAdvanceLogical(void)
+{
+    if (!g_enable_epoch_multimaster) {
+        return false;
+    }
+
+    EpochPerfNoteLogicalAdvanceTry();
+
+    uint64_t logical = E_NodeManager::GetLogicalEpoch();
+    uint64_t targetEpoch = logical;
+    E_NodeManager::EnsureEpochSlot(targetEpoch);
+
+    /*
+     * 单节点：无 ZMQ/seal，physical 越过 delay 后即可推进 logical。
+     */
+    if (EpochGetTotalNodes() <= 1) {
+        if (!EpochIsLogicalReady(targetEpoch)) {
+            return false;
+        }
+        E_NodeManager::AddLogicalEpoch();
+        E_NodeManager::SetRecordCommitted(true);
+        E_NodeManager::ClearEpochSlot(targetEpoch);
+        EpochPerfNoteLogicalAdvanceOk();
+        return true;
+    }
+
+    if (!EpochAllPeersConnected()) {
+        EpochRecvDiagLogStall(targetEpoch, "peer_not_connected");
+        return false;
+    }
+
+    {
+        uint32_t self = EpochGetNodeId();
+        uint32_t total = EpochGetTotalNodes();
+        for (uint32_t peer = 0; peer < total; ++peer) {
+            if (peer == self) {
+                continue;
+            }
+            if (targetEpoch > EpochGetPeerMaxSealedEpoch(peer) + 2) {
+                EpochRecvDiagLogStall(targetEpoch, "peer_lag");
+                return false;
+            }
+        }
+    }
+
+    /* GeoGauss 1: physical > logical + delay */
+    if (!EpochIsLogicalReady(targetEpoch)) {
+        EpochRecvDiagLogStall(targetEpoch, "physical_not_ready");
+        return false;
+    }
+
+    /*
+     * GeoGauss commit 阶段：对端 recv/merge 就绪后 SetRemoteExeced，backend 在
+     * self seal 前 WaitForRemoteExeced → pack/produce。
+     * 本端 recv 在 seal 后才完成，此处不能要求 self recv，否则 recv_incomplete
+     * 永久成立 → chg=N pack=0 → SEAL_BLOCK change_set_pending。
+     */
+    if (!EpochIsAllPeersReceiveCompleted(targetEpoch)) {
+        EpochRecvDiagLogStall(targetEpoch, "recv_incomplete");
+        return false;
+    }
+    if (!EpochRemoteMergeReady(targetEpoch)) {
+        EpochRecvDiagLogStall(targetEpoch, "merge_incomplete");
+        return false;
+    }
+    if (!E_NodeManager::IsRemoteExeced()) {
+        E_NodeManager::SetRemoteExeced(true);
+    }
+
+    /* GeoGauss 2: 写 change_set 已全部 produce/abort（remote_exec 已开，backend 可 pack） */
+    EpochMaybeWriteOffStaleChangeSet(targetEpoch);
+    if (!EpochLocalTxnExcComplete(targetEpoch)) {
+        if (EpochIsAsyncMultimasterMode()) {
+            EpochAsyncHealLocalTxnExc(targetEpoch, EpochGetNodeId());
+        } else {
+            EpochRecvDiagLogStall(targetEpoch, "local_commit_pending");
+            return false;
+        }
+    }
+
+    /* GeoGauss 3: seal 当前 logical epoch（TrySealEpoch 内处理 executing 与对端握手互锁） */
+    EpochMaybeInvalidateStaleSeal(targetEpoch);
+    if (!E_NodeManager::IsNodeSendCompleted(targetEpoch, EpochGetNodeId())) {
+        (void)EpochTrySealEpoch(targetEpoch);
+    }
+
+    if (!EpochAllNodesSendCompleted(targetEpoch)) {
+        EpochRecvDiagLogStall(targetEpoch, "send_incomplete");
+        return false;
+    }
+
+    {
+        uint32_t self = EpochGetNodeId();
+        uint64_t packed = E_NodeManager::GetLocalPackTxnCounters(targetEpoch, self);
+        uint64_t sealed = E_NodeManager::GetSealedPackTxnCounters(targetEpoch, self);
+        EpochMaybeInvalidateStaleSeal(targetEpoch);
+        if (packed != sealed) {
+            (void)EpochTrySealEpoch(targetEpoch);
+            sealed = E_NodeManager::GetSealedPackTxnCounters(targetEpoch, self);
+            if (packed != sealed) {
+                EpochRecvDiagLogStall(targetEpoch, "reseal_pending");
+                return false;
+            }
+        }
+        if (!E_NodeManager::IsNodeSendCompleted(targetEpoch, self)) {
+            EpochRecvDiagLogStall(targetEpoch, "reseal_pending");
+            return false;
+        }
+    }
+
+    if (!EpochIsAllPeersReceiveCompleted(targetEpoch)) {
+        EpochRecvDiagLogStall(targetEpoch, "recv_incomplete");
+        return false;
+    }
+
+    /*
+     * Poll 里 ApplyReadyEpochs 往往早于 self seal，recv 未齐时跳过 apply →
+     * merged>0 但 committed 恒 0 → commit_path_incomplete。关窗前再 apply 一次。
+     */
+    (void)EpochPipelineTryApplyMergedEpoch(targetEpoch);
+    if (EpochIsAsyncMultimasterMode()) {
+        EpochAsyncHealLocalCommitCounters(targetEpoch, EpochGetNodeId());
+        EpochAsyncAlignMergedCommitted(targetEpoch, EpochGetNodeId());
+    }
+
+    if (!EpochLocalCommitPathComplete(targetEpoch)) {
+        EpochRecvDiagLogStall(targetEpoch, "commit_path_incomplete");
+        return false;
+    }
+    if (!EpochTryFinishCommitPhase(targetEpoch)) {
+        return false;
+    }
+
+    E_NodeManager::SetRemoteExeced(false);
+    E_NodeManager::SetRemoteRecordCommitted(false);
+    E_NodeManager::AddLogicalEpoch();
+    E_NodeManager::SetRecordCommitted(true);
+    E_NodeManager::ClearEpochSlot(targetEpoch);
+    EpochPerfNoteLogicalAdvanceOk();
+    return true;
+}
+
+bool EpochWaitForCommitGate(uint64_t commitEpoch)
+{
+    if (!g_enable_epoch_multimaster) {
+        return true;
+    }
+
+    /*
+     * GeoGauss is_sync_exec COMMIT gate:
+     * commit_epoch <= logical && record_committed.
+     */
+    const long waitUs = 200;
+    while (commitEpoch > E_NodeManager::GetLogicalEpoch() ||
+           !E_NodeManager::IsRecordCommitted()) {
+        pg_usleep(waitUs);
+        CHECK_FOR_INTERRUPTS();
+    }
+    return true;
+}
+
+bool EpochWaitForRemoteMerge(uint64_t commitEpoch)
+{
+    if (!g_enable_epoch_multimaster) {
+        return true;
+    }
+
+    const long waitUs = 200;
+    while (!EpochIsRemoteMergeReady(commitEpoch)) {
+        pg_usleep(waitUs);
+        CHECK_FOR_INTERRUPTS();
+    }
+    return true;
+}
+
+bool EpochWaitForLogicalPast(uint64_t commitEpoch)
+{
+    if (!g_enable_epoch_multimaster) {
+        return true;
+    }
+
+    const long waitUs = 200;
+    while (commitEpoch >= E_NodeManager::GetLogicalEpoch()) {
+        pg_usleep(waitUs);
+        CHECK_FOR_INTERRUPTS();
+    }
+    return true;
+}
+
+bool EpochWaitForSyncCommit(uint64_t commitEpoch)
+{
+    (void)commitEpoch;
+    /*
+     * GeoGauss 同步等待在 RECORD_COMMIT 之后、END 里 EndTransaction 之后
+     * 等待 remote_record_committed。
+     */
+    return true;
+}
+
+bool EpochWaitForRecordCommitted(uint64_t commitEpoch)
+{
+    if (!g_enable_epoch_multimaster || EpochGetTotalNodes() <= 1) {
+        return true;
+    }
+    uint32_t self = EpochGetNodeId();
+    for (uint32_t node = 0; node < EpochGetTotalNodes(); ++node) {
+        if (node != self && !EpochPeerIsConnected(node)) {
+            return true;
+        }
+    }
+    const long waitUs = 200;
+    while (!E_NodeManager::IsRemoteRecordCommitted()) {
+        (void)commitEpoch;
+        pg_usleep(waitUs);
+        CHECK_FOR_INTERRUPTS();
+    }
+    return true;
+}
+
+uint64_t EpochAssignTxnEpoch(void)
+{
+    if (!g_enable_epoch_multimaster) {
+        return 0;
+    }
+    /*
+     * GeoGauss 用 physical 发号；cap 到 logical+gap_limit 避免重启后 physical 远超 logical。
+     * sync START/COMMIT gate 要求 commit_epoch <= logical，事务在 gate 自旋直到 logical 追上。
+     */
+    uint64_t physical = E_NodeManager::GetPhysicalEpoch();
+    uint64_t logical = E_NodeManager::GetLogicalEpoch();
+    uint64_t cap = logical + EpochGetPhysLogicalGapLimit();
+    return (physical > cap) ? cap : physical;
+}
diff --git a/src/epoch/e_exec_track.cpp b/src/epoch/e_exec_track.cpp
new file mode 100644
index 0000000..952aeaa
--- /dev/null
+++ b/src/epoch/e_exec_track.cpp
@@ -0,0 +1,62 @@
+#include "postgres.h"
+
+#include "epoch/e_exec_track.h"
+#include "epoch/e_config.h"
+#include "epoch/e_node_manager.h"
+
+#include "gs_thread.h"
+#include "knl/knl_variable.h"
+#include "knl/knl_thread.h"
+#include "miscadmin.h"
+#include "postmaster/autovacuum.h"
+
+static bool EpochShouldTrackExecuting(void)
+{
+    if (!g_enable_epoch_multimaster) {
+        return false;
+    }
+    if (IsAutoVacuumWorkerProcess() || AmEpochWorkerProcess()) {
+        return false;
+    }
+    if (t_thrd.role == EPOCHWORKER) {
+        return false;
+    }
+    if (t_thrd.role != WORKER && t_thrd.role != THREADPOOL_WORKER) {
+        return false;
+    }
+    if (!IsNormalProcessingMode()) {
+        return false;
+    }
+    if (u_sess->proc_cxt.MyProcPort == nullptr || u_sess->proc_cxt.MyProcPort->database_name == nullptr) {
+        return false;
+    }
+    const char* track_db = (g_epoch_apply_database != nullptr && g_epoch_apply_database[0] != '\0')
+        ? g_epoch_apply_database
+        : "test";
+    if (strcmp(u_sess->proc_cxt.MyProcPort->database_name, track_db) != 0) {
+        return false;
+    }
+    return u_sess->epoch_cxt.epoch_assigned && !u_sess->epoch_cxt.epoch_exec_counted;
+}
+
+void EpochMaybeMarkTxnExecuting(void)
+{
+    if (!EpochShouldTrackExecuting()) {
+        return;
+    }
+    uint64_t epoch = u_sess->epoch_cxt.commit_epoch;
+    uint32_t node_id = EpochGetNodeId();
+    E_NodeManager::IncExecutingTxnCounters(epoch, node_id);
+    u_sess->epoch_cxt.epoch_exec_counted = true;
+}
+
+void EpochReleaseTxnExecuting(void)
+{
+    if (!u_sess->epoch_cxt.epoch_exec_counted) {
+        return;
+    }
+    uint64_t epoch = u_sess->epoch_cxt.commit_epoch;
+    uint32_t node_id = EpochGetNodeId();
+    E_NodeManager::DecExecutingTxnCounters(epoch, node_id);
+    u_sess->epoch_cxt.epoch_exec_counted = false;
+}
